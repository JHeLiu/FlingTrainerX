<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:FlingTrainerX.Converters">

    <!-- 卡片尺寸：版心固定，一行恒定 5 张；这里只是加载完数据前 / 设计期的默认值，运行时按版心宽度算 -->
    <sys:Double x:Key="CardW">223</sys:Double>
    <sys:Double x:Key="CardH">183</sys:Double>

    <!-- 卡片下半部的文字区高度：封面 = 卡高 − 这个值，正好是 16:9 -->
    <GridLength x:Key="CardInfoH">58</GridLength>

    <!-- ============ 调色板 ============ -->
    <Color x:Key="C.BgDeep">#FF080E16</Color>
    <Color x:Key="C.BgMain">#FF0E1825</Color>
    <Color x:Key="C.BgSide">#FF0A121C</Color>
    <Color x:Key="C.Accent">#FF3B82F6</Color>

    <SolidColorBrush x:Key="B.BgDeep" Color="{StaticResource C.BgDeep}" />
    <SolidColorBrush x:Key="B.BgMain" Color="{StaticResource C.BgMain}" />
    <SolidColorBrush x:Key="B.BgSide" Color="{StaticResource C.BgSide}" />
    <SolidColorBrush x:Key="B.Card" Color="#FF121D2B" />
    <SolidColorBrush x:Key="B.Panel" Color="#FF111C29" />
    <SolidColorBrush x:Key="B.PanelSoft" Color="#FF16222F" />
    <SolidColorBrush x:Key="B.Border" Color="#FF1D2B3C" />
    <SolidColorBrush x:Key="B.BorderSoft" Color="#FF182533" />
    <SolidColorBrush x:Key="B.Text" Color="#FFE9F0FA" />
    <SolidColorBrush x:Key="B.TextDim" Color="#FF93A6BD" />
    <SolidColorBrush x:Key="B.TextMute" Color="#FF64798F" />
    <SolidColorBrush x:Key="B.Accent" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="B.AccentLight" Color="#FF6FB1FF" />
    <SolidColorBrush x:Key="B.AccentDim" Color="#FF18314D" />
    <SolidColorBrush x:Key="B.Cyan" Color="#FF2DD4E8" />
    <SolidColorBrush x:Key="B.Green" Color="#FF34D399" />

    <!-- 卡片底部压暗，保证标题可读 -->
    <LinearGradientBrush x:Key="B.CardScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000E1825" Offset="0.28" />
        <GradientStop Color="#B30E1825" Offset="0.68" />
        <GradientStop Color="#F20C1520" Offset="1" />
    </LinearGradientBrush>

    <!-- 详情页头图只压下半部分：整张图压得太狠会看不出画面 -->
    <!-- 横幅底部压暗：只在最下方压一点，让白色标题可读，上面尽量保留原图 -->
    <LinearGradientBrush x:Key="B.BannerScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00070E17" Offset="0" />
        <GradientStop Color="#1A070E17" Offset="0.55" />
        <GradientStop Color="#7A070E17" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe MDL2 Assets</FontFamily>

    <conv:ImagePathConverter x:Key="ImgConv" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:TextToVisibilityConverter x:Key="TextToVis" />

    <!-- ============ 文本 ============ -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.H1" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="T.Dim" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
    </Style>

    <Style x:Key="T.Mute" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}" />
    </Style>

    <!-- ============ 滚动条 ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" CornerRadius="3" Background="#FF243449" Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF31465F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 侧栏导航 ============ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFB7C8DA" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" CornerRadius="9" Background="Transparent">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{StaticResource B.Accent}" Opacity="0" />
                            <ContentPresenter Margin="13,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF131F2D" />
                            <Setter Property="Foreground" Value="#FFDCE8F5" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF15263A" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FFEAF2FB" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1B2939" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF14202D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource B.Accent}" BorderThickness="1" BorderBrush="#FF5C9BFF">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF4B8DFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF2C6FD8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="#FF15212F" BorderThickness="1" BorderBrush="{StaticResource B.Border}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1B2A3C" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF2E4560" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF111C29" />
                        </Trigger>
                        <!-- 不可用（比如还没下载好时点不了「启动」）时整体压暗 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作按钮（清除缓存这类不可撤销的动作）：暗红描边，平时不抢眼，悬停才亮起来 -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#FFF08A96" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="#FF221318" BorderThickness="1" BorderBrush="#FF4A2028">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF33191F" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF7A2C39" />
                            <Setter Property="Foreground" Value="#FFFFB3BC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1B0F13" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibraryTabButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="#FF15212F" BorderThickness="1" BorderBrush="{StaticResource B.Border}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1B2A3C" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF2E4560" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#FF244A72" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF3974AE" />
                            <Setter Property="Foreground" Value="#FFEAF4FF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭窗口按钮（详情弹框用） -->
    <Style x:Key="RoundCloseBtn" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#FFD5E2F2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="16" Background="#99060D16" BorderThickness="1" BorderBrush="#33FFFFFF">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 收藏夹卡片左上角的「取消收藏」小按钮 -->
    <Style x:Key="CardFavRemove" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#FFD5E2F2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="12" Background="#B3060D16"
                            BorderThickness="1" BorderBrush="#33FFFFFF">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 卡片 ============ -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource CardW}" />
        <Setter Property="Height" Value="{DynamicResource CardH}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="13" Background="{StaticResource B.Card}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid>
                            <Border CornerRadius="12" Background="#FF0B1420" />
                            <ContentPresenter />
                            <Border x:Name="Glow" CornerRadius="12" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#3D3B82F6" Offset="0" />
                                        <GradientStop Color="#003B82F6" Offset="0.55" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="12" BorderThickness="1.4"
                                    BorderBrush="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="BorderBrush" Value="#FF4E8EF0" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Root" Property="Background" Value="#FF16243A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 虚拟滚动列表（首页卡片墙） ============ -->
    <Style x:Key="CardRowContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CardRowContainer}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!--  不预创建视口外的行，避免屏幕外卡片提前创建图片画刷  -->
        <Setter Property="VirtualizingPanel.CacheLength" Value="0" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="PART_Scroll" Background="Transparent"
                                  Padding="{TemplateBinding Padding}" Focusable="False"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 搜索框 ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <!--  不要写死 Height：TextBox 内部会把文字往下挤几个像素，
              只有让它按自身内容高度居中（VerticalAlignment=Center），文字才和左边的图标同轴  -->
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.AccentLight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 芯片 / 标签 ============ -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Background" Value="#FF172436" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#FF243449" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="KeyBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="#FF18293C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#FF27405A" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ 详情弹框：选项卡 ============ -->
    <Style x:Key="DetailTab" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="14,7" Margin="0,0,6,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF16232F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下载表格的一行（整行可点） -->
    <Style x:Key="DownloadRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8"
                            BorderThickness="0,0,0,1" BorderBrush="#FF172432" Padding="10,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF17273A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF111E2C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowIconBtn" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF22374F" />
                            <Setter Property="Foreground" Value="{StaticResource B.AccentLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 下载进度 ============ -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FF26333F" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF3B82F6" Offset="0" />
                                        <GradientStop Color="#FF2DD4E8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 服务器不给总大小时（官网是流式转发），用滚动块表示还在下。
                                 往返扫动而不是单向跑出画面，保证窄进度条上也一直看得见。 -->
                            <Canvas x:Name="MarqueeHost" ClipToBounds="True" Visibility="Collapsed">
                                <Rectangle x:Name="Marquee" Width="110" Height="{TemplateBinding Height}"
                                           RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#003B82F6" Offset="0" />
                                            <GradientStop Color="#FF2DD4E8" Offset="0.5" />
                                            <GradientStop Color="#003B82F6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeMove" X="-60" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MarqueeHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MarqueeStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MarqueeMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-60" To="330"
                                                         Duration="0:0:0.85" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MarqueeStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下载表格「状态」列里的细进度条：位置窄，滚动块按列宽来回扫，保证一直看得见 -->
    <Style x:Key="MiniProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FF26333F" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF3B82F6" Offset="0" />
                                        <GradientStop Color="#FF2DD4E8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!--  服务器不给总大小时来回扫动，区间贴着状态列宽度（约 76px）  -->
                            <Canvas x:Name="MiniHost" ClipToBounds="True" Visibility="Collapsed">
                                <Rectangle x:Name="MiniShine" Width="46" Height="{TemplateBinding Height}"
                                           RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#003B82F6" Offset="0" />
                                            <GradientStop Color="#FF2DD4E8" Offset="0.5" />
                                            <GradientStop Color="#003B82F6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MiniMove" X="-46" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MiniHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MiniStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MiniMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-46" To="82"
                                                         Duration="0:0:1.1" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MiniStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 软件截图：一张图占满整行，高度由图片比例决定；悬停不加描边（只保留手型光标） -->
    <Style x:Key="ShotCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" CornerRadius="10" Background="#FF0B1320" ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下载表格的一行：鼠标划过 / 被选中（选中的行就是右侧「启动程序」要启动的那个文件） -->
    <Style x:Key="DownloadRowItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#FF172432" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF16273A" />
            </Trigger>
            <!--  放在悬停之后：鼠标停在被选中的行上时，仍然显示选中色  -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#FF1C3149" />
                <Setter Property="BorderBrush" Value="#FF2F5578" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 下载状态文字：未下载（灰）/ 正在下载（蓝）/ 已下载（绿） -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#FF7C90A6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKind}" Value="Active">
                <Setter Property="Foreground" Value="#FF6FB1FF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource B.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="Failed">
                <Setter Property="Foreground" Value="#FFF07878" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 下载行右侧的小按钮：下载 / 取消 / 重试 -->
    <Style x:Key="RowActionBtn" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="#FF9EC5FF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Padding="{TemplateBinding Padding}"
                            Background="#FF17283C" BorderThickness="1" BorderBrush="#FF27405A">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1F3A57" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF3D6F9F" />
                            <Setter Property="Foreground" Value="#FFCFE3FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF14293D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
