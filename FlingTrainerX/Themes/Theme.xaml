        </Setter>
    </Style>

    <!--  下载表格的一行：鼠标划过 / 被选中（选中的行就是右侧「启动程序」要启动的那个文件）  -->
    <Style x:Key="DownloadRowItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#FF223649" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF1E3350" />
            </Trigger>
            <!--  放在悬停之后：鼠标停在被选中的行上时，仍然显示选中色  -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#FF254260" />
                <Setter Property="BorderBrush" Value="#FF3A688F" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  下载状态文字：未下载（灰）/ 正在下载（蓝）/ 已下载（绿）  -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!--  未下载/等待这类"安静"的状态也要看得清，别糊进深底里  -->
        <Setter Property="Foreground" Value="#FFD4DFEB" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKind}" Value="Active">
                <Setter Property="Foreground" Value="#FF6FB1FF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource B.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="Failed">
                <Setter Property="Foreground" Value="#FFF07878" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  下载行右侧的小按钮：下载 / 取消 / 重试  -->
    <Style x:Key="RowActionBtn" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Caption}" />
        <Setter Property="Foreground" Value="#FF9EC5FF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="b"
                        Padding="{TemplateBinding Padding}"
                        Background="#FF1E3350"
                        BorderBrush="#FF315070"
                        BorderThickness="1"
                        CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF27466A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF457BAB" />
                            <Setter Property="Foreground" Value="#FFD9E9FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1A3050" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== 悬浮菜单（顶栏刷新按钮的下拉） ====================  -->

    <!--  Steam 客户端那种菜单项：34 高、悬停整行浅蓝底 + 5px 圆角  -->
    <Style x:Key="MenuRow" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFD3E1F0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Surface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#FF24384F" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#FF1B2B3E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  菜单项左侧的小图标  -->
    <Style x:Key="MenuRowIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#FF8CA3BB" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  菜单项文字：颜色跟着按钮走，悬停时一起变白  -->
    <Style x:Key="MenuRowLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!--  菜单顶部的小标题  -->
    <Style x:Key="MenuCaption" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,6,0,4" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}" />
    </Style>

    <!--
        带说明的复选框行（确认框里的「同时更新 Steam 中文名」这类开关）：
        系统自带那个小方框在深蓝底上很扎眼，这里自己画一个 18×18 的圆角方框，
        勾上时变成主题蓝底 + 白色对勾，说明文字挂在 Content 下面。
    -->
    <Style x:Key="CheckRow" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="box"
                            Width="18"
                            Height="18"
                            Margin="0,1,0,0"
                            VerticalAlignment="Top"
                            Background="#FF16283B"
                            BorderBrush="#FF4A6582"
                            BorderThickness="1"
                            CornerRadius="5">
                            <TextBlock
                                x:Name="tick"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="&#xE73E;"
                                Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Top" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.AccentLight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
