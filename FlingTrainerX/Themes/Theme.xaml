    <!--  ============ 下载进度 ============  -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FF31424F" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True"
                        CornerRadius="2">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF3B82F6" />
                                        <GradientStop Offset="1" Color="#FF2DD4E8" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!--
                                服务器不给总大小时（官网是流式转发），用滚动块表示还在下。
                                往返扫动而不是单向跑出画面，保证窄进度条上也一直看得见。
                            -->
                            <Canvas
                                x:Name="MarqueeHost"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                                <Rectangle
                                    x:Name="Marquee"
                                    Width="110"
                                    Height="{TemplateBinding Height}"
                                    RadiusX="2"
                                    RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#003B82F6" />
                                            <GradientStop Offset="0.5" Color="#FF2DD4E8" />
                                            <GradientStop Offset="1" Color="#003B82F6" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeMove" X="-60" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MarqueeHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MarqueeStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetName="MarqueeMove"
                                            Storyboard.TargetProperty="X"
                                            From="-60"
                                            To="330"
                                            Duration="0:0:0.85" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MarqueeStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  下载表格「状态」列里的细进度条：位置窄，滚动块按列宽来回扫，保证一直看得见  -->
    <Style x:Key="MiniProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FF31424F" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border
                        Background="{TemplateBinding Background}"
                        ClipToBounds="True"
                        CornerRadius="2">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF3B82F6" />
                                        <GradientStop Offset="1" Color="#FF2DD4E8" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!--  服务器不给总大小时来回扫动，区间贴着状态列宽度（约 76px）  -->
                            <Canvas
                                x:Name="MiniHost"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                                <Rectangle
                                    x:Name="MiniShine"
                                    Width="46"
                                    Height="{TemplateBinding Height}"
                                    RadiusX="2"
                                    RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#003B82F6" />
                                            <GradientStop Offset="0.5" Color="#FF2DD4E8" />
                                            <GradientStop Offset="1" Color="#003B82F6" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MiniMove" X="-46" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MiniHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MiniStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetName="MiniMove"
                                            Storyboard.TargetProperty="X"
                                            From="-46"
                                            To="82"
                                            Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MiniStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  软件截图：一张图占满整行，高度由图片比例决定；悬停不加描边（只保留手型光标）  -->
    <Style x:Key="ShotCard" TargetType="Button">
