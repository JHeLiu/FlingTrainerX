                        BorderThickness="1"
                        CornerRadius="13">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Icon}"
                            FontSize="12"
                            Text="&#xE711;" />
                    </Border>
                    <ControlTemplate.Triggers>
