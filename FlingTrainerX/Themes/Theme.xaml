<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:FlingTrainerX.Converters"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ============ 字号刻度 ============
        全项目只允许用这几档，不要再往控件上写零散的 10.5 / 11.5 / 13.5：
        最小 12，正文默认 14，往上每档 +1~+3，超大字号只留给标题和装饰。
        
        12  Caption   角标、表头、字段说明、时间戳这类“看得见但不抢眼”的字
        13  Small     次要正文：描述段落、状态、文件名、数量
        14  Body      正文默认：导航、按钮、列表项、游戏名
        15  Subtitle  小标题：区块名、弹框标题
        20  Head      页面级标题（“Steam 单机游戏库”）
        28  Display   详情页游戏名
        40  Watermark 卡片封面上的水印首字母（纯装饰，不参与阅读）
        
        17  Title     介于 Subtitle 和 Head 之间的区块标题
        图标字形（Segoe MDL2）不走这套刻度，按控件本身的尺寸单独给，但同样不低于 12。
    -->
    <sys:Double x:Key="Fs.Caption">12</sys:Double>
    <sys:Double x:Key="Fs.Small">13</sys:Double>
    <sys:Double x:Key="Fs.Body">14</sys:Double>
    <sys:Double x:Key="Fs.Subtitle">15</sys:Double>
    <sys:Double x:Key="Fs.Title">17</sys:Double>
    <sys:Double x:Key="Fs.Head">20</sys:Double>
    <sys:Double x:Key="Fs.Display">28</sys:Double>
    <sys:Double x:Key="Fs.Watermark">40</sys:Double>

    <!--  卡片尺寸：版心固定，一行恒定 5 张；这里只是加载完数据前 / 设计期的默认值，运行时按版心宽度算  -->
    <sys:Double x:Key="CardW">193</sys:Double>
    <sys:Double x:Key="CardH">193</sys:Double>

    <!--
        卡片下半部的文字区高度：封面 = 卡高 − 这个值，正好是 16:9
        两行标题（14 号 / 行高 20 = 40）+ 标签行（约 22）+ 上下内边距 16 ≈ 78，留余量取 84
    -->
    <GridLength x:Key="CardInfoH">84</GridLength>

    <!--
        ============ 调色板 ============
        整体比上一版提亮一档：底色从近黑改成深蓝灰，卡片和面板都比页面底明显高一层，
        长时间看不至于"闷在黑洞里"；文字同步提亮（Dim/Mute 不再糊进背景）
    -->
    <Color x:Key="C.BgDeep">#FF0F1B2B</Color>
    <Color x:Key="C.BgMain">#FF18283C</Color>
    <Color x:Key="C.BgSide">#FF132132</Color>
    <Color x:Key="C.Accent">#FF3B82F6</Color>

    <SolidColorBrush x:Key="B.BgDeep" Color="{StaticResource C.BgDeep}" />
    <SolidColorBrush x:Key="B.BgMain" Color="{StaticResource C.BgMain}" />
    <SolidColorBrush x:Key="B.BgSide" Color="{StaticResource C.BgSide}" />
    <SolidColorBrush x:Key="B.Card" Color="#FF213348" />
    <SolidColorBrush x:Key="B.Panel" Color="#FF1D2E42" />
    <SolidColorBrush x:Key="B.PanelSoft" Color="#FF263B51" />
    <SolidColorBrush x:Key="B.Border" Color="#FF354E6B" />
    <SolidColorBrush x:Key="B.BorderSoft" Color="#FF2C4259" />
    <SolidColorBrush x:Key="B.Text" Color="#FFF2F7FD" />
    <SolidColorBrush x:Key="B.TextDim" Color="#FFC6D5E5" />
    <SolidColorBrush x:Key="B.TextMute" Color="#FF97ACC2" />
    <SolidColorBrush x:Key="B.Accent" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="B.AccentLight" Color="#FF7CBBFF" />
    <SolidColorBrush x:Key="B.AccentDim" Color="#FF1E3E62" />
    <SolidColorBrush x:Key="B.Cyan" Color="#FF2DD4E8" />
    <SolidColorBrush x:Key="B.Green" Color="#FF34D399" />

    <!--  卡片底部压暗，保证标题可读  -->
    <LinearGradientBrush x:Key="B.CardScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.28" Color="#0014202F" />
        <GradientStop Offset="0.68" Color="#B314202F" />
        <GradientStop Offset="1" Color="#F2121D2B" />
    </LinearGradientBrush>

    <!--  详情页头图只压下半部分：整张图压得太狠会看不出画面  -->
    <!--  横幅底部压暗：只在最下方压一点，让白色标题可读，上面尽量保留原图  -->
    <LinearGradientBrush x:Key="B.BannerScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00070E17" />
        <GradientStop Offset="0.55" Color="#1A070E17" />
        <GradientStop Offset="1" Color="#7A070E17" />
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe MDL2 Assets</FontFamily>

    <conv:ImagePathConverter x:Key="ImgConv" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:TextToVisibilityConverter x:Key="TextToVis" />

    <!--
        ============ 全局悬停提示 ============
        WPF 默认的 ToolTip 是浅色底 + 黑字，在深色界面里非常扎眼，这里统一成深色卡片。
        不描边（和 PrimaryBtn / 页签一样，1px 描边在 100% 缩放下四角会发黑），只用纯色填充 + 轻阴影拉开层次
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        MaxWidth="360"
                        Padding="9,5"
                        Background="#FF25394F"
                        CornerRadius="7">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.45"
                                ShadowDepth="3"
                                Color="#FF04080D" />
                        </Border.Effect>
                        <ContentPresenter>
                            <!--  提示里的长文本（比如整条下载地址）自动换行，不要撑出屏幕  -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ 文本 ============  -->
    <!--
        这里不写 TextOptions.TextFormattingMode：整形模式由窗口统一设为 Display，
        样式里一旦写死（曾经是 Ideal）就会盖掉窗口那条继承值 —— 样式 setter 的优先级高于属性继承。
        Ideal 在 96 DPI（100% 缩放的屏）下小字号会发虚，Display 才是像素对齐的清晰版。
    -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style
        x:Key="T.H1"
        BasedOn="{StaticResource T.Base}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Head}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="T.Dim"
        BasedOn="{StaticResource T.Base}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
    </Style>

    <Style
        x:Key="T.Mute"
        BasedOn="{StaticResource T.Base}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}" />
    </Style>

    <!--  ============ 滚动条 ============  -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="b"
                        Margin="2,0"
                        Background="#FF2C425B"
                        CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF3D5773" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageUpCommand"
                                    Focusable="False"
                                    Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageDownCommand"
                                    Focusable="False"
                                    Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ 侧栏导航 ============  -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFC3D4E6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="9">
                        <Grid>
                            <Border
                                x:Name="Bar"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                Background="{StaticResource B.Accent}"
                                CornerRadius="2"
                                Opacity="0" />
                            <ContentPresenter Margin="13,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1A2A3C" />
                            <Setter Property="Foreground" Value="#FFE4EEF9" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1D324C" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FFF4F9FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!--
        设置页左侧的分组菜单：比主导航矮一档、字号也小一点，
        选中态沿用主导航那根蓝色小竖条，视觉上还是同一套语言。
    -->
    <Style x:Key="SetNavItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
    </Style>

    <Style x:Key="SetNavList" TargetType="ListBox" BasedOn="{StaticResource NavList}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SetNavItem}" />
    </Style>

    <!--  ============ 按钮 ============  -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="b"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF22364D" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1A2A3E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="CloseBtn"
        BasedOn="{StaticResource IconBtn}"
        TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="b"
                        Background="Transparent"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        主按钮的模板单独抽成一份资源：详情页的「启动程序」在「能启动」时要换成这套蓝色外观，
        DataTrigger 里只能改 Template / 属性，没法把 Style 换成另一个 Style，所以模板得能被引用。
    -->
    <ControlTemplate x:Key="PrimaryBtnTemplate" TargetType="Button">
        <Grid>
            <!--
                圆角怎么画才在 100% 和 150% 缩放下都干净：
                实心块和深色卡片底直接相接时，圆角那一圈抗锯齿会在 1x 上摊成 2~3 个像素的暗色过渡，
                看着就像四角描了一圈黑线（150% 下同样的过渡只占 1 个设备像素，所以显不出来）。
                这里在填充外面垫一层同色、更淡的圆角块：填充的抗锯齿只跟自己的颜色混，
                最外圈变成一圈很淡的同色光，角上不再是"深色压深色"。
            -->
            <Border
                Margin="-1"
                Background="#4A3B82F6"
                CornerRadius="11"
                IsHitTestVisible="False" />
            <Border
                x:Name="b"
                Background="{StaticResource B.Accent}"
                CornerRadius="10" />
            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF4B8DFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF2C6FD8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
        <Setter Property="Template" Value="{StaticResource PrimaryBtnTemplate}" />
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="b"
                        Padding="{TemplateBinding Padding}"
                        Background="#FF1D2C3F"
                        BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF24384F" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF3A5473" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF18263A" />
                        </Trigger>
                        <!--  不可用（比如还没下载好时点不了「启动」）时整体压暗  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        危险操作按钮（确认框里那个「清除」这类不可撤销的动作）：实心红底 + 白字，
        红得比系统警示框克制一点，和深蓝底色放一起不刺眼，但一眼能看出是「删东西」。
        圆角处理和 PrimaryBtn 一样：纯填充 + 外面一圈很淡的同色衬底，不再描亮边
    -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!--  和 PrimaryBtn 同一套做法：外面垫一圈淡红，圆角不再和深色底硬碰硬  -->
                        <Border
                            Margin="-1"
                            Background="#4AD93A3A"
                            CornerRadius="10"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="b"
                            Background="#FFD93A3A"
                            CornerRadius="9" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFE54A4A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFB92B2B" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        首页右上角的「最近更新 / 热门游戏」页签。
        画法和 PrimaryBtn 一致：纯填充 + 外面一圈很淡的同色衬底，不再描边——
        100% 缩放下 1 DIP 的描边走圆弧时会被摊成 2~3 个半透明像素，形成一圈发黑的过渡带；
        换成填充 + 同色衬底后，圆弧只和同色混合，四角和直边观感一致，2K 下也几乎无差别
    -->
    <Style x:Key="LibraryTabButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="halo"
                            Margin="-1"
                            Background="#8C3A5473"
                            CornerRadius="9"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="b"
                            Background="#FF1D2C3F"
                            CornerRadius="8" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF24384F" />
                            <Setter TargetName="halo" Property="Background" Value="#8C3A5473" />
                        </Trigger>
                        <!--  选中态：这次没有单独的选中标记，靠 IsEnabled=False 表示"当前就在这一栏"  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#FF2C5885" />
                            <Setter TargetName="halo" Property="Background" Value="#8C4A8AC3" />
                            <Setter Property="Foreground" Value="#FFF2F8FF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  关闭窗口按钮（详情弹框用）  -->
    <Style x:Key="RoundCloseBtn" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#FFD5E2F2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="b"
                        Background="#99060D16"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Icon}"
                            FontSize="14"
                            Text="&#xE711;" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
