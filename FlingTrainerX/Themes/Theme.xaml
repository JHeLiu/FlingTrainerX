<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:FlingTrainerX.Converters">

    <!-- 卡片尺寸：版心固定，一行恒定 5 张；这里只是加载完数据前 / 设计期的默认值，运行时按版心宽度算 -->
    <sys:Double x:Key="CardW">223</sys:Double>
    <sys:Double x:Key="CardH">209</sys:Double>

    <!-- 卡片下半部的文字区高度：封面 = 卡高 − 这个值，正好是 16:9（两行标题 + 标签行） -->
    <GridLength x:Key="CardInfoH">84</GridLength>

    <!-- ============ 调色板 ============
         整体比上一版提亮一档：底色从近黑改成深蓝灰，卡片和面板都比页面底明显高一层，
         长时间看不至于"闷在黑洞里"；文字同步提亮（Dim/Mute 不再糊进背景） -->
    <Color x:Key="C.BgDeep">#FF0F1B2B</Color>
    <Color x:Key="C.BgMain">#FF18283C</Color>
    <Color x:Key="C.BgSide">#FF132132</Color>
    <Color x:Key="C.Accent">#FF3B82F6</Color>

    <SolidColorBrush x:Key="B.BgDeep" Color="{StaticResource C.BgDeep}" />
    <SolidColorBrush x:Key="B.BgMain" Color="{StaticResource C.BgMain}" />
    <SolidColorBrush x:Key="B.BgSide" Color="{StaticResource C.BgSide}" />
    <SolidColorBrush x:Key="B.Card" Color="#FF213348" />
    <SolidColorBrush x:Key="B.Panel" Color="#FF1D2E42" />
    <SolidColorBrush x:Key="B.PanelSoft" Color="#FF263B51" />
    <SolidColorBrush x:Key="B.Border" Color="#FF354E6B" />
    <SolidColorBrush x:Key="B.BorderSoft" Color="#FF2C4259" />
    <SolidColorBrush x:Key="B.Text" Color="#FFF2F7FD" />
    <SolidColorBrush x:Key="B.TextDim" Color="#FFC6D5E5" />
    <SolidColorBrush x:Key="B.TextMute" Color="#FF97ACC2" />
    <SolidColorBrush x:Key="B.Accent" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="B.AccentLight" Color="#FF7CBBFF" />
    <SolidColorBrush x:Key="B.AccentDim" Color="#FF1E3E62" />
    <SolidColorBrush x:Key="B.Cyan" Color="#FF2DD4E8" />
    <SolidColorBrush x:Key="B.Green" Color="#FF34D399" />

    <!-- 卡片底部压暗，保证标题可读 -->
    <LinearGradientBrush x:Key="B.CardScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0014202F" Offset="0.28" />
        <GradientStop Color="#B314202F" Offset="0.68" />
        <GradientStop Color="#F2121D2B" Offset="1" />
    </LinearGradientBrush>

    <!-- 详情页头图只压下半部分：整张图压得太狠会看不出画面 -->
    <!-- 横幅底部压暗：只在最下方压一点，让白色标题可读，上面尽量保留原图 -->
    <LinearGradientBrush x:Key="B.BannerScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00070E17" Offset="0" />
        <GradientStop Color="#1A070E17" Offset="0.55" />
        <GradientStop Color="#7A070E17" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe MDL2 Assets</FontFamily>

    <conv:ImagePathConverter x:Key="ImgConv" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:TextToVisibilityConverter x:Key="TextToVis" />

    <!-- ============ 全局悬停提示 ============
         WPF 默认的 ToolTip 是浅色底 + 黑字，在深色界面里非常扎眼，这里统一成深色卡片。
         不描边（和 PrimaryBtn / 页签一样，1px 描边在 100% 缩放下四角会发黑），只用纯色填充 + 轻阴影拉开层次 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        MaxWidth="360"
                        Padding="9,5"
                        Background="#FF25394F"
                        CornerRadius="7">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.45"
                                ShadowDepth="3"
                                Color="#FF04080D" />
                        </Border.Effect>
                        <ContentPresenter>
                            <!--  提示里的长文本（比如整条下载地址）自动换行，不要撑出屏幕  -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 文本 ============ -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.H1" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="T.Dim" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
    </Style>

    <Style x:Key="T.Mute" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}" />
    </Style>

    <!-- ============ 滚动条 ============ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" CornerRadius="3" Background="#FF2C425B" Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF3D5773" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 侧栏导航 ============ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFC3D4E6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" CornerRadius="9" Background="Transparent">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{StaticResource B.Accent}" Opacity="0" />
                            <ContentPresenter Margin="13,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1A2A3C" />
                            <Setter Property="Foreground" Value="#FFE4EEF9" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1D324C" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FFF4F9FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF22364D" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1A2A3E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!--
                          圆角怎么画才在 100% 和 150% 缩放下都干净：
                          实心块和深色卡片底直接相接时，圆角那一圈抗锯齿会在 1x 上摊成 2~3 个像素的暗色过渡，
                          看着就像四角描了一圈黑线（150% 下同样的过渡只占 1 个设备像素，所以显不出来）。
                          这里在填充外面垫一层同色、更淡的圆角块：填充的抗锯齿只跟自己的颜色混，
                          最外圈变成一圈很淡的同色光，角上不再是"深色压深色"。
                        -->
                        <Border
                            Margin="-1"
                            Background="#4A3B82F6"
                            CornerRadius="11"
                            IsHitTestVisible="False" />
                        <Border x:Name="b" Background="{StaticResource B.Accent}" CornerRadius="10" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF4B8DFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF2C6FD8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="#FF1D2C3F" BorderThickness="1" BorderBrush="{StaticResource B.Border}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF24384F" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF3A5473" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF18263A" />
                        </Trigger>
                        <!-- 不可用（比如还没下载好时点不了「启动」）时整体压暗 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作按钮（确认框里那个「清除」这类不可撤销的动作）：实心红底 + 白字，
         红得比系统警示框克制一点，和深蓝底色放一起不刺眼，但一眼能看出是「删东西」。
         圆角处理和 PrimaryBtn 一样：纯填充 + 外面一圈很淡的同色衬底，不再描亮边 -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!--  和 PrimaryBtn 同一套做法：外面垫一圈淡红，圆角不再和深色底硬碰硬  -->
                        <Border
                            Margin="-1"
                            Background="#4AD93A3A"
                            CornerRadius="10"
                            IsHitTestVisible="False" />
                        <Border x:Name="b" Background="#FFD93A3A" CornerRadius="9" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFE54A4A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFB92B2B" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  首页右上角的「最近更新 / 热门游戏」页签。
          画法和 PrimaryBtn 一致：纯填充 + 外面一圈很淡的同色衬底，不再描边——
          100% 缩放下 1 DIP 的描边走圆弧时会被摊成 2~3 个半透明像素，形成一圈发黑的过渡带；
          换成填充 + 同色衬底后，圆弧只和同色混合，四角和直边观感一致，2K 下也几乎无差别  -->
    <Style x:Key="LibraryTabButton" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="halo" Margin="-1" Background="#8C3A5473" CornerRadius="9"
                            IsHitTestVisible="False" />
                        <Border x:Name="b" Background="#FF1D2C3F" CornerRadius="8" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF24384F" />
                            <Setter TargetName="halo" Property="Background" Value="#8C3A5473" />
                        </Trigger>
                        <!--  选中态：这次没有单独的选中标记，靠 IsEnabled=False 表示"当前就在这一栏"  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#FF2C5885" />
                            <Setter TargetName="halo" Property="Background" Value="#8C4A8AC3" />
                            <Setter Property="Foreground" Value="#FFF2F8FF" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭窗口按钮（详情弹框用） -->
    <Style x:Key="RoundCloseBtn" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#FFD5E2F2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="16" Background="#99060D16" BorderThickness="1" BorderBrush="#33FFFFFF">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 收藏夹卡片左上角的「取消收藏」小按钮 -->
    <Style x:Key="CardFavRemove" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#FFD5E2F2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="12" Background="#B3060D16"
                            BorderThickness="1" BorderBrush="#33FFFFFF">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFD93A3A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FFD93A3A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 卡片 ============ -->
    <Style x:Key="CardButton" TargetType="Button">
        <!--
            宽度不写死：由 CardRowPanel 按「可用宽度 - 间距」精算后撑满一格，
            这样第一张贴左、最后一张贴右，和上方标题左右严格对齐。
        -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{DynamicResource CardH}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="13" Background="{StaticResource B.Card}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Grid>
                            <Border CornerRadius="12" Background="#FF121F2F" />
                            <ContentPresenter />
                            <Border x:Name="Glow" CornerRadius="12" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#3D3B82F6" Offset="0" />
                                        <GradientStop Color="#003B82F6" Offset="0.55" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="12" BorderThickness="1.4"
                                    BorderBrush="Transparent" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="BorderBrush" Value="#FF5A9BF8" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Root" Property="Background" Value="#FF21344C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 虚拟滚动列表（首页卡片墙） ============ -->
    <Style x:Key="CardRowContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CardRowContainer}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!--  不预创建视口外的行，避免屏幕外卡片提前创建图片画刷  -->
        <Setter Property="VirtualizingPanel.CacheLength" Value="0" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="PART_Scroll" Background="Transparent"
                                  Padding="{TemplateBinding Padding}" Focusable="False"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 搜索框 ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <!--  不要写死 Height：TextBox 内部会把文字往下挤几个像素，
              只有让它按自身内容高度居中（VerticalAlignment=Center），文字才和左边的图标同轴  -->
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.AccentLight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 芯片 / 标签 ============ -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Background" Value="#FF1F3149" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#FF2C425C" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="KeyBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="#FF213650" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#FF315070" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ 搜索框的游戏名智能提示条目 ============ -->
    <Style x:Key="SuggestItem" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Row"
                        Padding="10,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#FF2A425E" />
                        </Trigger>
                        <!--  方向键选中的那一行要一眼看得出：更亮一档底 + 蓝色描边  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#FF2A5480" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="#FF4C8FD6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 分页栏按钮（右下角 上一页 / 下一页） ============ -->
    <Style x:Key="PagerButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Background="#FF25405C"
                            BorderThickness="1" BorderBrush="#FF3A587A">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF33546F" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF4E7398" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF18263A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 详情弹框：选项卡 ============ -->
    <Style x:Key="DetailTab" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="14,7" Margin="0,0,6,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1C2B3D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下载表格的一行（整行可点） -->
    <Style x:Key="DownloadRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8"
                            BorderThickness="0,0,0,1" BorderBrush="#FF233649" Padding="10,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1E3350" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF18293E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowIconBtn" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF2A4260" />
                            <Setter Property="Foreground" Value="{StaticResource B.AccentLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 下载进度 ============ -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FF31424F" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF3B82F6" Offset="0" />
                                        <GradientStop Color="#FF2DD4E8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 服务器不给总大小时（官网是流式转发），用滚动块表示还在下。
                                 往返扫动而不是单向跑出画面，保证窄进度条上也一直看得见。 -->
                            <Canvas x:Name="MarqueeHost" ClipToBounds="True" Visibility="Collapsed">
                                <Rectangle x:Name="Marquee" Width="110" Height="{TemplateBinding Height}"
                                           RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#003B82F6" Offset="0" />
                                            <GradientStop Color="#FF2DD4E8" Offset="0.5" />
                                            <GradientStop Color="#003B82F6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeMove" X="-60" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MarqueeHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MarqueeStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MarqueeMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-60" To="330"
                                                         Duration="0:0:0.85" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MarqueeStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下载表格「状态」列里的细进度条：位置窄，滚动块按列宽来回扫，保证一直看得见 -->
    <Style x:Key="MiniProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#FF31424F" />
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF3B82F6" Offset="0" />
                                        <GradientStop Color="#FF2DD4E8" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!--  服务器不给总大小时来回扫动，区间贴着状态列宽度（约 76px）  -->
                            <Canvas x:Name="MiniHost" ClipToBounds="True" Visibility="Collapsed">
                                <Rectangle x:Name="MiniShine" Width="46" Height="{TemplateBinding Height}"
                                           RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#003B82F6" Offset="0" />
                                            <GradientStop Color="#FF2DD4E8" Offset="0.5" />
                                            <GradientStop Color="#003B82F6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="MiniMove" X="-46" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MiniHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MiniStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MiniMove"
                                                         Storyboard.TargetProperty="X"
                                                         From="-46" To="82"
                                                         Duration="0:0:1.1" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MiniStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 软件截图：一张图占满整行，高度由图片比例决定；悬停不加描边（只保留手型光标） -->
    <Style x:Key="ShotCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" CornerRadius="10" Background="#FF121F2F" ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下载表格的一行：鼠标划过 / 被选中（选中的行就是右侧「启动程序」要启动的那个文件） -->
    <Style x:Key="DownloadRowItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#FF223649" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF1E3350" />
            </Trigger>
            <!--  放在悬停之后：鼠标停在被选中的行上时，仍然显示选中色  -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#FF254260" />
                <Setter Property="BorderBrush" Value="#FF3A688F" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 下载状态文字：未下载（灰）/ 正在下载（蓝）/ 已下载（绿） -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!--  未下载/等待这类"安静"的状态也要看得清，别糊进深底里  -->
        <Setter Property="Foreground" Value="#FFD4DFEB" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKind}" Value="Active">
                <Setter Property="Foreground" Value="#FF6FB1FF" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="Done">
                <Setter Property="Foreground" Value="{StaticResource B.Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKind}" Value="Failed">
                <Setter Property="Foreground" Value="#FFF07878" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 下载行右侧的小按钮：下载 / 取消 / 重试 -->
    <Style x:Key="RowActionBtn" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="#FF9EC5FF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="7" Padding="{TemplateBinding Padding}"
                            Background="#FF1E3350" BorderThickness="1" BorderBrush="#FF315070">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF27466A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF457BAB" />
                            <Setter Property="Foreground" Value="#FFD9E9FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF1A3050" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
