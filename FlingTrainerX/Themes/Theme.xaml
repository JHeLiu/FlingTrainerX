    <!--  ============ 卡片 ============  -->
    <Style x:Key="CardButton" TargetType="Button">
        <!--
            宽度不写死：由 CardRowPanel 按「可用宽度 - 间距」精算后撑满一格，
            这样第一张贴左、最后一张贴右，和上方标题左右严格对齐。
        -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{DynamicResource CardH}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{StaticResource B.Card}"
                        BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1"
                        CornerRadius="13"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border Background="#FF121F2F" CornerRadius="12" />
                            <ContentPresenter />
                            <Border
                                x:Name="Glow"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#3D3B82F6" />
                                        <GradientStop Offset="0.55" Color="#003B82F6" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border
                                x:Name="Hover"
                                BorderBrush="Transparent"
                                BorderThickness="1.4"
                                CornerRadius="12" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="BorderBrush" Value="#FF5A9BF8" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Root" Property="Background" Value="#FF21344C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ 虚拟滚动列表（首页卡片墙） ============  -->
    <Style x:Key="CardRowContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="True" />
