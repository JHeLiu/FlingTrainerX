<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- DPI is configured by the WPF application manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>FlingTrainerX</RootNamespace>
    <!-- 程序集/可执行文件名就用中文，桌面、开始菜单里的快捷方式名才会跟着对 -->
    <AssemblyName>风灵月影宗藏宝阁</AssemblyName>
    <AssemblyTitle>风灵月影宗藏宝阁</AssemblyTitle>
    <Product>风灵月影宗藏宝阁</Product>
    <Description>风灵月影宗藏宝阁 · FLiNG 修改器库</Description>
    <Company>风灵月影宗</Company>
    <!--
        版本号真正的来源是项目里的 config.json（启动时由 AppConfig 读进静态字段），
        打包脚本 publish.ps1 会在编译前把它改成本次版本号。
        这里的 <Version> 只是兜底：配置文件缺失时程序会退回程序集版本。
    -->
    <Version>1.0.2</Version>
    <!-- exe / 任务栏 / 桌面快捷方式统一用这个多尺寸图标 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- PerMonitorV2：高 DPI 与多屏混合缩放的关键，清单位于 app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 侧栏 Logo 与窗口图标（WPF 的 Window.Icon 用 PNG 解得更干净） -->
    <Resource Include="Assets\logo.png" />
    <!-- 灵石结缘收款码：已经压过（原图 4M/3M，640 宽 q85 后约 170K/120K），直接嵌进程序 -->
    <Resource Include="Assets\alipay.jpeg" />
    <Resource Include="Assets\wxpay.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <!--
      程序配置：项目里的 config.json 是唯一来源（见 Services\AppConfig.cs，启动时读进静态字段）。
      里面记着「当前版本号」和「启动要不要自动检查更新」，编译时原样复制到输出目录根部，
      exe 旁边就是 config.json，随安装包一起发。发版脚本会在编译前把新版本号写进这个文件。
    -->
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 免责声明正文：放成独立文本文件，随程序一起发布，改文案不用重新编译（文件名用英文，避开中文路径问题） -->
    <None Update="Assets\disclaimer.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 更新内容正文：同上，发版前改这个文件就行 -->
    <None Update="Assets\changelog.txt" CopyToOutputDirectory="PreserveNewest" />
    <!--
      不再随包发布 Assets\update.json：仓库地址已经写死在 UpdateService 里
      （DefaultOwner / DefaultRepo），多一个可编辑的配置文件只会让 token 更容易外泄。
      真要临时换仓库或给私有库填 token，在 exe 旁边手放一个同名文件即可，读取逻辑还留着。
    -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.9.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
  </ItemGroup>

</Project>
