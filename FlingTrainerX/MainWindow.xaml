<Window
    x:Class="FlingTrainerX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:FlingTrainerX.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="风灵月影宗藏宝阁"
    Width="1280"
    Height="780"
    Background="{StaticResource B.BgDeep}"
    FontFamily="{StaticResource F.Ui}"
    Icon="/Assets/logo.png"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--  外框：圆角 + 一圈描边，DWM 负责窗口本身的圆角，Clip 负责别让内容溢出去  -->
    <Border
        x:Name="Shell"
        Background="{StaticResource B.BgDeep}"
        BorderBrush="#FF2F4967"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ==================== 左侧栏 ====================  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource B.BgSide}"
                BorderBrush="#FF2A3F57"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Logo  -->
                    <Grid
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  Logo：直接用应用图标（图片本身是圆形 + 透明角，不需要再裁）  -->
                            <Image
                                Width="30"
                                Height="30"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/logo.png"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Subtitle}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource B.Text}"
                                Text="风灵月影宗藏宝阁" />
                        </StackPanel>
                    </Grid>

                    <!--  导航：游戏库 / 收藏夹 / 下载队列 / 设置  -->
                    <ListBox
                        x:Name="NavList"
                        Grid.Row="1"
                        Margin="10,6,10,0"
                        SelectionChanged="NavList_SelectionChanged"
                        Style="{StaticResource NavList}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="16"
                                    Text="&#xE7FC;" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Body}"
                                    Text="游戏库" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="16"
                                    Text="&#xE734;" />
                                <TextBlock
                                    x:Name="NavFavLabel"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Body}"
                                    Text="收藏夹" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="16"
                                    Text="&#xE896;" />
                                <TextBlock
                                    x:Name="NavQueueLabel"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Body}"
                                    Text="下载队列" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="16"
                                    Text="&#xE713;" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Body}"
                                    Text="设置" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!--  底部信息  -->
                    <Border
                        Grid.Row="3"
                        Margin="14,0,14,16"
                        Padding="12,10"
                        Background="#FF192A3C"
                        BorderBrush="#FF2A3F57"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="{StaticResource B.TextMute}"
                                Text="数据源" />
                            <!--  整块可点：点一下用默认浏览器打开官网（图标表示「会在外部打开」）  -->
                            <Border
                                x:Name="DataSourceLink"
                                Margin="0,3,0,0"
                                Padding="0,2"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="DataSourceLink_Click"
                                ToolTip="在浏览器中打开 https://flingtrainer.com">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="TextBlock.Foreground" Value="#FF7FB4FF" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextBlock.Foreground" Value="#FFC6E0FF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="{StaticResource Fs.Small}" Text="flingtrainer.com" />
                                    <TextBlock
                                        Margin="4,0,0,1"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Fs.Caption}"
                                        Opacity="0.75"
                                        Text="↗" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="SidebarSyncText"
                                Margin="0,6,0,0"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="{StaticResource B.TextMute}"
                                Text="—" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  ==================== 右侧主体 ====================  -->
            <Grid Grid.Column="1" Background="{StaticResource B.BgMain}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <!--  状态栏：48 高，右侧分页按钮才装得下 30 高的方块  -->
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <!--  顶栏  -->
                <Grid
                    Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  搜索：输入时不动列表，按回车才向官网发请求；聚焦时描边变蓝提示  -->
                    <Border
                        x:Name="SearchShell"
                        Width="360"
                        Height="38"
                        Margin="26,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF162438" />
                                <Setter Property="BorderBrush" Value="#FF2F4967" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Background" Value="#FF1C2D44" />
                                        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  放大镜：外框 16 高，和输入框里的文字同一条中轴  -->
                            <Border
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="&#xE721;" />
                            </Border>

                            <!--
                                必须用 PreviewKeyDown：单行 TextBox 自己的类处理器会把 ↑↓ 当成
                                「光标移到行首 / 行尾」先吃掉，KeyDown 里根本收不到方向键
                            -->
                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                PreviewKeyDown="SearchBox_PreviewKeyDown"
                                Style="{StaticResource SearchBox}"
                                TextChanged="SearchBox_TextChanged" />
                            <TextBlock
                                x:Name="SearchHint"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Body}"
                                Foreground="{StaticResource B.TextMute}"
                                IsHitTestVisible="False"
                                Text="输入游戏名 / 中文名，回车搜索" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="#FF40556B"
                                Text="Ctrl+K" />
                        </Grid>
                    </Border>

                    <!--
                        智能提示：输入时从本地 SQLite 的 game_names 里找游戏名（英文名 + Steam 中文名），
                        选中后回填英文名，真正的搜索仍然发给官网。
                        放在 Popup 里，不会被顶栏裁掉，也不会占布局高度。
                        
                        StaysOpen 必须是 True：Popup 自己是一个独立 HWND，StaysOpen=False 时
                        鼠标按在列表上会被当成「点在了外面」，Popup 先关掉、点击也就丢了 ——
                        这正是之前「鼠标点提示项没反应」的原因。关闭改由窗口自己判断（见 OnPreviewMouseDown）。
                    -->
                    <Popup
                        x:Name="SuggestPopup"
                        AllowsTransparency="True"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=SearchShell}"
                        PopupAnimation="Fade"
                        StaysOpen="True">
                        <Border
                            Width="360"
                            Margin="0,6,0,0"
                            Padding="6"
                            Background="#FF1C2D44"
                            BorderBrush="#FF3A5573"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="0.45"
                                    ShadowDepth="6"
                                    Color="#FF000000" />
                            </Border.Effect>
                            <ListBox
                                x:Name="SuggestList"
                                MaxHeight="304"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource SuggestItem}"
                                PreviewMouseLeftButtonDown="SuggestList_PreviewMouseLeftButtonDown"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource Fs.Body}"
                                                Foreground="#FFF2F7FC"
                                                Text="{Binding CleanEn}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MaxWidth="150"
                                                Margin="12,0,4,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource Fs.Small}"
                                                Foreground="{StaticResource B.AccentLight}"
                                                Text="{Binding NameCn}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!--  窗口按钮  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--
                            刷新按钮：鼠标放上去就展开「更新已有游戏 / 更新全部游戏」菜单，
                            移开自动收起；点按钮本身还是「重读本地库」（不联网）。
                        -->
                        <Grid
                            x:Name="RefreshHost"
                            MouseEnter="RefreshHost_MouseEnter"
                            MouseLeave="RefreshHost_MouseLeave">
                            <Button
                                x:Name="RefreshButton"
                                Click="Refresh_Click"
                                Style="{StaticResource IconBtn}"
                                ToolTip="重新读取本地数据 · 鼠标悬停可更新">
                                <TextBlock
                                    x:Name="RefreshGlyph"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="16"
                                    RenderTransformOrigin="0.5,0.5"
                                    Text="&#xE72C;" />
                            </Button>

                            <Popup
                                x:Name="SyncMenuPopup"
                                AllowsTransparency="True"
                                HorizontalOffset="-108"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=RefreshHost}"
                                PopupAnimation="Fade"
                                StaysOpen="True"
                                VerticalOffset="6">
                                <Border
                                    x:Name="SyncMenuBorder"
                                    Width="142"
                                    Padding="4"
                                    Background="#FF16202D"
                                    BorderBrush="#FF2C3E53"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MouseEnter="SyncMenu_MouseEnter"
                                    MouseLeave="SyncMenu_MouseLeave">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="18"
                                            Direction="270"
                                            Opacity="0.5"
                                            ShadowDepth="4"
                                            Color="#FF000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MenuCaption}" Text="数据更新" />

                                        <Button
                                            x:Name="SyncMenuExisting"
                                            Click="SyncMenuExisting_Click"
                                            Style="{StaticResource MenuRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource MenuRowIcon}" Text="&#xE72C;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource MenuRowLabel}"
                                                    Text="更新已有游戏" />
                                            </Grid>
                                        </Button>

                                        <Button
                                            x:Name="SyncMenuAll"
                                            Click="SyncMenuAll_Click"
                                            Style="{StaticResource MenuRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource MenuRowIcon}" Text="&#xE895;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource MenuRowLabel}"
                                                    Text="更新全部游戏" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0"
                            Background="#FF2F4967" />
                        <Button
                            Click="Minimize_Click"
                            Style="{StaticResource IconBtn}"
                            ToolTip="最小化到托盘">
                            <TextBlock
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="14"
                                Text="&#xE921;" />
                        </Button>
                        <Button
                            Click="Close_Click"
                            Style="{StaticResource CloseBtn}"
                            ToolTip="关闭">
                            <TextBlock
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="14"
                                Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  主体区  -->
                <Grid x:Name="MainArea" Grid.Row="1">

                    <!--  游戏卡片区：固定版心（最大 1460），再宽的屏幕整块居中  -->
                    <Grid
                        x:Name="CardArea"
                        Margin="26,0,26,0"
                        HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,6,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SectionTitle"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Head}"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource T.Base}"
                                    Text="{Binding SectionTitle}" />
                                <StackPanel
                                    x:Name="LibraryTabs"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Visibility="{Binding LibraryTabsVisible, Converter={StaticResource BoolToVis}}">
                                    <Button
                                        x:Name="RecentTabButton"
                                        Click="LibraryTab_Click"
                                        Content="最近更新"
                                        IsEnabled="{Binding RecentTabEnabled}"
                                        Style="{StaticResource LibraryTabButton}"
                                        Tag="Recent" />
                                    <Button
                                        x:Name="PopularTabButton"
                                        Margin="6,0,0,0"
                                        Click="LibraryTab_Click"
                                        Content="热门游戏"
                                        IsEnabled="{Binding PopularTabEnabled}"
                                        Style="{StaticResource LibraryTabButton}"
                                        Tag="Popular" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="SectionSubtitle"
                                Margin="1,4,0,0"
                                Style="{StaticResource T.Mute}"
                                Text="{Binding SectionSubtitle}"
                                Visibility="{Binding SectionSubtitle, Converter={StaticResource TextToVis}}" />
                        </StackPanel>

                        <!--  卡片列表：一行 5 张 × 3 行 = 每页 15 条，默认正好铺满一屏；放不下时才出滚动条  -->
                        <ListBox
                            x:Name="CardList"
                            Grid.Row="1"
                            ItemsSource="{Binding Rows}"
                            Style="{StaticResource CardListBox}"
                            Tag="{Binding IsFavoritesView}"
                            Visibility="{Binding CardListVisible, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ctrl:CardRowPanel
                                                    Columns="5"
                                                    Gap="8"
                                                    MaxChildWidth="{DynamicResource CardW}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Click="Card_Click"
                                                    MouseEnter="Card_MouseEnter"
                                                    MouseLeave="Card_MouseLeave"
                                                    Style="{StaticResource CardButton}"
                                                    Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="{DynamicResource CardInfoH}" />
                                                        </Grid.RowDefinitions>

                                                        <!--  ===== 封面区：16:9，等比完整显示，不裁剪也不变形；只有上面两角是圆的，下面和标题区连成一片  =====  -->
                                                        <Grid Grid.Row="0">
                                                            <Border Background="#FF1B2B40" CornerRadius="12,12,0,0" />

                                                            <!--  封面图下面的水印字母：没有封面、图还没下完或下载失败时都能看到，不会留一块空白色块  -->
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe UI"
                                                                FontSize="{StaticResource Fs.Watermark}"
                                                                FontWeight="SemiBold"
                                                                Foreground="#22FFFFFF"
                                                                IsHitTestVisible="False"
                                                                Text="{Binding Initials}" />

                                                            <!--  封面图用 Border 背景绘制：圆角会一起裁掉，鼠标悬停放大时不会溢出卡片  -->
                                                            <Border x:Name="CoverArt" CornerRadius="12,12,0,0">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverSource, Converter={StaticResource ImgConv}}" Stretch="Uniform">
                                                                        <ImageBrush.RelativeTransform>
                                                                            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                                                        </ImageBrush.RelativeTransform>
                                                                    </ImageBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <Border Background="{StaticResource B.CardScrim}" CornerRadius="12,12,0,0" />

                                                            <!--  收藏夹里才有：取消收藏  -->
                                                            <Button
                                                                Margin="8,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Click="RemoveFavorite_Click"
                                                                Style="{StaticResource CardFavRemove}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>

                                                        <!--  ===== 文字区：标题 + 两个小标签（更新时间 / 选项数），整卡可点打开详情  =====  -->
                                                        <Grid Grid.Row="1" Margin="13,7,13,9">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!--
                                                                标题最多两行（LineHeight 19 × 2 = 38），第三行整行裁掉；
                                                                不能加 TextTrimming：它和 TextWrapping 一起用时会被压成单行省略。
                                                                也不挂 ToolTip：卡片上已经有名字，鼠标划过再弹一层纯属打扰。
                                                            -->
                                                            <TextBlock
                                                                MaxHeight="40"
                                                                VerticalAlignment="Top"
                                                                FontSize="{StaticResource Fs.Body}"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"
                                                                LineHeight="20"
                                                                Text="{Binding DisplayTitle}"
                                                                TextWrapping="Wrap" />

                                                            <!--
                                                                选项数 / 更新时间两个标签（修改项在前、时间在后）：
                                                                底色比卡片再暗一档（半透明黑压一层），文字用次级灰蓝而不是纯白，
                                                                做成「沉在卡片里」的注脚，不再和游戏名抢视线；小圆角、不描边。
                                                                统一贴底，标题一行 / 两行时都在同一条水平线上
                                                            -->
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Margin="0,6,0,0"
                                                                Orientation="Horizontal">
                                                                <Border
                                                                    Padding="7,3"
                                                                    Background="#4D08121E"
                                                                    CornerRadius="6"
                                                                    ToolTip="这款游戏可用的修改项数"
                                                                    Visibility="{Binding OptionCountTag, Converter={StaticResource TextToVis}}">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="{StaticResource Fs.Caption}"
                                                                        Foreground="#FFA9BED3"
                                                                        Text="{Binding OptionCountTag}" />
                                                                </Border>

                                                                <Border
                                                                    Margin="4,0,0,0"
                                                                    Padding="7,3"
                                                                    Background="#4D08121E"
                                                                    CornerRadius="6"
                                                                    ToolTip="{Binding UpdatedTip}">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="{StaticResource Fs.Caption}"
                                                                        Foreground="#FFA9BED3"
                                                                        Text="{Binding UpdatedShort}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  空状态  -->
                        <Grid
                            x:Name="EmptyState"
                            Grid.Row="1"
                            Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel
                                Margin="0,0,0,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="#FF22354B"
                                    CornerRadius="16">
                                    <TextBlock
                                        x:Name="EmptyGlyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="26"
                                        Foreground="#FF3E5670"
                                        Text="{Binding EmptyGlyph}" />
                                </Border>
                                <TextBlock
                                    x:Name="EmptyTitle"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource Fs.Title}"
                                    FontWeight="SemiBold"
                                    Foreground="#FFD3E0EE"
                                    Text="{Binding EmptyTitle}" />
                                <TextBlock
                                    x:Name="EmptyDesc"
                                    MaxWidth="{Binding EmptyDescMaxWidth}"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="{StaticResource B.TextMute}"
                                    LineHeight="21"
                                    Text="{Binding EmptyDesc}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <!--
                                    本地一条数据都没有时唯一该做的事：这里直接给一个更新入口，
                                    不用再让用户自己找「设置 → 数据更新」。
                                -->
                                <Button
                                    x:Name="EmptySyncButton"
                                    Height="36"
                                    Margin="0,18,0,0"
                                    Padding="20,0"
                                    HorizontalAlignment="Center"
                                    Click="EmptySync_Click"
                                    Content="更新数据"
                                    FontSize="{StaticResource Fs.Body}"
                                    Style="{StaticResource PrimaryBtn}"
                                    Visibility="{Binding EmptySyncVisible, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <!--  ==================== 设置 ====================  -->
                        <Grid
                            x:Name="SettingsPanel"
                            Grid.Row="1"
                            Visibility="{Binding SettingsPanelVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                左侧分组菜单：一条对应右边一个分组，选中哪条就只显示那一块内容，
                                其余分组整块隐藏（见 SettingsMenu_SelectionChanged）
                            -->
                            <ListBox
                                x:Name="SettingsMenu"
                                Grid.Column="0"
                                Width="128"
                                Margin="26,2,0,0"
                                VerticalAlignment="Top"
                                SelectedIndex="{Binding GroupIndex, Mode=TwoWay}"
                                SelectionChanged="SettingsMenu_SelectionChanged"
                                Style="{StaticResource SetNavList}">
                                <ListBoxItem Content="数据更新" />
                                <ListBoxItem Content="通用" />
                                <ListBoxItem Content="打赏赞助" />
                                <ListBoxItem Content="关于" />
                            </ListBox>

                            <!--
                                右侧内容不再写死版心宽度：吃掉菜单之外的全部宽度，左右各留一点呼吸，
                                分组卡片随之 100% 自适应，窗口若改成可缩放也不用再调这里。
                                内容按分组切成四块（SettingsGroupXxx），左边点哪一项就只显示那一块，
                                其余整块收起不参与布局（见 SettingsMenu_SelectionChanged）
                            -->
                            <ScrollViewer
                                x:Name="SettingsScroll"
                                Grid.Column="1"
                                Margin="18,0,26,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SettingsContent">
                                    <!--
                                        版式参考系统「设置」页：分组标题放在卡片外面（小号灰字），
                                        标题 + 副标题在左、操作按钮在右，一行一件事，行间用极淡的线分隔。
                                    -->
                                    <StackPanel
                                        x:Name="SettingsGroupData"
                                        Visibility="{Binding ShowData, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        x:Name="SettingsHeaderData"
                                        Margin="6,2,0,9"
                                        FontSize="{StaticResource Fs.Small}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF7E93A9"
                                        Text="数据更新" />

                                    <!--  首页只读本地 SQLite，所以「拿新数据」全部集中到这一组  -->
                                    <!--
                                        设置卡片：底色要比页面底（#FF0E1825）明显亮一档、边框也要看得见，
                                        否则在 1080p / 100% 缩放的屏幕上整张卡几乎糊在背景里
                                    -->
                                    <Border
                                        Padding="20,4"
                                        Background="#FF2B4058"
                                        BorderBrush="#FF466280"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <!--
                                                快速更新游戏名：只解析官网 All Trainers (A-Z) 一页名录写进本地库，
                                                一个请求跑完，不抓详情、不碰 Steam 中文名 —— 搜索框的提示靠它。
                                            -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="快速搜索游戏名" />
                                                    <TextBlock
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="快速更新游戏名方便快速查询"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="QuickNamesButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="QuickNames_Click"
                                                    Content="{Binding QuickNamesText}"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    IsEnabled="{Binding UpdateButtonsEnabled}"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="只更新搜索提示用的游戏名库，不下载详情、不更新 Steam 中文名" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <!--  更新全部数据：按官网分页从头翻到尾  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="更新全部游戏数据" />
                                                    <TextBlock
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="从官网更新最新信息；官网没改动的会自动跳过。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="SyncAllButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="SyncAll_Click"
                                                    Content="{Binding UpdateAllText}"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    IsEnabled="{Binding UpdateButtonsEnabled}"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="官网列表与 Steam 中文名同时开跑，互不等待" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <!--  更新已有数据：按本地库逐款重抓详情页  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="更新已有游戏数据" />
                                                    <TextBlock
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="更新本地已存在的游戏最新信息"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="SyncExistingButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="SyncExisting_Click"
                                                    Content="{Binding UpdateExistingText}"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    IsEnabled="{Binding UpdateButtonsEnabled}"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="本地详情与 Steam 中文名同时开跑，互不等待" />
                                            </Grid>

                                        </StackPanel>
                                    </Border>

                                    </StackPanel>

                                    <!--  ======== 通用：清缓存 + 免责声明 ========  -->
                                    <StackPanel
                                        x:Name="SettingsGroupGeneral"
                                        Visibility="{Binding ShowGeneral, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        x:Name="SettingsHeaderGeneral"
                                        Margin="6,2,0,9"
                                        FontSize="{StaticResource Fs.Small}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF7E93A9"
                                        Text="通用" />

                                    <Border
                                        Padding="20,4"
                                        Background="#FF2B4058"
                                        BorderBrush="#FF466280"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="清除缓存" />
                                                    <TextBlock
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="删除本地缓存的卡片数据、图片和已下载文件；收藏不受影响。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="ClearCacheButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="ClearCache_Click"
                                                    Content="清除缓存"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    Style="{StaticResource GhostBtn}" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="免责声明" />
                                                    <TextBlock
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="软件性质与使用须知，使用前请务必阅读。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="About_Click"
                                                    Content="查看声明"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    Style="{StaticResource GhostBtn}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    </StackPanel>

                                    <!--  打赏赞助：随喜投喂入口，弹窗里放收款码  -->
                                    <StackPanel
                                        x:Name="SettingsGroupDonate"
                                        Visibility="{Binding ShowDonate, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        x:Name="SettingsHeaderDonate"
                                        Margin="6,2,0,9"
                                        FontSize="{StaticResource Fs.Small}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF7E93A9"
                                        Text="打赏赞助" />

                                    <Border
                                        Padding="20,4"
                                        Background="#FF2B4058"
                                        BorderBrush="#FF466280"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <Grid Margin="0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="{StaticResource Fs.Subtitle}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FFF0F6FD"
                                                    Text="随喜投喂灵石" />
                                                <TextBlock
                                                    MaxWidth="560"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Left"
                                                    FontSize="{StaticResource Fs.Small}"
                                                    Foreground="#FF8FA3BA"
                                                    LineHeight="20"
                                                    Text="散修炼器，本就不易。若觉此物趁手，可随喜几枚灵石，聊作炼器之资。"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Button
                                                x:Name="SupportButton"
                                                Grid.Column="1"
                                                Height="34"
                                                Margin="24,0,0,0"
                                                Padding="16,0"
                                                VerticalAlignment="Center"
                                                Click="Support_Click"
                                                Content="随喜投喂灵石"
                                                FontSize="{StaticResource Fs.Body}"
                                                Style="{StaticResource GhostBtn}" />
                                        </Grid>
                                    </Border>

                                    </StackPanel>

                                    <!--  关于：版本 / 在线更新 / 更新内容  -->
                                    <StackPanel
                                        x:Name="SettingsGroupAbout"
                                        Visibility="{Binding ShowAbout, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        x:Name="SettingsHeaderAbout"
                                        Margin="6,2,0,9"
                                        FontSize="{StaticResource Fs.Small}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF7E93A9"
                                        Text="关于" />

                                    <Border
                                        Padding="20,4"
                                        Background="#FF2B4058"
                                        BorderBrush="#FF466280"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <!--  软件更新：查 Gitee 发行版；有新版本就弹「发现新版本」  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="软件更新" />
                                                    <TextBlock
                                                        x:Name="UpdateStatusText"
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="{Binding VersionLine}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="CheckUpdateButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="CheckUpdate_Click"
                                                    Content="检查更新"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    IsEnabled="{Binding UpdateButtonEnabled}"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="从 Gitee 发行版取最新版本，启动时也会自动查一次" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <!--  更新内容：只读，看发版说明，不会安装任何东西  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Subtitle}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="更新内容" />
                                                    <TextBlock
                                                        x:Name="UpdateNotesText"
                                                        MaxWidth="560"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="20"
                                                        Text="{Binding NotesLine}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="UpdateNotesButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="UpdateNotes_Click"
                                                    Content="查看更新"
                                                    FontSize="{StaticResource Fs.Body}"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="查看 Gitee 上最近一次发行版的说明" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  ==================== 下载队列 ====================  -->
                        <Grid
                            x:Name="QueuePanel"
                            Grid.Row="1"
                            Visibility="{Binding QueuePanelVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,6,12">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Height="30"
                                        Padding="12,0"
                                        Click="OpenDownloadDir_Click"
                                        Content="打开下载目录"
                                        FontSize="{StaticResource Fs.Small}"
                                        Style="{StaticResource GhostBtn}" />
                                    <Button
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="ClearFinished_Click"
                                        Content="清理已完成"
                                        FontSize="{StaticResource Fs.Small}"
                                        Style="{StaticResource GhostBtn}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                Padding="0,0,6,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="QueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="14,12"
                                                Background="#FF1B2B40"
                                                BorderBrush="#FF2B4058"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border
                                                                Width="32"
                                                                Height="32"
                                                                Background="#FF25405F"
                                                                BorderBrush="#FF35557A"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="{StaticResource Fs.Caption}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#FF8FC2FF"
                                                                    Text="{Binding ExtText}" />
                                                            </Border>
                                                            <StackPanel
                                                                MaxWidth="420"
                                                                Margin="11,0,0,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="{StaticResource Fs.Body}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#FFDCE7F4"
                                                                    Text="{Binding GameTitle}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,3,0,0"
                                                                    FontSize="{StaticResource Fs.Caption}"
                                                                    Foreground="#FF6C819A"
                                                                    Text="{Binding FileName}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip="{Binding SavePath}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="{StaticResource Fs.Small}"
                                                                Foreground="#FF8FC2FF"
                                                                Text="{Binding StateText}" />
                                                            <Button
                                                                Click="QueueCancel_Click"
                                                                Content="取消"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                Click="QueueRetry_Click"
                                                                Content="重试"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                MinWidth="78"
                                                                Click="QueueOpen_Click"
                                                                Content="打开文件夹"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                Margin="8,0,0,0"
                                                                Click="QueueRemove_Click"
                                                                Content="移除"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <ProgressBar
                                                        Grid.Row="1"
                                                        Height="5"
                                                        Margin="0,12,0,0"
                                                        IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                        Maximum="1"
                                                        Style="{StaticResource ThinProgress}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        Value="{Binding Progress, Mode=OneWay}" />

                                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                                        <TextBlock
                                                            Margin="0,0,70,0"
                                                            FontSize="{StaticResource Fs.Caption}"
                                                            Foreground="#FF7C90A6"
                                                            Text="{Binding DetailText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="{StaticResource Fs.Caption}"
                                                            Foreground="#FF8FC2FF"
                                                            Text="{Binding PercentText}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel
                                x:Name="QueueEmpty"
                                Grid.Row="1"
                                Margin="0,0,0,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="#FF22354B"
                                    CornerRadius="16">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="26"
                                        Foreground="#FF3E5670"
                                        Text="&#xE896;" />
                                </Border>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource Fs.Title}"
                                    FontWeight="SemiBold"
                                    Foreground="#FFD3E0EE"
                                    Text="队列是空的" />
                                <TextBlock
                                    MaxWidth="460"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="{StaticResource B.TextMute}"
                                    LineHeight="19"
                                    Text="在任意游戏详情页点「下载」，文件会直接存到本机，进度实时显示在这里。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                    </Grid>

                </Grid>

                <!--  底部状态栏：左侧状态，右侧分页（上一页 / 下一页，不显示总页数）  -->
                <Border
                    Grid.Row="2"
                    Background="#FF16263A"
                    BorderBrush="#FF2A3F57"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="26,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="StatusDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{StaticResource B.Green}" />
                            <TextBlock
                                x:Name="StatusText"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Small}"
                                Foreground="{StaticResource B.TextDim}"
                                Text="数据已就绪"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!--  ===== 右下角：当前游戏名的语言 + 分页 =====  -->
                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <!--  卡片标题只显示一种语言：默认英文，选了中文才去 game_names 左连取中文名  -->
                            <StackPanel
                                x:Name="TitleLangPanel"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding CardListVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="当前游戏名：" />
                                <ComboBox
                                    x:Name="TitleLangCombo"
                                    SelectedIndex="0"
                                    SelectionChanged="TitleLangCombo_SelectionChanged"
                                    Style="{StaticResource LangCombo}"
                                    ToolTip="卡片标题显示英文还是中文；没有中文名时显示官网英文名">
                                    <ComboBoxItem Content="英文" />
                                    <ComboBoxItem Content="中文" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel
                                x:Name="PagerBar"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding PagerVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                x:Name="PagerLoading"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Small}"
                                Foreground="{StaticResource B.TextDim}"
                                Text="加载中…"
                                Visibility="{Binding PagerLoadingVisible, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="PagerRetry"
                                Height="28"
                                Margin="0,0,12,0"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Click="PagerRetry_Click"
                                Content="重试"
                                FontSize="{StaticResource Fs.Small}"
                                Style="{StaticResource GhostBtn}"
                                Visibility="{Binding PagerRetryVisible, Converter={StaticResource BoolToVis}}" />

                            <TextBlock
                                x:Name="PagerTotalText"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Small}"
                                Foreground="{StaticResource B.TextMute}"
                                Text="{Binding PagerTotal}"
                                Visibility="{Binding PagerTotalVisible, Converter={StaticResource BoolToVis}}" />

                            <Button
                                x:Name="PagerPrev"
                                Width="34"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="PagerPrev_Click"
                                IsEnabled="{Binding PagerPrevEnabled}"
                                Style="{StaticResource PagerButton}"
                                ToolTip="上一页">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE76B;" />
                            </Button>

                            <TextBlock
                                x:Name="PagerPageText"
                                MinWidth="62"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Small}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource B.Text}"
                                Text="{Binding PagerPage}"
                                TextAlignment="Center" />

                            <Button
                                x:Name="PagerNext"
                                Width="34"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="PagerNext_Click"
                                IsEnabled="{Binding PagerNextEnabled}"
                                Style="{StaticResource PagerButton}"
                                ToolTip="下一页">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE76C;" />
                            </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  ==================== 详情弹框层 ====================  -->
            <!--  点遮罩（弹框外面那片半透明区域）就关掉弹框；点在弹框上不算  -->
            <Grid
                x:Name="DetailLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <!--
                    遮罩单独一层：点它才算「点在外面」，点卡片内部不会误关；
                    透明度交给开场/收场动画，跟关于弹窗同一套观感
                -->
                <Rectangle
                    x:Name="DetailBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="DetailLayer_MouseLeftButtonDown"
                    Opacity="0" />

                <ContentControl
                    x:Name="DetailHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <!--  先缩放再位移：大面板从 0.96 轻轻放大，回弹幅度按面积收小  -->
                        <TransformGroup>
                            <ScaleTransform x:Name="DetailScale" ScaleX="0.96" ScaleY="0.96" />
                            <TranslateTransform x:Name="DetailSlide" Y="10" />
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <!--  ==================== 确认框 ====================  -->
            <!--
                遮罩和卡片是并列的两层：点遮罩 = 取消，点卡片正文不会误关
                （之前把事件挂在最外层 Grid 上，点卡片空白处也会冒泡上去当成取消）
            -->
            <Grid
                x:Name="ConfirmLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <!--  整层铺满的半透明遮罩，命中测试全归它；卡片在它上面，点卡片就轮不到这里  -->
                <Rectangle
                    x:Name="ConfirmBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="ConfirmBackdrop_MouseLeftButtonDown" />

                <Border
                    Width="440"
                    Padding="24,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            x:Name="ConfirmTitle"
                            FontSize="{StaticResource Fs.Title}"
                            FontWeight="SemiBold"
                            Foreground="#FFE6EFF8"
                            Text="确认操作？" />
                        <TextBlock
                            x:Name="ConfirmBody"
                            Margin="0,10,0,0"
                            FontSize="{StaticResource Fs.Body}"
                            Foreground="{StaticResource B.TextDim}"
                            LineHeight="22"
                            TextWrapping="Wrap" />

                        <!--  可选项：只在需要「顺手多做一件事」的确认框里显示（默认整块收起）  -->
                        <StackPanel
                            x:Name="ConfirmOptionPanel"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">
                            <Border
                                Padding="12,10"
                                Background="#FF18293D"
                                BorderBrush="{StaticResource B.BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <CheckBox x:Name="ConfirmOptionCheck" Style="{StaticResource CheckRow}">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="ConfirmOptionText"
                                            FontSize="{StaticResource Fs.Body}"
                                            Foreground="{StaticResource B.Text}"
                                            Text="同时做另一件事" />
                                        <TextBlock
                                            x:Name="ConfirmOptionHint"
                                            Margin="0,4,0,0"
                                            FontSize="{StaticResource Fs.Caption}"
                                            Foreground="{StaticResource B.TextMute}"
                                            LineHeight="18"
                                            TextWrapping="Wrap"
                                            Text="" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Height="32"
                                Padding="18,0"
                                Click="ConfirmCancel_Click"
                                Content="取消"
                                FontSize="{StaticResource Fs.Body}"
                                Style="{StaticResource GhostBtn}" />
                            <Button
                                x:Name="ConfirmOkButton"
                                Height="32"
                                Margin="10,0,0,0"
                                Padding="18,0"
                                Click="ConfirmOk_Click"
                                Content="确定"
                                Style="{StaticResource DangerBtn}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>


            <!--  ==================== 关于 / 声明 弹窗 ====================  -->
            <!--  遮罩和卡片是并列两层：点遮罩关闭，点卡片不会误关；动画见 ShowAbout / CloseAbout  -->
            <Grid
                x:Name="AboutLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="AboutBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="AboutBackdrop_MouseLeftButtonDown"
                    Opacity="0" />

                <Border
                    x:Name="AboutCard"
                    Width="760"
                    MaxHeight="726"
                    Padding="26,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AboutScale" ScaleX="0.93" ScaleY="0.93" />
                            <TranslateTransform x:Name="AboutShift" Y="10" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <!--  头部：图标 + 名称 + 版本  -->
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="42"
                                Height="42"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/logo.png"
                                Stretch="Uniform" />
                            <TextBlock
                                Margin="13,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Title}"
                                FontWeight="SemiBold"
                                Foreground="#FFE6EFF8"
                                Text="风灵月影宗 · 外门传功阁告示" />
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,18,0,16"
                            Background="{StaticResource B.BorderSoft}" />

                        <!--
                            声明正文：整段照抄 Assets\免责声明.txt，
                            文本里的换行、空行、缩进原样保留，界面这边只给一套统一的字号行高。
                            
                            这里用只读 TextBox 而不是 TextBlock：TextBlock 选不中，想抄一段条款只能截图。
                            外观全部按 TextBlock 调（透明底、无边框、同字号同颜色同行高），看不出是输入框；
                            滚动条交给它自己，原来外面那层 ScrollViewer 就不需要了。
                        -->
                        <TextBox
                            x:Name="AboutBody"
                            MaxHeight="540"
                            Padding="0,0,4,0"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="Transparent"
                            FocusVisualStyle="{x:Null}"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Body}"
                            Foreground="#FFE8F1FA"
                            HorizontalScrollBarVisibility="Disabled"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="False"
                            SelectionBrush="#807CBBFF"
                            TextBlock.LineHeight="26"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto">
                            <TextBox.ContextMenu>
                                <ContextMenu
                                    Padding="3"
                                    Background="#FF1D3249"
                                    BorderBrush="#FF3A5573"
                                    BorderThickness="1">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
                                            <Setter Property="FontSize" Value="{StaticResource Fs.Small}" />
                                            <Setter Property="Foreground" Value="#FFDCE8F5" />
                                            <Setter Property="Padding" Value="12,5" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border
                                                            x:Name="Row"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="Transparent"
                                                            CornerRadius="5">
                                                            <ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="#FF2A4564" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem
                                        Command="ApplicationCommands.Copy"
                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Header="复制选中" />
                                    <MenuItem
                                        Command="ApplicationCommands.SelectAll"
                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Header="全选" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <!--  底部：宗门圣地直通 + 关闭  -->
                        <Grid Margin="0,20,0,0">
                            <Border
                                Padding="0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="DataSourceLink_Click"
                                ToolTip="在浏览器中打开 https://flingtrainer.com">
                                <!--
                                    图标比中文「高」一截：Segoe MDL2 的字形几乎占满整个 em、
                                    中文只占约 0.86 em，两者放在同一基线上时图标顶边会冒出去，
                                    看上去就是没对齐。所以图标按行盒居中、再按字形高度差往下压一点，
                                    让三者的视觉中心落在同一条水平线上。
                                -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,1.5,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="12.5"
                                        Foreground="{StaticResource B.TextMute}"
                                        Text="&#xE774;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Fs.Small}"
                                        Foreground="{StaticResource B.TextDim}"
                                        Text="前往宗门圣地" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Fs.Caption}"
                                        Foreground="{StaticResource B.TextMute}"
                                        Text="↗" />
                                </Grid>
                            </Border>

                            <Button
                                Height="32"
                                Padding="20,0"
                                HorizontalAlignment="Right"
                                Click="AboutClose_Click"
                                Content="知道了"
                                Style="{StaticResource PrimaryBtn}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ==================== 灵石结缘 · 随喜投喂 弹窗 ====================  -->
            <!--  结构和「关于」弹窗一样：遮罩点一下就关，卡片不会误关；动画见 ShowSupport / CloseSupport  -->
            <Grid
                x:Name="SupportLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="SupportBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="SupportBackdrop_MouseLeftButtonDown"
                    Opacity="0" />

                <Border
                    x:Name="SupportCard"
                    Width="560"
                    Padding="26,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SupportScale" ScaleX="0.93" ScaleY="0.93" />
                            <TranslateTransform x:Name="SupportShift" Y="10" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <!--  头部  -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="16"
                                Foreground="{StaticResource B.AccentLight}"
                                Text="&#xEB52;" />
                            <TextBlock
                                Margin="11,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Title}"
                                FontWeight="SemiBold"
                                Foreground="#FFE6EFF8"
                                Text="打赏赞助" />
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,18,0,16"
                            Background="{StaticResource B.BorderSoft}" />

                        <!--
                            结缘文案 + 两张收款码。
                            图片已经从原图（4M / 3M）压到 170K / 120K（640 宽、质量 85），
                            显示尺寸 220~250，清晰度看不出差别，扫码也没问题。
                        -->
                        <TextBlock
                            FontSize="{StaticResource Fs.Body}"
                            Foreground="#FFE8F1FA"
                            LineHeight="26"
                            Text="散修炼器，本就不易。诸位宗门高足若觉此物还算趁手，可于下方结缘法印处随喜投喂几枚灵石，聊作炼器之资，也为日后铸宝备些材料。"
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <!--
                                两张图各自套一个圆角容器：图片走 Border 的 ImageBrush 背景
                                （圆角才会真的裁掉四角）。
                                尺寸按各自比例给：支付宝 2:3、微信 1312:1792。
                            -->
                            <Grid
                                x:Name="AlipayFrame"
                                Width="220"
                                Height="330">
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <!--
                                            图片源在 EnsureSupportFlow 里用代码挂（带 try/catch）。
                                            XAML 里直接写 pack URI 的话，资源一旦没打进程序集，
                                            整个窗口加载就会抛 XamlParseException —— 启动即崩。
                                        -->
                                        <ImageBrush
                                            x:Name="AlipayBrush"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <Grid
                                x:Name="WxpayFrame"
                                Width="242"
                                Height="330"
                                Margin="16,0,0,0">
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush
                                            x:Name="WxpayBrush"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!--  底部：关闭  -->
                        <Button
                            Height="32"
                            MinWidth="96"
                            Margin="0,20,0,0"
                            Padding="20,0"
                            HorizontalAlignment="Right"
                            Click="SupportClose_Click"
                            Content="知道了"
                            Style="{StaticResource PrimaryBtn}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ==================== 数据更新 · 更新进度（模态） ====================  -->
            <!--
                这是真正意义上的模态框：遮罩故意不挂任何鼠标事件，点它什么也不会发生；
                Esc 在 OnPreviewKeyDown 里也被挡住。想离开只有「取消更新」，
                更新本身跑在后台线程，取消靠 CancellationToken，不会把界面卡住。

                这一块整棵子树的 DataContext 是 SyncViewModel（构造函数里挂的），
                下面所有内容都是单向绑定：代码里只改 Sync.* 的状态，不再直接摸控件。
            -->
            <Grid
                x:Name="SyncLayer"
                Grid.ColumnSpan="2"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                <Rectangle Fill="#CC080D15" />

                <Border
                    Width="560"
                    Padding="26,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="34"
                                Height="34"
                                Background="#FF344F6E"
                                CornerRadius="9">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="18"
                                    Foreground="#FF8FC6FF"
                                    Text="&#xE895;" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="SyncTitle"
                                    FontSize="{StaticResource Fs.Title}"
                                    FontWeight="SemiBold"
                                    Foreground="#FFE6EFF8"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    x:Name="SyncSubtitle"
                                    Margin="0,3,0,0"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="#FF8FA3BA"
                                    Text="{Binding Subtitle}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Margin="0,16,0,0"
                            Padding="14,11"
                            Background="#FF24384F"
                            CornerRadius="9">
                            <TextBlock
                                x:Name="SyncTipText"
                                FontSize="{StaticResource Fs.Small}"
                                Foreground="#FFA9C0D6"
                                LineHeight="20"
                                Text="{Binding Tip}"
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  ① 游戏数据：官网列表 / 本地详情页（只更新游戏名时整段收起）  -->
                        <StackPanel
                            x:Name="SyncDataSection"
                            Visibility="{Binding Data.Visible, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,16,0,0">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="3"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource B.Accent}"
                                        CornerRadius="2" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Fs.Small}"
                                        FontWeight="SemiBold"
                                        Foreground="#FFCFE0F2"
                                        Text="更新游戏数据" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="SyncPercentText"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="#FF8FC2FF"
                                    Text="{Binding Data.Percent}" />
                            </Grid>

                            <ProgressBar
                                x:Name="SyncBar"
                                Height="6"
                                Margin="0,8,0,0"
                                IsIndeterminate="{Binding Data.Indeterminate}"
                                Maximum="1"
                                Minimum="0"
                                Style="{StaticResource ThinProgress}"
                                Value="{Binding Data.Value, Mode=OneWay}" />

                            <TextBlock
                                x:Name="SyncGameText"
                                Margin="0,8,0,0"
                                FontSize="{StaticResource Fs.Body}"
                                Foreground="#FFF0F6FD"
                                Text="{Binding Data.State}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="SyncPhaseText"
                                Margin="0,3,0,0"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="#FF8FA3BA"
                                Text="{Binding Data.Detail}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding Data.DetailVisible, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                x:Name="SyncCountText"
                                Margin="0,3,0,0"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="#FF8FA3BA"
                                Text="{Binding Data.Count}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding Data.Count, Converter={StaticResource TextToVis}}" />

                            <Border
                                x:Name="SyncSectionDivider"
                                Height="1"
                                Margin="0,16,0,0"
                                Background="#FF2C4259" />
                        </StackPanel>

                        <!--  ② 游戏名 + 中文名：名录走官网 All Trainers，中文名走 Steam  -->
                        <Grid Margin="0,15,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Border
                                    Width="3"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource B.Cyan}"
                                    CornerRadius="2" />
                                <TextBlock
                                    x:Name="SyncNameLabel"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    FontWeight="SemiBold"
                                    Foreground="#FFCFE0F2"
                                    Text="{Binding NamesLabel}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SyncNamePercentText"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Small}"
                                Foreground="#FF8FC2FF"
                                Text="{Binding Names.Percent}" />
                        </Grid>

                        <ProgressBar
                            x:Name="SyncNameBar"
                            Height="6"
                            Margin="0,8,0,0"
                            IsIndeterminate="{Binding Names.Indeterminate}"
                            Maximum="1"
                            Minimum="0"
                            Style="{StaticResource ThinProgress}"
                            Value="{Binding Names.Value, Mode=OneWay}" />

                        <TextBlock
                            x:Name="SyncNameStateText"
                            Margin="0,8,0,0"
                            FontSize="{StaticResource Fs.Body}"
                            Foreground="#FFF0F6FD"
                            Text="{Binding Names.State}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="SyncNameDetailText"
                            Margin="0,3,0,0"
                            FontSize="{StaticResource Fs.Caption}"
                            Foreground="#FF8FA3BA"
                            Text="{Binding Names.Detail}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Names.DetailVisible, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            x:Name="SyncNamePairText"
                            Margin="0,3,0,0"
                            FontSize="{StaticResource Fs.Caption}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Names.PairTooltip}"
                            Visibility="{Binding Names.ShowPair, Converter={StaticResource BoolToVis}}">
                            <Run Foreground="#FF8FA3BA" Text="{Binding Names.PairEnglish, Mode=OneWay}" />
                            <Run Foreground="#FF647E99" Text="{Binding Names.PairArrow, Mode=OneWay}" />
                            <Run Text="{Binding Names.ChineseText, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="#FF647E99" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Names.HasChinese}" Value="True">
                                                <Setter Property="Foreground" Value="#FFDCECFB" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <TextBlock
                            x:Name="SyncNameCountText"
                            Margin="0,3,0,0"
                            FontSize="{StaticResource Fs.Caption}"
                            Foreground="#FF8FA3BA"
                            Text="{Binding Names.Count}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Names.Count, Converter={StaticResource TextToVis}}" />

                        <!--
                            ③ Steam 中文名：只有「快速更新游戏名」这一路会单独显示，
                            和上面的游戏名进度各走各的条，勾了同步才出现。
                        -->
                        <StackPanel
                            x:Name="SyncCnSection"
                            Opacity="{Binding Chinese.Opacity}"
                            Visibility="{Binding Chinese.Visible, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,15,0,0">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Width="3"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource B.AccentLight}"
                                        CornerRadius="2" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource Fs.Small}"
                                        FontWeight="SemiBold"
                                        Foreground="#FFCFE0F2"
                                        Text="更新 Steam 中文名" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="SyncCnPercentText"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="#FF8FC2FF"
                                    Text="{Binding Chinese.Percent}" />
                            </Grid>

                            <ProgressBar
                                x:Name="SyncCnBar"
                                Height="6"
                                Margin="0,8,0,0"
                                IsIndeterminate="{Binding Chinese.Indeterminate}"
                                Maximum="1"
                                Minimum="0"
                                Style="{StaticResource ThinProgress}"
                                Value="{Binding Chinese.Value, Mode=OneWay}" />

                            <TextBlock
                                x:Name="SyncCnStateText"
                                Margin="0,8,0,0"
                                FontSize="{StaticResource Fs.Body}"
                                Foreground="#FFF0F6FD"
                                Text="{Binding Chinese.State}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  明细行有两种：普通说明，或者「英文名 >> 中文名」的三色对照，互斥只显示一个  -->
                            <TextBlock
                                x:Name="SyncCnDetailText"
                                Margin="0,3,0,0"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="#FF8FA3BA"
                                Text="{Binding Chinese.Detail}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding Chinese.DetailVisible, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                x:Name="SyncCnPairText"
                                Margin="0,3,0,0"
                                FontSize="{StaticResource Fs.Caption}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Chinese.PairTooltip}"
                                Visibility="{Binding Chinese.ShowPair, Converter={StaticResource BoolToVis}}">
                                <Run Foreground="#FF8FA3BA" Text="{Binding Chinese.PairEnglish, Mode=OneWay}" />
                                <Run Foreground="#FF647E99" Text="{Binding Chinese.PairArrow, Mode=OneWay}" />
                                <Run Text="{Binding Chinese.ChineseText, Mode=OneWay}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="#FF647E99" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Chinese.HasChinese}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFDCECFB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>

                            <TextBlock
                                x:Name="SyncCnCountText"
                                Margin="0,3,0,0"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="#FF8FA3BA"
                                Text="{Binding Chinese.Count}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding Chinese.Count, Converter={StaticResource TextToVis}}" />
                        </StackPanel>

                        <!--  开始前的可选项：勾了才连带查 Steam 中文名（默认不勾，开跑后整块锁住）  -->
                        <StackPanel
                            x:Name="SyncSteamOptionPanel"
                            Margin="0,16,0,0"
                            IsEnabled="{Binding SteamOptionEnabled}"
                            Visibility="{Binding SteamOptionVisible, Converter={StaticResource BoolToVis}}">
                            <Border
                                Padding="12,10"
                                Background="#FF18293D"
                                BorderBrush="{StaticResource B.BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <CheckBox
                                    x:Name="SyncSteamCheck"
                                    IsChecked="{Binding SteamChecked, Mode=TwoWay}"
                                    Style="{StaticResource CheckRow}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="{StaticResource Fs.Body}"
                                            Foreground="{StaticResource B.Text}"
                                            Text="同时更新 Steam 中文名" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="{StaticResource Fs.Caption}"
                                            Foreground="{StaticResource B.TextMute}"
                                            LineHeight="18"
                                            Text="如果同步中文名可能会需要一点时间"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="SyncCancelButton"
                                Height="32"
                                Padding="18,0"
                                Command="{Binding CancelCommand}"
                                Content="{Binding CancelText}"
                                FontSize="{StaticResource Fs.Body}"
                                IsEnabled="{Binding CancelEnabled}"
                                Style="{StaticResource GhostBtn}" />
                            <Button
                                x:Name="SyncStartButton"
                                Height="32"
                                Margin="10,0,0,0"
                                Padding="18,0"
                                Command="{Binding StartCommand}"
                                Content="{Binding StartText}"
                                FontSize="{StaticResource Fs.Body}"
                                IsEnabled="{Binding StartEnabled}"
                                Style="{StaticResource PrimaryBtn}"
                                Visibility="{Binding StartVisible, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ==================== 更新弹窗（发现新版本 / 更新内容） ====================  -->
            <!--
                同一个弹窗两种用法：启动检查或手动检查发现新版本 → 带「立即更新」；
                设置里点「查看更新」→ 只读说明，按钮变成「知道了」。
                结构和「关于」弹窗一致：点遮罩关闭、点卡片不关，动画见 ShowUpdateDialog / CloseUpdateDialog。
            -->
            <Grid
                x:Name="UpdateLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="UpdateBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="UpdateBackdrop_MouseLeftButtonDown"
                    Opacity="0" />

                <Border
                    x:Name="UpdateCard"
                    Width="700"
                    MaxHeight="700"
                    Padding="26,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="UpdateScale" ScaleX="0.93" ScaleY="0.93" />
                            <TranslateTransform x:Name="UpdateShift" Y="10" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>

                    <StackPanel>
                        <!--  头部：Logo + 标题 + 版本变化  -->
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="42"
                                Height="42"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/logo.png"
                                Stretch="Uniform" />
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="UpdateTitleText"
                                    FontSize="{StaticResource Fs.Title}"
                                    FontWeight="SemiBold"
                                    Foreground="#FFE6EFF8"
                                    Text="发现新版本" />
                                <TextBlock
                                    x:Name="UpdateVersionText"
                                    Margin="0,4,0,0"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="#FF8FA3BA"
                                    Text="" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,18,0,14"
                            Background="{StaticResource B.BorderSoft}" />

                        <!--  更新内容正文：只读 TextBox（能拖选 / Ctrl+C），外观按 TextBlock 调  -->
                        <TextBox
                            x:Name="UpdateNotesBox"
                            MaxHeight="392"
                            Padding="0,0,4,0"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="Transparent"
                            FocusVisualStyle="{x:Null}"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Body}"
                            Foreground="#FFE8F1FA"
                            HorizontalScrollBarVisibility="Disabled"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="False"
                            SelectionBrush="#807CBBFF"
                            TextBlock.LineHeight="25"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  底部：左边一句说明，右边两个按钮  -->
                        <Grid Margin="0,20,0,0">
                            <TextBlock
                                x:Name="UpdateHintText"
                                MaxWidth="360"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource Fs.Caption}"
                                Foreground="#FF7E93A9"
                                LineHeight="18"
                                Text="下载完成后会自动覆盖安装，程序会重启一次。"
                                TextWrapping="Wrap" />

                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="UpdateLaterButton"
                                    Height="32"
                                    Padding="18,0"
                                    Click="UpdateLater_Click"
                                    Content="稍后再说"
                                    FontSize="{StaticResource Fs.Body}"
                                    Style="{StaticResource GhostBtn}" />
                                <Button
                                    x:Name="UpdateNowButton"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Padding="20,0"
                                    Click="UpdateNow_Click"
                                    Content="立即更新"
                                    FontSize="{StaticResource Fs.Body}"
                                    Style="{StaticResource PrimaryBtn}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
