<Window x:Class="FlingTrainerX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="单机工具箱 · FLiNG Trainer X"
        Width="1440" Height="880" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource B.BgDeep}"
        FontFamily="{StaticResource F.Ui}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧栏 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource B.BgSide}"
                BorderBrush="#FF16222F" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource B.Logo}">
                            <TextBlock Text="F" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="单机工具箱" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.Text}" />
                            <TextBlock Text="Trainer Library" FontSize="9" Foreground="{StaticResource B.TextMute}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 导航：游戏库 / 收藏夹 / 下载队列 / 设置 -->
                <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavList}"
                         Margin="10,6,10,0" SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource F.Icon}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="游戏库" FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource F.Icon}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NavFavLabel" Text="收藏夹" FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NavQueueLabel" Text="下载队列" FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource F.Icon}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="设置" FontSize="12.5" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 底部信息 -->
                <Border Grid.Row="3" Margin="14,0,14,16" Padding="12,10" CornerRadius="10"
                        Background="#FF0E1723" BorderThickness="1" BorderBrush="#FF16222F">
                    <StackPanel>
                        <TextBlock Text="数据源" FontSize="9.5" Foreground="{StaticResource B.TextMute}" />
                        <TextBlock Text="flingtrainer.com" FontSize="11" Foreground="#FF7FB4FF" Margin="0,2,0,0" />
                        <TextBlock x:Name="SidebarSyncText" Text="—" FontSize="9.5"
                                   Foreground="{StaticResource B.TextMute}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 右侧主体 ==================== -->
        <Grid Grid.Column="1" Background="{StaticResource B.BgMain}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索 -->
                <Border Width="360" Height="38" CornerRadius="10"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0"
                        Background="#FF0C1621" BorderThickness="1" BorderBrush="#FF1B2A3A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   Foreground="{StaticResource B.TextMute}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0"
                                 Style="{StaticResource SearchBox}" TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Margin="8,0,0,0"
                                   Text="搜索游戏、修改器与下载工具" FontSize="12"
                                   Foreground="{StaticResource B.TextMute}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="9.5" Margin="0,0,12,0"
                                   Foreground="#FF40556B" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 窗口按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="RefreshButton" Style="{StaticResource IconBtn}" Click="Refresh_Click"
                            ToolTip="从 flingtrainer.com 同步最新数据">
                        <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="{StaticResource F.Icon}"
                                   FontSize="13" RenderTransformOrigin="0.5,0.5" />
                    </Button>
                    <Border Width="1" Height="16" Background="#FF1B2A3A" Margin="6,0" />
                    <Button Style="{StaticResource IconBtn}" Click="Minimize_Click" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource F.Icon}" FontSize="11" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource IconBtn}" Click="Maximize_Click"
                            ToolTip="最大化">
                        <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="{StaticResource F.Icon}" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CloseBtn}" Click="Close_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icon}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 主体区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="242" />
                </Grid.ColumnDefinitions>

                <!-- 游戏卡片区 -->
                <Grid Grid.Column="0" Margin="26,4,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,6,14">
                        <StackPanel>
                            <TextBlock x:Name="SectionTitle" Text="Steam 单机游戏库"
                                       Style="{StaticResource T.Base}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="SectionSubtitle" Text="—" Style="{StaticResource T.Mute}"
                                       Margin="1,5,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SectionCount" Style="{StaticResource T.Mute}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                    </Grid>

                    <!-- 卡片列表：按行切分（一行 5 张）+ 虚拟化滚动 -->
                    <ListBox x:Name="CardList" Grid.Row="1" Style="{StaticResource CardListBox}"
                             ScrollViewer.ScrollChanged="CardList_ScrollChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CardButton}" Tag="{Binding}"
                                                    Click="Card_Click" ToolTip="{Binding DisplayTitle}">
                                                <Grid>
                                                    <Rectangle RadiusX="12" RadiusY="12">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="{Binding CoverSource, Converter={StaticResource ImgConv}}"
                                                                        Stretch="UniformToFill" />
                                                        </Rectangle.Fill>
                                                    </Rectangle>

                                                    <Rectangle RadiusX="12" RadiusY="12" Fill="{StaticResource B.CardScrim}" />
                                                    <!-- 官网截图当封面时压暗，避免表格文字太抢眼 -->
                                                    <Rectangle RadiusX="12" RadiusY="12" Fill="#A6070D16" IsHitTestVisible="False"
                                                               Visibility="{Binding IsScreenshotCover, Converter={StaticResource BoolToVis}}" />
                                                    <Rectangle RadiusX="12" RadiusY="12" IsHitTestVisible="False"
                                                               Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#E61C3A5E" Offset="0" />
                                                                <GradientStop Color="#E60B1420" Offset="0.58" />
                                                                <GradientStop Color="#E60E2A3C" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>

                                                    <!-- 没有封面时的水印字母 -->
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontFamily="Segoe UI" FontSize="44" FontWeight="Bold"
                                                               Foreground="#22FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Margin="0,0,0,40" IsHitTestVisible="False"
                                                               Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                                    <!-- 收藏夹里才有：取消收藏 -->
                                                    <Button Style="{StaticResource CardFavRemove}" Tag="{Binding}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Margin="8,8,0,0"
                                                            Click="RemoveFavorite_Click"
                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />

                                                    <!-- 更新时间角标 -->
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,8,8,0" CornerRadius="6" Padding="6,3"
                                                            Background="#B3060D16">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource F.Icon}"
                                                                       FontSize="8.5" Foreground="#FF8FC2FF"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding UpdatedShort}" FontSize="9"
                                                                       Foreground="#FFDCE8F6" Margin="4,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 标题区 -->
                                                    <StackPanel VerticalAlignment="Bottom" Margin="13,0,13,13">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="White" TextWrapping="Wrap"
                                                                   MaxHeight="38" LineHeight="18" />
                                                        <TextBlock Text="{Binding SubTitle}" FontSize="9.3"
                                                                   Foreground="#FF9EB2C7" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Style="{StaticResource Pill}" Margin="0,9,0,0"
                                                                Width="86" Height="26" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource F.Icon}"
                                                                           FontSize="8.5" Foreground="#FFBBD9FF"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="查看详情" FontSize="10"
                                                                           Margin="5,0,0,0"
                                                                           Foreground="#FFD8E9FF" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 翻页加载状态 -->
                    <Grid x:Name="CardsFooter" Grid.Row="1" Height="40" Margin="0,4,8,0" VerticalAlignment="Bottom"
                          Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel x:Name="FooterLoading" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                       Foreground="{StaticResource B.AccentLight}" VerticalAlignment="Center" />
                            <TextBlock Text="正在加载下一页…" FontSize="11.5" Margin="8,0,0,0"
                                       Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button x:Name="FooterRetry" Style="{StaticResource GhostBtn}" Height="30"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="加载失败，点击重试" FontSize="11.5" Padding="14,0"
                                Visibility="Collapsed" Click="FooterRetry_Click" />

                        <StackPanel x:Name="FooterEnd" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border Width="34" Height="1" Background="#FF1D2B3C" VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterEndText" Text="已经到底了" FontSize="11" Margin="12,0"
                                       Foreground="{StaticResource B.TextMute}" VerticalAlignment="Center" />
                            <Border Width="34" Height="1" Background="#FF1D2B3C" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 空状态 -->
                    <Grid x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                            <Border Width="56" Height="56" CornerRadius="16" Background="#FF131F2D"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyGlyph" Text="&#xE7FC;" FontFamily="{StaticResource F.Icon}"
                                           FontSize="22" Foreground="#FF3E5670"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="暂无内容" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#FFB9C9DA" HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock x:Name="EmptyDesc" Text="" FontSize="11.5"
                                       Foreground="{StaticResource B.TextMute}" HorizontalAlignment="Center"
                                       Margin="0,7,0,0" TextAlignment="Center" MaxWidth="460"
                                       TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>
                    </Grid>
                <!-- ==================== 下载队列 ==================== -->
                <Grid x:Name="QueuePanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,6,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostBtn}" Height="30" Padding="12,0"
                                    FontSize="11.5" Content="打开下载目录" Click="OpenDownloadDir_Click" />
                            <Button Style="{StaticResource GhostBtn}" Height="30" Padding="12,0" Margin="8,0,0,0"
                                    FontSize="11.5" Content="清理已完成" Click="ClearFinished_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <ItemsControl x:Name="QueueList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF0F1926" CornerRadius="10" Padding="14,12"
                                            Margin="0,0,0,10" BorderThickness="1" BorderBrush="#FF182533">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="32" Height="32" CornerRadius="8" Background="#FF17283C"
                                                            BorderThickness="1" BorderBrush="#FF243B53">
                                                        <TextBlock Text="{Binding ExtText}" FontSize="9"
                                                                   FontWeight="SemiBold" Foreground="#FF8FC2FF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"
                                                                MaxWidth="420">
                                                        <TextBlock Text="{Binding GameTitle}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#FFDCE7F4"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FileName}" FontSize="10.5"
                                                                   Margin="0,3,0,0" Foreground="#FF6C819A"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding SavePath}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               Foreground="#FF8FC2FF" />
                                                    <Button Style="{StaticResource RowActionBtn}" Content="取消"
                                                            Tag="{Binding}" Click="QueueCancel_Click"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource RowActionBtn}" Content="重试"
                                                            Tag="{Binding}" Click="QueueRetry_Click"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource RowActionBtn}" Content="打开文件夹"
                                                            MinWidth="78" Tag="{Binding}" Click="QueueOpen_Click"
                                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource RowActionBtn}" Content="移除"
                                                            Tag="{Binding}" Click="QueueRemove_Click" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <ProgressBar Grid.Row="1" Style="{StaticResource ThinProgress}" Height="5"
                                                         Margin="0,12,0,0" Maximum="1"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                           Foreground="#FF7C90A6" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,70,0" />
                                                <TextBlock Text="{Binding PercentText}" FontSize="10.5"
                                                           HorizontalAlignment="Right" Foreground="#FF8FC2FF" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="QueueEmpty" Grid.Row="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="16" Background="#FF131F2D"
                                HorizontalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="22"
                                       Foreground="#FF3E5670" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="队列是空的" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFB9C9DA" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="在任意游戏详情页点「下载」，文件会直接存到本机，进度实时显示在这里。"
                                   FontSize="11.5" Foreground="{StaticResource B.TextMute}"
                                   HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center"
                                   MaxWidth="460" TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>
                </Grid>

                </Grid>

                <!-- 右侧信息栏 -->
                <Border Grid.Column="1" Margin="0,4,24,16" CornerRadius="12"
                        Background="{StaticResource B.Panel}" BorderThickness="1"
                        BorderBrush="{StaticResource B.BorderSoft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="库概况" FontSize="11" Foreground="{StaticResource B.TextMute}" />

                            <Border Margin="0,10,0,0" CornerRadius="10" Background="#FF0F1926" Padding="13,12"
                                    BorderThickness="1" BorderBrush="#FF182533">
                                <StackPanel>
                                    <Grid Margin="0,0,0,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource F.Icon}"
                                                       FontSize="12" Foreground="{StaticResource B.AccentLight}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="游戏总数" FontSize="11.5" Margin="8,0,0,0"
                                                       Foreground="#FFAEC0D3" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="StatGames" Text="—" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource B.Text}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource F.Icon}"
                                                       FontSize="12" Foreground="{StaticResource B.Cyan}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="修改选项" FontSize="11.5" Margin="8,0,0,0"
                                                       Foreground="#FFAEC0D3" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="StatOptions" Text="—" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource B.Text}" />
                                    </Grid>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource F.Icon}"
                                                       FontSize="12" Foreground="{StaticResource B.Green}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="最近更新" FontSize="11.5" Margin="8,0,0,0"
                                                       Foreground="#FFAEC0D3" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="StatLatest" Text="—" FontSize="12"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource B.Text}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="磁盘" FontSize="11" Foreground="{StaticResource B.TextMute}"
                                       Margin="0,18,0,0" />
                            <Border Margin="0,10,0,0" CornerRadius="10" Background="#FF0F1926" Padding="13,12"
                                    BorderThickness="1" BorderBrush="#FF182533">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="DiskName" Text="—" FontSize="11.5"
                                                   Foreground="#FFAEC0D3" />
                                        <TextBlock x:Name="DiskFree" Text="—" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource B.TextDim}" />
                                    </Grid>
                                    <Border Height="6" CornerRadius="3" Background="#FF1A2734" Margin="0,10,0,0">
                                        <Border x:Name="DiskBar" Height="6" CornerRadius="3" Width="0"
                                                HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF3B82F6" Offset="0" />
                                                    <GradientStop Color="#FF2DD4E8" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="DiskUsed" Text="—" FontSize="9.5"
                                               Foreground="{StaticResource B.TextMute}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="同步" FontSize="11" Foreground="{StaticResource B.TextMute}"
                                       Margin="0,18,0,0" />
                            <Border Margin="0,10,0,0" CornerRadius="10" Background="#FF0F1926" Padding="13,12"
                                    BorderThickness="1" BorderBrush="#FF182533">
                                <StackPanel>
                                    <TextBlock x:Name="SyncStatus" Text="—" FontSize="11"
                                               Foreground="#FFAEC0D3" TextWrapping="Wrap" LineHeight="17" />
                                    <Button Style="{StaticResource GhostBtn}" Height="32" Margin="0,10,0,0"
                                            Content="立即同步" FontSize="11.5" Click="Refresh_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" BorderBrush="#FF16222F" BorderThickness="0,1,0,0">
                <Grid Margin="26,0,22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource B.Green}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="数据已就绪" FontSize="10.5" Margin="7,0,0,0"
                                   Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="离线缓存" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                        <TextBlock Text="·" FontSize="10" Foreground="#FF2E4358" Margin="8,0" />
                        <TextBlock Text="官网同步" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                        <TextBlock Text="·" FontSize="10" Foreground="#FF2E4358" Margin="8,0" />
                        <TextBlock Text="v1.0.0" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 详情弹框层 ==================== -->
        <Grid x:Name="DetailLayer" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#F2080D15">
            <ContentControl x:Name="DetailHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="DetailSlide" Y="10" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
