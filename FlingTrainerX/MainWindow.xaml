<Window
    x:Class="FlingTrainerX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="clr-namespace:FlingTrainerX.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="风灵月影宗储物袋"
    Width="1280"
    Height="780"
    Background="{StaticResource B.BgDeep}"
    FontFamily="{StaticResource F.Ui}"
    Icon="/Assets/logo.png"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--  外框：圆角 + 一圈描边，DWM 负责窗口本身的圆角，Clip 负责别让内容溢出去  -->
    <Border
        x:Name="Shell"
        Background="{StaticResource B.BgDeep}"
        BorderBrush="#FF2F4967"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ==================== 左侧栏 ====================  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource B.BgSide}"
                BorderBrush="#FF2A3F57"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Logo  -->
                    <Grid
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  Logo：直接用应用图标（图片本身是圆形 + 透明角，不需要再裁）  -->
                            <Image
                                Width="30"
                                Height="30"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/logo.png"
                                Stretch="Uniform" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource B.Text}"
                                    Text="风灵月影宗储物袋" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    FontSize="9"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="FLiNG Sect Storage" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  导航：游戏库 / 收藏夹 / 下载队列 / 设置  -->
                    <ListBox
                        x:Name="NavList"
                        Grid.Row="1"
                        Margin="10,6,10,0"
                        SelectionChanged="NavList_SelectionChanged"
                        Style="{StaticResource NavList}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE7FC;" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="游戏库" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE734;" />
                                <TextBlock
                                    x:Name="NavFavLabel"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="收藏夹" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE896;" />
                                <TextBlock
                                    x:Name="NavQueueLabel"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="下载队列" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE713;" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="设置" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!--  底部信息  -->
                    <Border
                        Grid.Row="3"
                        Margin="14,0,14,16"
                        Padding="12,10"
                        Background="#FF192A3C"
                        BorderBrush="#FF2A3F57"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="9.5"
                                Foreground="{StaticResource B.TextMute}"
                                Text="数据源" />
                            <!--  整块可点：点一下用默认浏览器打开官网（图标表示「会在外部打开」）  -->
                            <Border
                                x:Name="DataSourceLink"
                                Margin="0,1,0,0"
                                Padding="0,2"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="DataSourceLink_Click"
                                ToolTip="在浏览器中打开 https://flingtrainer.com">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="TextBlock.Foreground" Value="#FF7FB4FF" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextBlock.Foreground" Value="#FFC6E0FF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" Text="flingtrainer.com" />
                                    <TextBlock
                                        Margin="4,0,0,1"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        Opacity="0.75"
                                        Text="↗" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="SidebarSyncText"
                                Margin="0,4,0,0"
                                FontSize="9.5"
                                Foreground="{StaticResource B.TextMute}"
                                Text="—" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  ==================== 右侧主体 ====================  -->
            <Grid Grid.Column="1" Background="{StaticResource B.BgMain}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <!--  状态栏：48 高，右侧分页按钮才装得下 30 高的方块  -->
                    <RowDefinition Height="48" />
                </Grid.RowDefinitions>

                <!--  顶栏  -->
                <Grid
                    Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  搜索：输入时不动列表，按回车才向官网发请求；聚焦时描边变蓝提示  -->
                    <Border
                        x:Name="SearchShell"
                        Width="360"
                        Height="38"
                        Margin="26,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF162438" />
                                <Setter Property="BorderBrush" Value="#FF2F4967" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Background" Value="#FF1C2D44" />
                                        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  放大镜：外框 16 高，和输入框里的文字同一条中轴  -->
                            <Border
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="12"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="&#xE721;" />
                            </Border>

                            <!--
                                必须用 PreviewKeyDown：单行 TextBox 自己的类处理器会把 ↑↓ 当成
                                「光标移到行首 / 行尾」先吃掉，KeyDown 里根本收不到方向键
                            -->
                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                PreviewKeyDown="SearchBox_PreviewKeyDown"
                                Style="{StaticResource SearchBox}"
                                TextChanged="SearchBox_TextChanged" />
                            <TextBlock
                                x:Name="SearchHint"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource B.TextMute}"
                                IsHitTestVisible="False"
                                Text="输入游戏名 / 中文名，回车搜索" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="9.5"
                                Foreground="#FF40556B"
                                Text="Ctrl+K" />
                        </Grid>
                    </Border>

                    <!--
                        智能提示：输入时从本地 SQLite 的 game_names 里找游戏名（英文名 + Steam 中文名），
                        选中后回填英文名，真正的搜索仍然发给官网。
                        放在 Popup 里，不会被顶栏裁掉，也不会占布局高度。

                        StaysOpen 必须是 True：Popup 自己是一个独立 HWND，StaysOpen=False 时
                        鼠标按在列表上会被当成「点在了外面」，Popup 先关掉、点击也就丢了 ——
                        这正是之前「鼠标点提示项没反应」的原因。关闭改由窗口自己判断（见 OnPreviewMouseDown）。
                    -->
                    <Popup
                        x:Name="SuggestPopup"
                        AllowsTransparency="True"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=SearchShell}"
                        PopupAnimation="Fade"
                        StaysOpen="True">
                        <Border
                            Width="360"
                            Margin="0,6,0,0"
                            Padding="6"
                            Background="#FF1C2D44"
                            BorderBrush="#FF3A5573"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="0.45"
                                    ShadowDepth="6"
                                    Color="#FF000000" />
                            </Border.Effect>
                            <ListBox
                                x:Name="SuggestList"
                                MaxHeight="304"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource SuggestItem}"
                                PreviewMouseLeftButtonDown="SuggestList_PreviewMouseLeftButtonDown"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                Foreground="#FFF2F7FC"
                                                Text="{Binding CleanEn}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MaxWidth="150"
                                                Margin="12,0,4,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource B.AccentLight}"
                                                Text="{Binding NameCn}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!--  窗口按钮  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--
                            Steam 中文名后台同步的小胶囊：只有同步跑起来时才出现在刷新按钮左边，
                            跑完自己收起来；平时想手动开一轮，用「设置 → 数据更新」里的「同步中文名」。
                        -->
                        <Button
                            x:Name="NamePill"
                            Height="26"
                            Margin="0,0,10,0"
                            Padding="9,0,11,0"
                            VerticalAlignment="Center"
                            Click="NamePill_Click"
                            Cursor="Hand"
                            ToolTip="Steam 中文名后台同步 · 点开看进度"
                            Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="PillBody"
                                        Background="#FF1B2E44"
                                        BorderBrush="#FF2E4763"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBody" Property="Background" Value="#FF27476A" />
                                            <Setter TargetName="PillBody" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse
                                    x:Name="NamePillDot"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource B.TextMute}" />
                                <TextBlock
                                    x:Name="NamePillText"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="#FFCFE0F2"
                                    Text="同步中 0%" />
                                <TextBlock
                                    x:Name="NamePillSub"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RefreshButton"
                            Click="Refresh_Click"
                            Style="{StaticResource IconBtn}"
                            ToolTip="重新读取本地数据（同步请到设置 → 数据更新）">
                            <TextBlock
                                x:Name="RefreshGlyph"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="13"
                                RenderTransformOrigin="0.5,0.5"
                                Text="&#xE72C;" />
                        </Button>
                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0"
                            Background="#FF2F4967" />
                        <Button
                            Click="Minimize_Click"
                            Style="{StaticResource IconBtn}"
                            ToolTip="最小化到托盘">
                            <TextBlock
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="11"
                                Text="&#xE921;" />
                        </Button>
                        <Button
                            Click="Close_Click"
                            Style="{StaticResource CloseBtn}"
                            ToolTip="关闭">
                            <TextBlock
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="10"
                                Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  主体区  -->
                <Grid x:Name="MainArea" Grid.Row="1">

                    <!--  游戏卡片区：固定版心（最大 1020），再宽的屏幕整块居中  -->
                    <Grid
                        x:Name="CardArea"
                        Margin="26,4,26,0"
                        HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,6,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SectionTitle"
                                    VerticalAlignment="Center"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource T.Base}"
                                    Text="Steam 单机游戏库" />
                                <StackPanel
                                    x:Name="LibraryTabs"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="RecentTabButton"
                                        Click="LibraryTab_Click"
                                        Content="最近更新"
                                        IsEnabled="False"
                                        Style="{StaticResource LibraryTabButton}"
                                        Tag="Recent" />
                                    <Button
                                        x:Name="PopularTabButton"
                                        Margin="6,0,0,0"
                                        Click="LibraryTab_Click"
                                        Content="热门游戏"
                                        Style="{StaticResource LibraryTabButton}"
                                        Tag="Popular" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="SectionSubtitle"
                                Margin="1,5,0,0"
                                Style="{StaticResource T.Mute}"
                                Text="—" />
                        </StackPanel>

                        <!--  卡片列表：一行 5 张 × 3 行 = 每页 15 条，默认正好铺满一屏；放不下时才出滚动条  -->
                        <ListBox
                            x:Name="CardList"
                            Grid.Row="1"
                            Style="{StaticResource CardListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ctrl:CardRowPanel
                                                    Columns="5"
                                                    Gap="12"
                                                    MaxChildWidth="{DynamicResource CardW}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Click="Card_Click"
                                                    MouseEnter="Card_MouseEnter"
                                                    MouseLeave="Card_MouseLeave"
                                                    Style="{StaticResource CardButton}"
                                                    Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="{DynamicResource CardInfoH}" />
                                                        </Grid.RowDefinitions>

                                                        <!--  ===== 封面区：16:9，等比完整显示，不裁剪也不变形；只有上面两角是圆的，下面和标题区连成一片  =====  -->
                                                        <Grid Grid.Row="0">
                                                            <Border Background="#FF1B2B40" CornerRadius="12,12,0,0" />

                                                            <!--  封面图下面的水印字母：没有封面、图还没下完或下载失败时都能看到，不会留一块空白色块  -->
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe UI"
                                                                FontSize="40"
                                                                FontWeight="Bold"
                                                                Foreground="#22FFFFFF"
                                                                IsHitTestVisible="False"
                                                                Text="{Binding Initials}" />

                                                            <!--  封面图用 Border 背景绘制：圆角会一起裁掉，鼠标悬停放大时不会溢出卡片  -->
                                                            <Border x:Name="CoverArt" CornerRadius="12,12,0,0">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverSource, Converter={StaticResource ImgConv}}" Stretch="Uniform">
                                                                        <ImageBrush.RelativeTransform>
                                                                            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                                                        </ImageBrush.RelativeTransform>
                                                                    </ImageBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <Border Background="{StaticResource B.CardScrim}" CornerRadius="12,12,0,0" />

                                                            <!--  收藏夹里才有：取消收藏  -->
                                                            <Button
                                                                Margin="8,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Click="RemoveFavorite_Click"
                                                                Style="{StaticResource CardFavRemove}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>

                                                        <!--  ===== 文字区：标题 + 两个小标签（更新时间 / 选项数），整卡可点打开详情  =====  -->
                                                        <Grid Grid.Row="1" Margin="13,8,13,9">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!--
                                                                标题最多两行（LineHeight 19 × 2 = 38），第三行整行裁掉；
                                                                不能加 TextTrimming：它和 TextWrapping 一起用时会被压成单行省略。
                                                                也不挂 ToolTip：卡片上已经有名字，鼠标划过再弹一层纯属打扰。
                                                            -->
                                                            <TextBlock
                                                                MaxHeight="38"
                                                                VerticalAlignment="Top"
                                                                FontSize="13.5"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                LineHeight="19"
                                                                Text="{Binding DisplayTitle}"
                                                                TextWrapping="Wrap" />

                                                            <!--
                                                                更新时间 / 选项数两个标签：
                                                                和详情页封面横幅上那几个 Chip 同一套效果——
                                                                半透明深蓝底 + 细描边 + 小圆角，文字纯白。
                                                                统一贴底，标题一行 / 两行时都在同一条水平线上
                                                            -->
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Margin="0,5,0,0"
                                                                Orientation="Horizontal">
                                                                <Border
                                                                    Padding="7,3"
                                                                    Background="#CC12243A"
                                                                    BorderBrush="#FF2C425C"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    ToolTip="{Binding UpdatedTip}">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="White"
                                                                        Text="{Binding UpdatedShort}" />
                                                                </Border>

                                                                <Border
                                                                    Margin="5,0,0,0"
                                                                    Padding="7,3"
                                                                    Background="#CC12243A"
                                                                    BorderBrush="#FF2C425C"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    ToolTip="这款游戏可用的修改项数"
                                                                    Visibility="{Binding OptionCountTag, Converter={StaticResource TextToVis}}">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="White"
                                                                        Text="{Binding OptionCountTag}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  空状态  -->
                        <Grid
                            x:Name="EmptyState"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <StackPanel
                                Margin="0,0,0,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="#FF22354B"
                                    CornerRadius="16">
                                    <TextBlock
                                        x:Name="EmptyGlyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="22"
                                        Foreground="#FF3E5670"
                                        Text="&#xE7FC;" />
                                </Border>
                                <TextBlock
                                    x:Name="EmptyTitle"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#FFD3E0EE"
                                    Text="暂无内容" />
                                <TextBlock
                                    x:Name="EmptyDesc"
                                    MaxWidth="460"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource B.TextMute}"
                                    LineHeight="19"
                                    Text=""
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <!--
                                    本地一条数据都没有时唯一该做的事：这里直接给一个同步入口，
                                    不用再让用户自己找「设置 → 数据更新」。
                                -->
                                <Button
                                    x:Name="EmptySyncButton"
                                    Height="36"
                                    Margin="0,18,0,0"
                                    Padding="20,0"
                                    HorizontalAlignment="Center"
                                    Click="EmptySync_Click"
                                    Content="同步数据"
                                    FontSize="12"
                                    Style="{StaticResource PrimaryBtn}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <!--  ==================== 设置 ====================  -->
                        <Grid
                            x:Name="SettingsPanel"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <!--
                                窗口固定 1280 宽，设置页统一按 760 的版心排版：
                                不写死宽度的话，这一页的宽度会被内容反推，卡片一窄按钮就顶出去
                            -->
                            <ScrollViewer
                                Margin="0,0,6,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="760" HorizontalAlignment="Left">
                                    <!--
                                        版式参考系统「设置」页：分组标题放在卡片外面（小号灰字），
                                        标题 + 副标题在左、操作按钮在右，一行一件事，行间用极淡的线分隔。
                                    -->
                                    <TextBlock
                                        Margin="6,2,0,9"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="#FF7E93A9"
                                        Text="数据更新" />

                                    <!--  首页只读本地 SQLite，所以「拿新数据」全部集中到这一组  -->
                                    <!--
                                        设置卡片：底色要比页面底（#FF0E1825）明显亮一档、边框也要看得见，
                                        否则在 1080p / 100% 缩放的屏幕上整张卡几乎糊在背景里
                                    -->
                                    <Border
                                        Padding="20,4"
                                        Background="#FF2B4058"
                                        BorderBrush="#FF466280"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <!--  同步全部数据：按官网分页从头翻到尾  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="同步全部数据" />
                                                    <TextBlock
                                                        MaxWidth="470"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="10.5"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="16"
                                                        Text="从官网第一页翻到最后一页，官网没改动的会自动跳过；首次同步耗时较长。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="SyncAllButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="SyncAll_Click"
                                                    Content="开始同步"
                                                    FontSize="11.5"
                                                    Style="{StaticResource PrimaryBtn}"
                                                    ToolTip="一页一页翻到最后一页，官网没改动的会自动跳过" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <!--  同步已有数据：按本地库逐款重抓详情页  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="同步已有数据" />
                                                    <TextBlock
                                                        MaxWidth="470"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="10.5"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="16"
                                                        Text="按本地库已有的游戏逐个重抓详情页，补全下载表与介绍图。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="SyncExistingButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="SyncExisting_Click"
                                                    Content="开始同步"
                                                    FontSize="11.5"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="按本地库一款一款重抓详情页（下载表 / 介绍图），用于补全已有数据" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <!--  同步中文名：名单走官网 A-Z，名字走 Steam（原来的左下角入口搬过来了）  -->
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="同步中文名" />
                                                    <TextBlock
                                                        x:Name="NameSyncSettingDesc"
                                                        MaxWidth="470"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="10.5"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="16"
                                                        Text="从 Steam 逐个换取游戏中文名，换过的会自动跳过。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="NameSyncButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="NameSyncSetting_Click"
                                                    Content="开始同步"
                                                    FontSize="11.5"
                                                    Style="{StaticResource GhostBtn}"
                                                    ToolTip="打开同步面板并开始换取中文名，已换到的不会重复请求" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  ======== 通用：清缓存 + 免责声明 ========  -->
                                    <TextBlock
                                        Margin="6,22,0,9"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="#FF7E93A9"
                                        Text="通用" />

                                    <Border
                                        Padding="20,4"
                                        Background="#FF2B4058"
                                        BorderBrush="#FF466280"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="清除缓存" />
                                                    <TextBlock
                                                        MaxWidth="470"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="10.5"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="16"
                                                        Text="删除本地缓存的卡片数据、图片和已下载文件；收藏不受影响。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    x:Name="ClearCacheButton"
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="ClearCache_Click"
                                                    Content="清除缓存"
                                                    FontSize="11.5"
                                                    Style="{StaticResource GhostBtn}" />
                                            </Grid>

                                            <Border Height="1" Background="#FF3A5570" />

                                            <Grid Margin="0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFF0F6FD"
                                                        Text="免责声明" />
                                                    <TextBlock
                                                        MaxWidth="470"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        FontSize="10.5"
                                                        Foreground="#FF8FA3BA"
                                                        LineHeight="16"
                                                        Text="软件性质与使用须知，使用前请务必阅读。"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="1"
                                                    Height="34"
                                                    Margin="24,0,0,0"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Click="About_Click"
                                                    Content="查看声明"
                                                    FontSize="11.5"
                                                    Style="{StaticResource GhostBtn}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  ==================== 下载队列 ====================  -->
                        <Grid
                            x:Name="QueuePanel"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,6,12">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Height="30"
                                        Padding="12,0"
                                        Click="OpenDownloadDir_Click"
                                        Content="打开下载目录"
                                        FontSize="11.5"
                                        Style="{StaticResource GhostBtn}" />
                                    <Button
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="ClearFinished_Click"
                                        Content="清理已完成"
                                        FontSize="11.5"
                                        Style="{StaticResource GhostBtn}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                Padding="0,0,6,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="QueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="14,12"
                                                Background="#FF1B2B40"
                                                BorderBrush="#FF2B4058"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border
                                                                Width="32"
                                                                Height="32"
                                                                Background="#FF25405F"
                                                                BorderBrush="#FF35557A"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="9"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#FF8FC2FF"
                                                                    Text="{Binding ExtText}" />
                                                            </Border>
                                                            <StackPanel
                                                                MaxWidth="420"
                                                                Margin="11,0,0,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#FFDCE7F4"
                                                                    Text="{Binding GameTitle}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,3,0,0"
                                                                    FontSize="10.5"
                                                                    Foreground="#FF6C819A"
                                                                    Text="{Binding FileName}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip="{Binding SavePath}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="10.5"
                                                                Foreground="#FF8FC2FF"
                                                                Text="{Binding StateText}" />
                                                            <Button
                                                                Click="QueueCancel_Click"
                                                                Content="取消"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                Click="QueueRetry_Click"
                                                                Content="重试"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                MinWidth="78"
                                                                Click="QueueOpen_Click"
                                                                Content="打开文件夹"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                Margin="8,0,0,0"
                                                                Click="QueueRemove_Click"
                                                                Content="移除"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <ProgressBar
                                                        Grid.Row="1"
                                                        Height="5"
                                                        Margin="0,12,0,0"
                                                        IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                        Maximum="1"
                                                        Style="{StaticResource ThinProgress}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        Value="{Binding Progress, Mode=OneWay}" />

                                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                                        <TextBlock
                                                            Margin="0,0,70,0"
                                                            FontSize="10.5"
                                                            Foreground="#FF7C90A6"
                                                            Text="{Binding DetailText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="10.5"
                                                            Foreground="#FF8FC2FF"
                                                            Text="{Binding PercentText}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel
                                x:Name="QueueEmpty"
                                Grid.Row="1"
                                Margin="0,0,0,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="#FF22354B"
                                    CornerRadius="16">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="22"
                                        Foreground="#FF3E5670"
                                        Text="&#xE896;" />
                                </Border>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#FFD3E0EE"
                                    Text="队列是空的" />
                                <TextBlock
                                    MaxWidth="460"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource B.TextMute}"
                                    LineHeight="19"
                                    Text="在任意游戏详情页点「下载」，文件会直接存到本机，进度实时显示在这里。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                    </Grid>

                </Grid>

                <!--  底部状态栏：左侧状态，右侧分页（上一页 / 下一页，不显示总页数）  -->
                <Border
                    Grid.Row="2"
                    Background="#FF16263A"
                    BorderBrush="#FF2A3F57"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="26,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="StatusDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{StaticResource B.Green}" />
                            <TextBlock
                                x:Name="StatusText"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource B.TextDim}"
                                Text="数据已就绪"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!--  ===== 分页：状态栏最右侧，只有上一页 / 下一页 =====  -->
                        <StackPanel
                            x:Name="PagerBar"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PagerLoading"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource B.TextDim}"
                                Text="加载中…"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="PagerRetry"
                                Height="28"
                                Margin="0,0,12,0"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Click="PagerRetry_Click"
                                Content="重试"
                                FontSize="11.5"
                                Style="{StaticResource GhostBtn}"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="PagerTotalText"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource B.TextMute}"
                                Text="" />

                            <Button
                                x:Name="PagerPrev"
                                Width="34"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="PagerPrev_Click"
                                Style="{StaticResource PagerButton}"
                                ToolTip="上一页">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="12"
                                    Text="&#xE76B;" />
                            </Button>

                            <TextBlock
                                x:Name="PagerPageText"
                                MinWidth="62"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource B.Text}"
                                Text="第 1 页"
                                TextAlignment="Center" />

                            <Button
                                x:Name="PagerNext"
                                Width="34"
                                Height="30"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="PagerNext_Click"
                                Style="{StaticResource PagerButton}"
                                ToolTip="下一页">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="12"
                                    Text="&#xE76C;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  ==================== 详情弹框层 ====================  -->
            <!--  点遮罩（弹框外面那片半透明区域）就关掉弹框；点在弹框上不算  -->
            <Grid
                x:Name="DetailLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <!--
                    遮罩单独一层：点它才算「点在外面」，点卡片内部不会误关；
                    透明度交给开场/收场动画，跟关于弹窗同一套观感
                -->
                <Rectangle
                    x:Name="DetailBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="DetailLayer_MouseLeftButtonDown"
                    Opacity="0" />

                <ContentControl
                    x:Name="DetailHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <!--  先缩放再位移：大面板从 0.96 轻轻放大，回弹幅度按面积收小  -->
                        <TransformGroup>
                            <ScaleTransform x:Name="DetailScale" ScaleX="0.96" ScaleY="0.96" />
                            <TranslateTransform x:Name="DetailSlide" Y="10" />
                        </TransformGroup>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <!--  ==================== 确认框 ====================  -->
            <!--
                遮罩和卡片是并列的两层：点遮罩 = 取消，点卡片正文不会误关
                （之前把事件挂在最外层 Grid 上，点卡片空白处也会冒泡上去当成取消）
            -->
            <Grid
                x:Name="ConfirmLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <!--  整层铺满的半透明遮罩，命中测试全归它；卡片在它上面，点卡片就轮不到这里  -->
                <Rectangle
                    x:Name="ConfirmBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="ConfirmBackdrop_MouseLeftButtonDown" />

                <Border
                    Width="440"
                    Padding="24,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            x:Name="ConfirmTitle"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FFE6EFF8"
                            Text="确认操作？" />
                        <TextBlock
                            x:Name="ConfirmBody"
                            Margin="0,10,0,0"
                            FontSize="12"
                            Foreground="{StaticResource B.TextDim}"
                            LineHeight="20"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Height="32"
                                Padding="18,0"
                                Click="ConfirmCancel_Click"
                                Content="取消"
                                FontSize="12"
                                Style="{StaticResource GhostBtn}" />
                            <Button
                                x:Name="ConfirmOkButton"
                                Height="32"
                                Margin="10,0,0,0"
                                Padding="18,0"
                                Click="ConfirmOk_Click"
                                Content="确定"
                                Style="{StaticResource DangerBtn}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>


            <!--  ==================== 关于 / 声明 弹窗 ====================  -->
            <!--  遮罩和卡片是并列两层：点遮罩关闭，点卡片不会误关；动画见 ShowAbout / CloseAbout  -->
            <Grid
                x:Name="AboutLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="AboutBackdrop"
                    Fill="#66080D15"
                    MouseLeftButtonDown="AboutBackdrop_MouseLeftButtonDown"
                    Opacity="0" />

                <Border
                    x:Name="AboutCard"
                    Width="540"
                    MaxHeight="620"
                    Padding="26,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AboutScale" ScaleX="0.93" ScaleY="0.93" />
                            <TranslateTransform x:Name="AboutShift" Y="10" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <!--  头部：图标 + 名称 + 版本  -->
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="42"
                                Height="42"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/logo.png"
                                Stretch="Uniform" />
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#FFE6EFF8"
                                        Text="风灵月影宗储物袋" />
                                    <Border
                                        Margin="9,1,0,0"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="#FF344F6E"
                                        CornerRadius="6">
                                        <TextBlock
                                            x:Name="VersionBadge"
                                            FontSize="9.5"
                                            Foreground="#FF8FC6FF"
                                            Text="v1.0.0" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="FLiNG Sect Storage · 把修改器整理成一个本地游戏库" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,18,0,16"
                            Background="{StaticResource B.BorderSoft}" />

                        <!--  声明正文：内容较长，卡片不够高时自己滚  -->
                        <ScrollViewer
                            MaxHeight="392"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,2,0">
                                <!--  告示标题  -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe UI Emoji"
                                        FontSize="14"
                                        Foreground="{StaticResource B.AccentLight}"
                                        Text="&#x1F4DC;" />
                                    <TextBlock
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#FFDCE8F6"
                                        Text="【风灵月影宗·外门传功阁告示】" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource B.TextDim}"
                                    Text="各位道友、同门请注意：" />

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontSize="11.5"
                                    Foreground="#FF9FB3C8"
                                    LineHeight="19"
                                    TextWrapping="Wrap"><Run FontWeight="SemiBold" Foreground="#FF6FB1FF" Text="【散修所创，非本宗正统】" /><Run Text=" 此宝乃外门散修自行炼制的辅助法器，与“风灵月影宗”本宗（flingtrainer.com）并无直接隶属与血脉渊源。宝内言论，绝不代表本宗长老会的立场。" /></TextBlock>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontSize="11.5"
                                    Foreground="#FF9FB3C8"
                                    LineHeight="19"
                                    TextWrapping="Wrap"><Run FontWeight="SemiBold" Foreground="#FF6FB1FF" Text="【敬重先辈，不破根基】" /><Run Text=" 阁内所藏一切秘籍功法（Trainer），其著作者皆归创法前辈所有。本阁向来遵守道义，绝不篡改秘籍、不强行破解、也不逆向推演各位道友的洞天福地（游戏本体），更不会私自兜售洞天。" /></TextBlock>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontSize="11.5"
                                    Foreground="#FF9FB3C8"
                                    LineHeight="19"
                                    TextWrapping="Wrap"><Run FontWeight="SemiBold" Foreground="#FF6FB1FF" Text="【传送直通，不设镜像】" /><Run Text=" 宝内的功法目录、详情与传送阵（下载链接），皆由本宗官网实时接引。本阁只做引路人，绝不私自拓印、转存或二次分发任何第三方玉简（文件）。" /></TextBlock>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontSize="11.5"
                                    Foreground="#FF9FB3C8"
                                    LineHeight="19"
                                    TextWrapping="Wrap"><Run FontWeight="SemiBold" Foreground="#FF6FB1FF" Text="【闭关自用，因果自负】" /><Run Text=" 此类功法仅限各位道友在单人洞府或离线秘境中参悟娱乐，以证大道。切勿将其带入联机演武场扰乱同门，更不可用于坊市谋利（商业用途）。若因强行运功导致走火入魔，此等因果需由道友自行承担。" /></TextBlock>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontSize="11.5"
                                    Foreground="#FF9FB3C8"
                                    LineHeight="19"
                                    TextWrapping="Wrap"><Run FontWeight="SemiBold" Foreground="#FF6FB1FF" Text="【产权争议，寻本宗处理】" /><Run Text=" 若发现官网所载功法有侵犯他人道统之嫌，请直接飞剑传书（联系）至 flingtrainer.com 处理。本阁仅仅是一枚浏览与引路的辅助罗盘，不沾因果。" /></TextBlock>

                                <TextBlock
                                    Margin="0,14,0,2"
                                    HorizontalAlignment="Center"
                                    FontSize="11.5"
                                    FontStyle="Italic"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="—— 愿诸位道友修为精进，适度修改，切莫贪杯。" />
                            </StackPanel>
                        </ScrollViewer>

                        <!--  底部：官网链接 + 关闭  -->
                        <Grid Margin="0,20,0,0">
                            <Border
                                Padding="0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseLeftButtonUp="DataSourceLink_Click"
                                ToolTip="在浏览器中打开 https://flingtrainer.com">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="11"
                                        Foreground="{StaticResource B.TextMute}"
                                        Text="&#xE774;" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource B.TextDim}"
                                        Text="flingtrainer.com" />
                                    <TextBlock
                                        Margin="3,0,0,1"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource B.TextMute}"
                                        Text="↗" />
                                </StackPanel>
                            </Border>

                            <Button
                                Height="32"
                                Padding="20,0"
                                HorizontalAlignment="Right"
                                Click="AboutClose_Click"
                                Content="知道了"
                                Style="{StaticResource PrimaryBtn}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ==================== 中文名同步 · 进度面板 ====================  -->
            <!--
                同步已经改成后台跑，这层只是「看进度的地方」，不是模态框：
                点遮罩、右上角 ×、Esc 都能收起，同步继续跑；真要让同步停下只有「取消同步」。
            -->
            <Grid
                x:Name="NameSyncLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <Rectangle
                    x:Name="NameSyncBackdrop"
                    Fill="#A6080D15"
                    MouseLeftButtonDown="NameSyncBackdrop_MouseLeftButtonDown"
                    Opacity="0" />

                <Border
                    x:Name="NameSyncCard"
                    Width="486"
                    Padding="26,20,22,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="16"
                                    Foreground="{StaticResource B.AccentLight}"
                                    Text="&#xE895;" />
                                <TextBlock
                                    x:Name="NameSyncTitle"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14.5"
                                    FontWeight="SemiBold"
                                    Foreground="#FFF2F7FC"
                                    Text="Steam 中文名同步" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="NameSyncClose_Click"
                                Style="{StaticResource IconBtn}"
                                ToolTip="收起来（同步继续在后台跑）">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="10"
                                    Text="&#xE711;" />
                            </Button>
                        </Grid>

                        <TextBlock
                            x:Name="NameSyncPhase"
                            Margin="0,14,0,0"
                            FontSize="12.5"
                            Foreground="{StaticResource B.TextDim}"
                            Text="尚未同步"
                            TextWrapping="Wrap" />

                        <ProgressBar
                            x:Name="NameSyncBar"
                            Height="6"
                            Margin="0,12,0,0"
                            IsIndeterminate="True"
                            Maximum="100"
                            Style="{StaticResource ThinProgress}"
                            Value="0" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock
                                x:Name="NameSyncDetail"
                                Margin="0,0,90,0"
                                FontSize="11"
                                Foreground="{StaticResource B.TextMute}"
                                Text=""
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="NameSyncCount"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="{StaticResource B.TextMute}"
                                Text="" />
                        </Grid>

                        <TextBlock
                            x:Name="NameSyncHint"
                            Margin="0,14,0,0"
                            FontSize="10.5"
                            Foreground="{StaticResource B.TextMute}"
                            LineHeight="16"
                            Text="同步在后台慢慢跑，收起这个面板也不影响，可以继续浏览游戏库。"
                            TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0">
                            <Button
                                x:Name="NameSyncRebuild"
                                Height="32"
                                Padding="14,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="NameSyncRebuild_Click"
                                Content="重新抓取完整名单"
                                FontSize="11.5"
                                Style="{StaticResource GhostBtn}"
                                ToolTip="清空游戏名表，重新抓全量，再换一遍中文名" />

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    x:Name="NameSyncCancel"
                                    Height="32"
                                    Padding="16,0"
                                    VerticalAlignment="Center"
                                    Click="NameSyncCancel_Click"
                                    Content="取消同步"
                                    FontSize="12"
                                    Style="{StaticResource GhostBtn}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="NameSyncStart"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Padding="18,0"
                                    VerticalAlignment="Center"
                                    Click="NameSyncStart_Click"
                                    Content="开始同步"
                                    FontSize="12"
                                    Style="{StaticResource PrimaryBtn}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ==================== 数据更新 · 同步进度（模态） ====================  -->
            <!--
                这是真正意义上的模态框：遮罩故意不挂任何鼠标事件，点它什么也不会发生；
                Esc 在 OnPreviewKeyDown 里也被挡住。想离开只有「取消同步」，
                同步本身跑在后台线程，取消靠 CancellationToken，不会把界面卡住。
            -->
            <Grid
                x:Name="SyncLayer"
                Grid.ColumnSpan="2"
                Visibility="Collapsed">
                <Rectangle Fill="#CC080D15" />

                <Border
                    Width="486"
                    Padding="24,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF1D3249"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="34"
                                Height="34"
                                Background="#FF344F6E"
                                CornerRadius="9">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="15"
                                    Foreground="#FF8FC6FF"
                                    Text="&#xE895;" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="SyncTitle"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#FFE6EFF8"
                                    Text="同步全部数据" />
                                <TextBlock
                                    x:Name="SyncSubtitle"
                                    Margin="0,3,0,0"
                                    FontSize="10.5"
                                    Foreground="#FF8FA3BA"
                                    Text="正在从官网读取数据" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Margin="0,18,0,0"
                            Padding="14,12"
                            Background="#FF24384F"
                            CornerRadius="9">
                            <TextBlock
                                FontSize="11"
                                Foreground="#FFA9C0D6"
                                LineHeight="18"
                                TextWrapping="Wrap"><Run Text="同步快慢完全取决于你的网络，有时快有时慢，不要着急哦。" /><LineBreak /><Run Text="如果实在过慢，可以开启 VPN 加速后再重新同步。" /></TextBlock>
                        </Border>

                        <TextBlock
                            x:Name="SyncGameText"
                            Margin="0,16,0,0"
                            FontSize="12.5"
                            Foreground="#FFF0F6FD"
                            Text="正在准备…"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="SyncPhaseText"
                            Margin="0,4,0,0"
                            FontSize="10.5"
                            Foreground="#FF8FA3BA"
                            Text=""
                            TextTrimming="CharacterEllipsis" />

                        <ProgressBar
                            x:Name="SyncBar"
                            Height="6"
                            Margin="0,12,0,0"
                            IsIndeterminate="True"
                            Maximum="1"
                            Minimum="0"
                            Style="{StaticResource ThinProgress}"
                            Value="0" />

                        <Grid Margin="0,10,0,0">
                            <TextBlock
                                x:Name="SyncCountText"
                                FontSize="10.5"
                                Foreground="#FF8FA3BA"
                                Text="" />
                            <TextBlock
                                x:Name="SyncPercentText"
                                HorizontalAlignment="Right"
                                FontSize="10.5"
                                Foreground="#FF8FC2FF"
                                Text="" />
                        </Grid>

                        <Button
                            x:Name="SyncCancelButton"
                            Height="32"
                            Margin="0,18,0,0"
                            Padding="18,0"
                            HorizontalAlignment="Right"
                            Click="SyncCancel_Click"
                            Content="取消同步"
                            FontSize="12"
                            Style="{StaticResource GhostBtn}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
