<Window
    x:Class="FlingTrainerX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="风灵月影宗储物袋"
    Icon="/Assets/logo.png"
    Width="1440"
    Height="880"
    Background="{StaticResource B.BgDeep}"
    FontFamily="{StaticResource F.Ui}"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--  外框：圆角 + 一圈描边，DWM 负责窗口本身的圆角，Clip 负责别让内容溢出去  -->
    <Border
        x:Name="Shell"
        Background="{StaticResource B.BgDeep}"
        BorderBrush="#FF1B2A3A"
        BorderThickness="1"
        CornerRadius="12">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ==================== 左侧栏 ====================  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource B.BgSide}"
                BorderBrush="#FF16222F"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Logo  -->
                    <Grid
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  Logo：直接用应用图标（图片本身是圆形 + 透明角，不需要再裁）  -->
                            <Image
                                Width="30"
                                Height="30"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Assets/logo.png"
                                Stretch="Uniform" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource B.Text}"
                                    Text="风灵月影宗储物袋" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    FontSize="9"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="Fling Trainer Library" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  导航：游戏库 / 收藏夹 / 下载队列 / 设置  -->
                    <ListBox
                        x:Name="NavList"
                        Grid.Row="1"
                        Margin="10,6,10,0"
                        SelectionChanged="NavList_SelectionChanged"
                        Style="{StaticResource NavList}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE7FC;" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="游戏库" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE734;" />
                                <TextBlock
                                    x:Name="NavFavLabel"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="收藏夹" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE896;" />
                                <TextBlock
                                    x:Name="NavQueueLabel"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="下载队列" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE713;" />
                                <TextBlock
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="设置" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!--  底部信息  -->
                    <Border
                        Grid.Row="3"
                        Margin="14,0,14,16"
                        Padding="12,10"
                        Background="#FF0E1723"
                        BorderBrush="#FF16222F"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="9.5"
                                Foreground="{StaticResource B.TextMute}"
                                Text="数据源" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#FF7FB4FF"
                                Text="flingtrainer.com" />
                            <TextBlock
                                x:Name="SidebarSyncText"
                                Margin="0,4,0,0"
                                FontSize="9.5"
                                Foreground="{StaticResource B.TextMute}"
                                Text="—" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  ==================== 右侧主体 ====================  -->
            <Grid Grid.Column="1" Background="{StaticResource B.BgMain}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!--  顶栏  -->
                <Grid
                    Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  搜索：输入时不动列表，按回车才向官网发请求；聚焦时描边变蓝提示  -->
                    <Border
                        Width="360"
                        Height="38"
                        Margin="26,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF0C1621" />
                                <Setter Property="BorderBrush" Value="#FF1B2A3A" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Background" Value="#FF0F1D2C" />
                                        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  放大镜：外框 16 高，和输入框里的文字同一条中轴  -->
                            <Border
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="12"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="&#xE721;" />
                            </Border>

                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                KeyDown="SearchBox_KeyDown"
                                Style="{StaticResource SearchBox}"
                                TextChanged="SearchBox_TextChanged" />
                            <TextBlock
                                x:Name="SearchHint"
                                Grid.Column="1"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource B.TextMute}"
                                IsHitTestVisible="False"
                                Text="输入游戏名，回车搜索官网" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="9.5"
                                Foreground="#FF40556B"
                                Text="Ctrl+K" />
                        </Grid>
                    </Border>

                    <!--  窗口按钮  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="RefreshButton"
                            Click="Refresh_Click"
                            Style="{StaticResource IconBtn}"
                            ToolTip="从 flingtrainer.com 同步最新数据">
                            <TextBlock
                                x:Name="RefreshGlyph"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="13"
                                RenderTransformOrigin="0.5,0.5"
                                Text="&#xE72C;" />
                        </Button>
                        <Border
                            Width="1"
                            Height="16"
                            Margin="6,0"
                            Background="#FF1B2A3A" />
                        <Button
                            Click="Minimize_Click"
                            Style="{StaticResource IconBtn}"
                            ToolTip="最小化到托盘">
                            <TextBlock
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="11"
                                Text="&#xE921;" />
                        </Button>
                        <Button
                            Click="Close_Click"
                            Style="{StaticResource CloseBtn}"
                            ToolTip="关闭">
                            <TextBlock
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="10"
                                Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  主体区  -->
                <Grid x:Name="MainArea" Grid.Row="1">

                    <!--  游戏卡片区：固定版心（最大 1360），再宽的屏幕整块居中 -->
                    <Grid
                        x:Name="CardArea"
                        Margin="26,4,26,0"
                        HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,6,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="SectionTitle"
                                    VerticalAlignment="Center"
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource T.Base}"
                                    Text="Steam 单机游戏库" />
                                <StackPanel
                                    x:Name="LibraryTabs"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="RecentTabButton"
                                        Click="LibraryTab_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource LibraryTabButton}"
                                        Tag="Recent"
                                        Content="最近更新" />
                                    <Button
                                        x:Name="PopularTabButton"
                                        Margin="6,0,0,0"
                                        Click="LibraryTab_Click"
                                        Style="{StaticResource LibraryTabButton}"
                                        Tag="Popular"
                                        Content="热门游戏" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="SectionSubtitle"
                                Margin="1,5,0,0"
                                Style="{StaticResource T.Mute}"
                                Text="—" />
                        </StackPanel>

                        <!--  卡片列表：固定一行 5 张 + 虚拟化滚动  -->
                        <ListBox
                            x:Name="CardList"
                            Grid.Row="1"
                            PreviewMouseWheel="CardList_PreviewMouseWheel"
                            ScrollViewer.ScrollChanged="CardList_ScrollChanged"
                            Style="{StaticResource CardListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Click="Card_Click"
                                                    MouseEnter="Card_MouseEnter"
                                                    MouseLeave="Card_MouseLeave"
                                                    Style="{StaticResource CardButton}"
                                                    Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="{DynamicResource CardInfoH}" />
                                                        </Grid.RowDefinitions>

                                                        <!--  ===== 封面区：16:9，等比完整显示，不裁剪也不变形；只有上面两角是圆的，下面和标题区连成一片  =====  -->
                                                        <Grid Grid.Row="0">
                                                            <Border Background="#FF101C2A" CornerRadius="12,12,0,0" />

                                                            <!--  封面图下面的水印字母：没有封面、图还没下完或下载失败时都能看到，不会留一块空白色块  -->
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe UI"
                                                                FontSize="40"
                                                                FontWeight="Bold"
                                                                Foreground="#22FFFFFF"
                                                                IsHitTestVisible="False"
                                                                Text="{Binding Initials}" />

                                                            <!--  封面图用 Border 背景绘制：圆角会一起裁掉，鼠标悬停放大时不会溢出卡片  -->
                                                            <Border x:Name="CoverArt" CornerRadius="12,12,0,0">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CoverSource, Converter={StaticResource ImgConv}}" Stretch="Uniform">
                                                                        <ImageBrush.RelativeTransform>
                                                                            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                                                        </ImageBrush.RelativeTransform>
                                                                    </ImageBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <Border Background="{StaticResource B.CardScrim}" CornerRadius="12,12,0,0" />

                                                            <!--  收藏夹里才有：取消收藏  -->
                                                            <Button
                                                                Margin="8,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Click="RemoveFavorite_Click"
                                                                Style="{StaticResource CardFavRemove}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />

                                                            <!--  更新时间角标  -->
                                                            <Border
                                                                Margin="0,8,8,0"
                                                                Padding="6,3"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="#B3060D16"
                                                                CornerRadius="6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource F.Icon}"
                                                                        FontSize="8.5"
                                                                        Foreground="#FF8FC2FF"
                                                                        Text="&#xE823;" />
                                                                    <TextBlock
                                                                        Margin="4,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="9"
                                                                        Foreground="#FFDCE8F6"
                                                                        Text="{Binding UpdatedShort}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <!--  ===== 文字区：只留标题，整卡可点打开详情  =====  -->
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            MaxHeight="38"
                                                            Margin="13,9,13,0"
                                                            FontSize="13.5"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            LineHeight="19"
                                                            Text="{Binding DisplayTitle}"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  翻页加载状态  -->
                        <Grid
                            x:Name="CardsFooter"
                            Grid.Row="1"
                            Height="40"
                            Margin="0,4,8,0"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <StackPanel
                                x:Name="FooterLoading"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="12"
                                    Foreground="{StaticResource B.AccentLight}"
                                    Text="&#xE895;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource B.TextDim}"
                                    Text="正在加载下一页…" />
                            </StackPanel>

                            <Button
                                x:Name="FooterRetry"
                                Height="30"
                                Padding="14,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="FooterRetry_Click"
                                Content="加载失败，点击重试"
                                FontSize="11.5"
                                Style="{StaticResource GhostBtn}"
                                Visibility="Collapsed" />

                            <StackPanel
                                x:Name="FooterEnd"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <Border
                                    Width="34"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="#FF1D2B3C" />
                                <TextBlock
                                    x:Name="FooterEndText"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="已经到底了" />
                                <Border
                                    Width="34"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="#FF1D2B3C" />
                            </StackPanel>
                        </Grid>

                        <!--  空状态  -->
                        <Grid
                            x:Name="EmptyState"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <StackPanel
                                Margin="0,0,0,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="#FF131F2D"
                                    CornerRadius="16">
                                    <TextBlock
                                        x:Name="EmptyGlyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="22"
                                        Foreground="#FF3E5670"
                                        Text="&#xE7FC;" />
                                </Border>
                                <TextBlock
                                    x:Name="EmptyTitle"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#FFB9C9DA"
                                    Text="暂无内容" />
                                <TextBlock
                                    x:Name="EmptyDesc"
                                    MaxWidth="460"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource B.TextMute}"
                                    LineHeight="19"
                                    Text=""
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <!--  ==================== 设置 ====================  -->
                        <Grid
                            x:Name="SettingsPanel"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <Grid VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <!--  设置项一行最多 760 宽，再宽就留白，别把按钮甩到屏幕最右边  -->
                                    <ColumnDefinition Width="*" MaxWidth="760" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="18,14"
                                    Background="{StaticResource B.Panel}"
                                    BorderBrush="{StaticResource B.BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border
                                                Width="32"
                                                Height="32"
                                                Background="#FF17283C"
                                                CornerRadius="9">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource F.Icon}"
                                                    FontSize="14"
                                                    Foreground="{StaticResource B.AccentLight}"
                                                    Text="&#xE74D;" />
                                            </Border>
                                            <TextBlock
                                                Margin="11,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#FFDCE7F4"
                                                Text="清除缓存" />
                                        </StackPanel>

                                        <Button
                                            x:Name="ClearCacheButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Click="ClearCache_Click"
                                            Content="一键清除缓存"
                                            Style="{StaticResource DangerBtn}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!--  ==================== 下载队列 ====================  -->
                        <Grid
                            x:Name="QueuePanel"
                            Grid.Row="1"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,6,12">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Height="30"
                                        Padding="12,0"
                                        Click="OpenDownloadDir_Click"
                                        Content="打开下载目录"
                                        FontSize="11.5"
                                        Style="{StaticResource GhostBtn}" />
                                    <Button
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="ClearFinished_Click"
                                        Content="清理已完成"
                                        FontSize="11.5"
                                        Style="{StaticResource GhostBtn}" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                Padding="0,0,6,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="QueueList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="14,12"
                                                Background="#FF0F1926"
                                                BorderBrush="#FF182533"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border
                                                                Width="32"
                                                                Height="32"
                                                                Background="#FF17283C"
                                                                BorderBrush="#FF243B53"
                                                                BorderThickness="1"
                                                                CornerRadius="8">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="9"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#FF8FC2FF"
                                                                    Text="{Binding ExtText}" />
                                                            </Border>
                                                            <StackPanel
                                                                MaxWidth="420"
                                                                Margin="11,0,0,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#FFDCE7F4"
                                                                    Text="{Binding GameTitle}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,3,0,0"
                                                                    FontSize="10.5"
                                                                    Foreground="#FF6C819A"
                                                                    Text="{Binding FileName}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip="{Binding SavePath}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="10.5"
                                                                Foreground="#FF8FC2FF"
                                                                Text="{Binding StateText}" />
                                                            <Button
                                                                Click="QueueCancel_Click"
                                                                Content="取消"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                Click="QueueRetry_Click"
                                                                Content="重试"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                MinWidth="78"
                                                                Click="QueueOpen_Click"
                                                                Content="打开文件夹"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                            <Button
                                                                Margin="8,0,0,0"
                                                                Click="QueueRemove_Click"
                                                                Content="移除"
                                                                Style="{StaticResource RowActionBtn}"
                                                                Tag="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <ProgressBar
                                                        Grid.Row="1"
                                                        Height="5"
                                                        Margin="0,12,0,0"
                                                        IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                        Maximum="1"
                                                        Style="{StaticResource ThinProgress}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        Value="{Binding Progress, Mode=OneWay}" />

                                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                                        <TextBlock
                                                            Margin="0,0,70,0"
                                                            FontSize="10.5"
                                                            Foreground="#FF7C90A6"
                                                            Text="{Binding DetailText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="10.5"
                                                            Foreground="#FF8FC2FF"
                                                            Text="{Binding PercentText}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel
                                x:Name="QueueEmpty"
                                Grid.Row="1"
                                Margin="0,0,0,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Background="#FF131F2D"
                                    CornerRadius="16">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="22"
                                        Foreground="#FF3E5670"
                                        Text="&#xE896;" />
                                </Border>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#FFB9C9DA"
                                    Text="队列是空的" />
                                <TextBlock
                                    MaxWidth="460"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource B.TextMute}"
                                    LineHeight="19"
                                    Text="在任意游戏详情页点「下载」，文件会直接存到本机，进度实时显示在这里。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                    </Grid>

                </Grid>

                <!--  底部状态栏  -->
                <Border
                    Grid.Row="2"
                    BorderBrush="#FF16222F"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="26,0,22,0">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{StaticResource B.Green}" />
                            <TextBlock
                                x:Name="StatusText"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource B.TextDim}"
                                Text="数据已就绪" />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource B.TextMute}"
                                Text="实时在线" />
                            <TextBlock
                                Margin="8,0"
                                FontSize="10"
                                Foreground="#FF2E4358"
                                Text="·" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource B.TextMute}"
                                Text="官网同步" />
                            <TextBlock
                                Margin="8,0"
                                FontSize="10"
                                Foreground="#FF2E4358"
                                Text="·" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource B.TextMute}"
                                Text="v1.0.0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--  ==================== 详情弹框层 ====================  -->
            <!--  点遮罩（弹框外面那片半透明区域）就关掉弹框；点在弹框上不算  -->
            <Grid
                x:Name="DetailLayer"
                Grid.ColumnSpan="2"
                Background="#5C080D15"
                MouseLeftButtonDown="DetailLayer_MouseLeftButtonDown"
                Visibility="Collapsed">
                <ContentControl
                    x:Name="DetailHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="DetailSlide" Y="10" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <!--  ==================== 确认框 ====================  -->
            <!--  点遮罩（弹框外面那片半透明区域）视为取消；点在弹框上不算  -->
            <Grid
                x:Name="ConfirmLayer"
                Grid.ColumnSpan="2"
                Background="#5C080D15"
                MouseLeftButtonDown="ConfirmLayer_MouseLeftButtonDown"
                Visibility="Collapsed">
                <Border
                    Width="440"
                    Padding="24,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF101B28"
                    BorderBrush="{StaticResource B.Border}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="28"
                            Direction="270"
                            Opacity="0.45"
                            ShadowDepth="10"
                            Color="#FF000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock
                            x:Name="ConfirmTitle"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#FFE6EFF8"
                            Text="确认操作？" />
                        <TextBlock
                            x:Name="ConfirmBody"
                            Margin="0,10,0,0"
                            FontSize="12"
                            Foreground="{StaticResource B.TextDim}"
                            LineHeight="20"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                Height="32"
                                Padding="18,0"
                                Click="ConfirmCancel_Click"
                                Content="取消"
                                FontSize="12"
                                Style="{StaticResource GhostBtn}" />
                            <Button
                                x:Name="ConfirmOkButton"
                                Height="32"
                                Margin="10,0,0,0"
                                Padding="18,0"
                                Click="ConfirmOk_Click"
                                Content="确定"
                                Style="{StaticResource DangerBtn}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
