<Window
    x:Class="FlingTrainerX.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="228"
    Height="102"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    Topmost="True"
    WindowStyle="None">
    <Window.Resources>
        <!--  Steam 风格菜单项：34 高、左侧 16px 图标、悬停整行浅蓝底 + 5px 圆角  -->
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFD3E1F0" />
            <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF24384F" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF1B2B3E" />
                                <Setter Property="Foreground" Value="#FFE9F2FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  菜单里的图标：跟着条目走，不抢文字的注意力  -->
        <Style x:Key="TrayMenuIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF8CA3BB" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="TrayMenuLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>

    <!--  margin 留出投影的位置；面板本身是 Steam 客户端的深板岩色 #16202D  -->
    <Border
        Margin="9"
        Background="#FF16202D"
        BorderBrush="#FF2C3E53"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Direction="270"
                Opacity="0.5"
                ShadowDepth="3"
                Color="#FF000000" />
        </Border.Effect>

        <StackPanel Margin="4">
            <Button Click="Open_Click" Style="{StaticResource TrayMenuItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TrayMenuIcon}" Text="&#xE80F;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource TrayMenuLabel}"
                        Text="打开主界面" />
                </Grid>
            </Button>

            <Border Height="1" Margin="9,3" Background="#FF233141" />

            <Button Click="Exit_Click" Style="{StaticResource TrayMenuItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TrayMenuIcon}" Text="&#xE7E8;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource TrayMenuLabel}"
                        Text="退出程序" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
