<Window
    x:Class="FlingTrainerX.Views.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="236"
    Height="126"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource B.AccentDim}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF244A72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Margin="7"
        Background="{StaticResource B.Panel}"
        BorderBrush="{StaticResource B.Border}"
        BorderThickness="1"
        CornerRadius="11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.42" ShadowDepth="4" Color="#FF000000" />
        </Border.Effect>
        <StackPanel Margin="6">
            <Button Click="Open_Click" Style="{StaticResource TrayMenuItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource F.Icon}"
                        FontSize="14"
                        Foreground="{StaticResource B.AccentLight}"
                        Text="&#xE80F;" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="打开主界面" />
                </Grid>
            </Button>
            <Border Height="1" Margin="10,5" Background="{StaticResource B.Border}" />
            <Button Click="Exit_Click" Style="{StaticResource TrayMenuItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource F.Icon}"
                        FontSize="14"
                        Foreground="{StaticResource B.TextDim}"
                        Text="&#xE8BB;" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="退出程序" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
