<UserControl x:Class="FlingTrainerX.Views.TrainerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="664">

    <Border x:Name="Panel" Width="1000" Height="664" CornerRadius="16"
            Background="{StaticResource B.Panel}"
            BorderBrush="#FF27384D" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="188" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= 顶部大图 ================= -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" ClipToBounds="True">
                <Grid>
                    <Border CornerRadius="15,15,0,0" Background="#FF0A111B" />
                    <Rectangle RadiusX="15" RadiusY="15">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="BannerBrush" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle RadiusX="15" RadiusY="15" Fill="{StaticResource B.BannerScrim}" />
                    <Rectangle RadiusX="15" RadiusY="15">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F2070E17" Offset="0" />
                                <GradientStop Color="#C2070E17" Offset="0.45" />
                                <GradientStop Color="#66070E17" Offset="0.8" />
                                <GradientStop Color="#33070E17" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Bottom" Margin="26,0,26,16">
                        <TextBlock Text="{Binding DisplayTitle}" FontFamily="{StaticResource F.Ui}"
                                   FontSize="27" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubTitle}" FontFamily="{StaticResource F.Ui}"
                                   FontSize="12" Foreground="#FFB7C7DA" Margin="1,4,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Style="{StaticResource Chip}" Background="#CC12243A">
                                <TextBlock Text="{Binding OptionCountText}" FontSize="11"
                                           Foreground="{StaticResource B.AccentLight}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#CC12243A"
                                    Visibility="{Binding Version, Converter={StaticResource TextToVis}}">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Text="游戏版本 " Foreground="#FF8EA3BA" />
                                    <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#CC12243A"
                                    Visibility="{Binding PlatformText, Converter={StaticResource TextToVis}}">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Text="平台 " Foreground="#FF8EA3BA" />
                                    <Run Text="{Binding PlatformText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#CC12243A">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Text="最后更新 " Foreground="#FF8EA3BA" />
                                    <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#CC12243A">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Text="发布 " Foreground="#FF8EA3BA" />
                                    <Run Text="{Binding Published, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Button x:Name="CloseButton" Style="{StaticResource RoundCloseBtn}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                            Click="CloseButton_Click" ToolTip="关闭 (Esc)" />
                </Grid>
            </Border>

            <!-- ================= 内容区 ================= -->
            <Grid Grid.Row="1" Margin="24,14,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="236" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 选项卡 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="OptionsTab" Style="{StaticResource DetailTab}" Click="OptionsTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="OptionsTabText" Text="修改选项" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#FFEAF2FB" />
                                <Border Background="#FF1B2C40" CornerRadius="6" Padding="6,1" Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="OptionsTabCount" FontSize="10" Foreground="#FF7FB4FF" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DownloadTab" Style="{StaticResource DetailTab}" Click="DownloadTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DownloadTabText" Text="下载文件" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="#FF8CA2B9" />
                                <Border Background="#FF1B2C40" CornerRadius="6" Padding="6,1" Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DownloadTabCount" FontSize="10" Foreground="#FF7FB4FF" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TabHint" Text="" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource B.TextMute}" Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>

                    <!-- ===== Options 面板 ===== -->
                    <Grid x:Name="OptionsPane" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="修改选项" Style="{StaticResource T.Base}"
                                           FontSize="13.5" FontWeight="SemiBold" />
                                <Border Background="#FF182A3E" CornerRadius="7" Padding="7,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CountText" FontSize="10.5"
                                               Foreground="{StaticResource B.AccentLight}" />
                                </Border>
                                <TextBlock x:Name="GroupSummary" Text="" FontSize="10.5" Margin="8,0,0,0"
                                           Foreground="{StaticResource B.TextMute}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="FilterWrap" Grid.Column="2" Width="200" Height="32" CornerRadius="8"
                                    Background="#FF0E1926" BorderThickness="1" BorderBrush="{StaticResource B.Border}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                                               Foreground="{StaticResource B.TextMute}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="FilterBox" Grid.Column="1" Margin="7,0,8,0"
                                             Style="{StaticResource SearchBox}" Height="30" FontSize="11.5" />
                                    <TextBlock x:Name="FilterHint" Grid.Column="1" Margin="8,0,0,0"
                                               Text="筛选选项 / 快捷键" FontSize="11.5"
                                               Foreground="{StaticResource B.TextMute}"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>

                        <ScrollViewer x:Name="OptionsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">

                            <StackPanel>
                                <!-- 官网介绍截图 -->
                                <Border x:Name="IntroHost" CornerRadius="10" Background="#FF0B1320"
                                        Height="200" Margin="0,0,0,16" ClipToBounds="True"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Rectangle RadiusX="10" RadiusY="10">
                                            <Rectangle.Fill>
                                                <ImageBrush x:Name="IntroBrush" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,10,10,0" CornerRadius="6" Padding="7,3"
                                                Background="#B3060D16">
                                            <TextBlock Text="官网介绍图" FontSize="9" Foreground="#FFBBD0E4" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="OptionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                                    <Border Width="3" Height="12" CornerRadius="2"
                                                            Background="{StaticResource B.Accent}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TitleCn}" FontFamily="{StaticResource F.Ui}"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="#FFDCE7F4" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Count, StringFormat='· {0} 项'}"
                                                               FontFamily="{StaticResource F.Ui}" FontSize="11"
                                                               Foreground="{StaticResource B.TextMute}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="34" CornerRadius="8" Margin="0,0,8,8"
                                                                    Background="#FF131F2D" BorderThickness="1"
                                                                    BorderBrush="#FF1B2A3B"
                                                                    ToolTip="{Binding Name}">
                                                                <Grid Margin="9,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Style="{StaticResource KeyBadge}" Height="20"
                                                                            MinWidth="24" Padding="7,0">
                                                                        <TextBlock Text="{Binding Key}" FontSize="10"
                                                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                                                   Foreground="#FF8FC2FF"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding NameCn}"
                                                                               FontFamily="{StaticResource F.Ui}" FontSize="11.5"
                                                                               Foreground="#FFC3D2E3" Margin="9,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock x:Name="OptionsLoading" Grid.Row="1" Text="正在加载修改选项…"
                                   FontFamily="{StaticResource F.Ui}" FontSize="12"
                                   Foreground="{StaticResource B.TextMute}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="没有匹配的选项"
                                   FontFamily="{StaticResource F.Ui}" FontSize="12"
                                   Foreground="{StaticResource B.TextMute}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>

                    <!-- ===== Download 面板 ===== -->
                    <Grid x:Name="DownloadPane" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="下载文件" Style="{StaticResource T.Base}"
                                           FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="与官网下载表格一致 · 点「下载」直接存到本机，进度可在下载队列查看"
                                           FontSize="10.5" Foreground="{StaticResource B.TextMute}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CopyAllButton" Style="{StaticResource RowIconBtn}"
                                        ToolTip="复制全部下载地址" Click="CopyAllDownloads_Click">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource F.Icon}" FontSize="11" />
                                </Button>
                                <Button x:Name="ReloadDownloadsButton" Style="{StaticResource RowIconBtn}"
                                        ToolTip="重新从官网读取下载信息" Click="ReloadDownloads_Click">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource F.Icon}" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 表头 -->
                        <Border Grid.Row="1" Padding="10,0,12,7" BorderThickness="0,0,0,1" BorderBrush="#FF223246">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="文件" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Grid.Column="2" Text="添加日期" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Grid.Column="3" Text="大小" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Grid.Column="4" Text="下载量" FontSize="10" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Grid.Column="5" Text="操作" FontSize="10" Foreground="{StaticResource B.TextMute}"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,2,6,0">
                            <ItemsControl x:Name="DownloadsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" CornerRadius="8"
                                                BorderThickness="0,0,0,1" BorderBrush="#FF172432" Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="88" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="26" Height="26" CornerRadius="7" Background="#FF17283C"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="0,1,0,0">
                                                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource F.Icon}"
                                                               FontSize="11" Foreground="#FF7FB4FF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="11.5"
                                                               Foreground="#FFDCE7F4" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Url}" />
                                                    <TextBlock Text="{Binding ShortUrl}" FontSize="9.5" Margin="0,2,0,0"
                                                               Foreground="#FF5D7288" TextTrimming="CharacterEllipsis" />

                                                    <!-- 进度：只在有任务时出现 -->
                                                    <StackPanel Margin="0,7,0,0"
                                                                Visibility="{Binding HasTask, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Style="{StaticResource ThinProgress}"
                                                                         Height="4" Maximum="1"
                                                                         Value="{Binding Progress, Mode=OneWay}"
                                                                         IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                                         VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                                       FontSize="9.5" Margin="8,0,0,0"
                                                                       Foreground="#FF8FC2FF" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding ProgressLine}" FontSize="9.5"
                                                                   Margin="0,4,0,0" Foreground="#FF7C90A6"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="10.5"
                                                           Foreground="#FFA8BACE" VerticalAlignment="Top" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="10.5"
                                                           Foreground="#FFA8BACE" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding CountText}" FontSize="10.5"
                                                           Foreground="#FFA8BACE" VerticalAlignment="Top" Margin="0,2,0,0" />

                                                <Button Grid.Column="5" Style="{StaticResource RowActionBtn}"
                                                        Tag="{Binding}" Click="RowAction_Click"
                                                        Margin="0,0,0,0" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="RowIcon" Text="&#xE896;"
                                                                   FontFamily="{StaticResource F.Icon}" FontSize="10"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ActionText}" FontSize="10.5"
                                                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="DownloadEmpty" Grid.Row="2" Text="官网暂无下载文件"
                                   FontFamily="{StaticResource F.Ui}" FontSize="12"
                                   Foreground="{StaticResource B.TextMute}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- 右侧操作栏：面板被压矮时可以单独滚动，不会被裁掉 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                    <TextBlock Text="操作" FontFamily="{StaticResource F.Ui}" FontSize="11"
                               Foreground="{StaticResource B.TextMute}" Margin="2,0,0,8" />

                    <Button Style="{StaticResource PrimaryBtn}" Height="38" Margin="0,0,0,8"
                            Click="Download_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="下载最新文件" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostBtn}" Height="36" Margin="0,0,0,8"
                            Click="OpenSite_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="打开官网详情页" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostBtn}" Height="36" Margin="0,0,0,8"
                            Click="CopyLink_Click" Content="复制页面链接" />

                    <Button x:Name="FavButton" Style="{StaticResource GhostBtn}" Height="36" Margin="0,0,0,16"
                            Click="Favorite_Click" Content="加入收藏夹" />

                    <Border Background="#FF121D2B" CornerRadius="10" Padding="14,12"
                            BorderThickness="1" BorderBrush="{StaticResource B.BorderSoft}">
                        <StackPanel>
                            <TextBlock Text="详细信息" FontFamily="{StaticResource F.Ui}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="#FFCBD9E8" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="游戏版本" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Text="{Binding Version}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FFB9C9DA" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="最后更新" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Text="{Binding UpdatedText}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FFB9C9DA" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="首次发布" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Text="{Binding Published}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FFB9C9DA" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="选项数量" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Text="{Binding RealOptionCount}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FFB9C9DA" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="下载文件" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock x:Name="DownloadCountText" Text="—" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FFB9C9DA" />
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="最新文件" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock x:Name="LatestFileText" Text="—" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FFB9C9DA" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="数据来源" FontSize="11" Foreground="{StaticResource B.TextMute}" />
                                <TextBlock Text="flingtrainer.com" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="#FF7FB4FF" />
                            </Grid>
                        </StackPanel>
                    </Border>

                        <TextBlock x:Name="ToastText" Text="" FontFamily="{StaticResource F.Ui}"
                                   FontSize="11" Foreground="{StaticResource B.Green}"
                                   Margin="2,10,0,0" TextWrapping="Wrap" Opacity="0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
