<UserControl
    x:Class="FlingTrainerX.Views.TrainerDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="664"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            三个页签的选中态由 VM.SelectedTab 决定：代码里不再手改背景色和文字色，
            每个页签各挂一个 DataTrigger，切页签只是改一个 int。
        -->
        <Style
            x:Key="TabShots"
            TargetType="Button"
            BasedOn="{StaticResource DetailTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                    <Setter Property="Background" Value="{StaticResource B.AccentDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TabOptions"
            TargetType="Button"
            BasedOn="{StaticResource DetailTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                    <Setter Property="Background" Value="{StaticResource B.AccentDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TabDownloads"
            TargetType="Button"
            BasedOn="{StaticResource DetailTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                    <Setter Property="Background" Value="{StaticResource B.AccentDim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  页签上的文字：选中的那一项亮成纯白  -->
        <Style x:Key="TabLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Fs.Body}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFE6EEF8" />
        </Style>

        <Style
            x:Key="TabLabelShots"
            TargetType="TextBlock"
            BasedOn="{StaticResource TabLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TabLabelOptions"
            TargetType="TextBlock"
            BasedOn="{StaticResource TabLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TabLabelDownloads"
            TargetType="TextBlock"
            BasedOn="{StaticResource TabLabel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  收藏按钮：已收藏时文字变成强调色  -->
        <Style
            x:Key="FavButton"
            TargetType="Button"
            BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.AccentLight}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            右侧「启动程序」：能启动时换成蓝色主按钮（模板跟 PrimaryBtn 共用一份），
            一眼就能看到"现在该点哪个"；还不能启动时退回灰底幽灵按钮并压暗，维持原样。
            不能直接换 Style —— 触发器里只能改属性，没法把 Style 换成另一个 Style，所以改 Template 引用。
        -->
        <Style
            x:Key="LaunchButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource GhostBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaunchEnabled}" Value="True">
                    <Setter Property="Template" Value="{StaticResource PrimaryBtnTemplate}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Panel"
        Width="1000"
        Height="664"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{StaticResource B.Panel}"
        BorderBrush="#FF3A5573"
        BorderThickness="1"
        CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BannerRow" Height="240" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ================= 顶部大图 =================  -->
            <!--
                仅靠各层 Border 的 CornerRadius 圆不了角：模糊底衬（BlurEffect）会把半透明像素
                糊到圆弧外面，把方角填成一层灰。这里给整个横幅套一个「上圆下方」的几何裁剪
                （BannerShell.Clip 在代码里按实际尺寸算），任何一层都溢不出去
            -->
            <Border
                x:Name="BannerShell"
                Grid.Row="0"
                Background="#FF111E2C"
                ClipToBounds="True"
                CornerRadius="16,16,0,0"
                RenderOptions.BitmapScalingMode="HighQuality">
                <Grid>
                    <!--  底衬：同一张图铺满并虚化，主图两侧不会露出死黑  -->
                    <Border CornerRadius="16,16,0,0" Opacity="0.55">
                        <Border.Background>
                            <ImageBrush
                                x:Name="BannerBackBrush"
                                AlignmentY="Center"
                                Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect KernelType="Gaussian" Radius="46" />
                        </Border.Effect>
                    </Border>

                    <!--  主图：横向铺满容器，等比缩放，不拉伸不变形  -->
                    <Border CornerRadius="16,16,0,0">
                        <Border.Background>
                            <ImageBrush
                                x:Name="BannerBrush"
                                AlignmentY="Center"
                                Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <!--  只在左下角压暗，保证白色标题可读；右上角基本保留原图  -->
                    <Border Background="{StaticResource B.BannerScrim}" CornerRadius="16,16,0,0" />
                    <Border CornerRadius="16,16,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#8C070E17" />
                                <GradientStop Offset="0.45" Color="#52070E17" />
                                <GradientStop Offset="0.75" Color="#1F070E17" />
                                <GradientStop Offset="1" Color="#00070E17" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Margin="26,0,26,16" VerticalAlignment="Bottom">
                        <!--  用只读 TextBox 代替 TextBlock：可以拖选、Ctrl+C 复制游戏名，外观与原来一致  -->
                        <TextBox
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="Transparent"
                            Cursor="IBeam"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Display}"
                            FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalScrollBarVisibility="Disabled"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="False"
                            IsTabStop="False"
                            SelectionBrush="#B37FB4FF"
                            Text="{Binding Item.DisplayTitle, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Disabled" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Background="#CC12243A" Style="{StaticResource Chip}">
                                <TextBlock
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="{StaticResource B.AccentLight}"
                                    Text="{Binding Item.OptionCountText}" />
                            </Border>
                            <Border
                                Background="#CC12243A"
                                Style="{StaticResource Chip}"
                                Visibility="{Binding Item.Version, Converter={StaticResource TextToVis}}">
                                <TextBlock FontSize="{StaticResource Fs.Caption}" Foreground="#FFFFFFFF">
                                    <Run Foreground="#FFDCE6F1" Text="游戏版本 " />
                                    <Run Text="{Binding Item.Version, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border
                                Background="#CC12243A"
                                Style="{StaticResource Chip}"
                                Visibility="{Binding Item.PlatformText, Converter={StaticResource TextToVis}}">
                                <TextBlock FontSize="{StaticResource Fs.Caption}" Foreground="#FFFFFFFF">
                                    <Run Foreground="#FFDCE6F1" Text="平台 " />
                                    <Run Text="{Binding Item.PlatformText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Background="#CC12243A" Style="{StaticResource Chip}">
                                <TextBlock FontSize="{StaticResource Fs.Caption}" Foreground="#FFFFFFFF">
                                    <Run Foreground="#FFDCE6F1" Text="最后更新 " />
                                    <Run Text="{Binding Item.UpdatedText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Background="#CC12243A" Style="{StaticResource Chip}">
                                <TextBlock FontSize="{StaticResource Fs.Caption}" Foreground="#FFFFFFFF">
                                    <Run Foreground="#FFDCE6F1" Text="发布 " />
                                    <Run Text="{Binding Item.Published, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Button
                        x:Name="CloseButton"
                        Margin="0,14,14,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource RoundCloseBtn}"
                        ToolTip="关闭 (Esc)" />
                </Grid>
            </Border>

            <!--  ================= 内容区 =================  -->
            <Grid Grid.Row="1" Margin="24,14,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="236" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  选项卡：软件截图 / 选项功能 / 文件下载  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        Orientation="Horizontal">
                        <Button
                            x:Name="ShotsTab"
                            Command="{Binding ShowShotsCommand}"
                            Style="{StaticResource TabShots}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="ShotsTabText"
                                    Style="{StaticResource TabLabelShots}"
                                    Text="软件截图" />
                                <Border
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#FF2B4462"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="ShotsTabCount"
                                        FontSize="{StaticResource Fs.Caption}"
                                        Foreground="#FF7FB4FF"
                                        Text="{Binding ShotsCount}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="OptionsTab"
                            Command="{Binding ShowOptionsCommand}"
                            Style="{StaticResource TabOptions}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="OptionsTabText"
                                    Style="{StaticResource TabLabelOptions}"
                                    Text="选项功能" />
                                <Border
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#FF2B4462"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="OptionsTabCount"
                                        FontSize="{StaticResource Fs.Caption}"
                                        Foreground="#FF7FB4FF"
                                        Text="{Binding OptionsCount}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="DownloadTab"
                            Command="{Binding ShowDownloadsCommand}"
                            Style="{StaticResource TabDownloads}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="DownloadTabText"
                                    Style="{StaticResource TabLabelDownloads}"
                                    Text="文件下载" />
                                <Border
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#FF2B4462"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="DownloadTabCount"
                                        FontSize="{StaticResource Fs.Caption}"
                                        Foreground="#FF7FB4FF"
                                        Text="{Binding DownloadsCount}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  ===== 选项功能面板 =====  -->
                    <!--  不再显示分组标题与「N 项」这类说明，就是一列干净的快捷键 + 功能名  -->
                    <Grid
                        x:Name="OptionsPane"
                        Grid.Row="1"
                        Visibility="{Binding OptionsPaneVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                            标题和数量已经在选项卡上（「选项功能 36」），面板里重复一遍纯属占地方；
                            这一行只保留右侧的筛选框
                        -->
                        <Border
                            x:Name="FilterWrap"
                            Grid.Row="0"
                            Width="200"
                            Height="32"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Right"
                            Background="#FF192A3E"
                            BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="13"
                                    Foreground="#FFC6D4E2"
                                    Text="&#xE721;" />
                                <TextBox
                                    x:Name="FilterBox"
                                    Grid.Column="1"
                                    Height="30"
                                    Margin="7,0,8,0"
                                    FontSize="{StaticResource Fs.Small}"
                                    Style="{StaticResource SearchBox}"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    x:Name="FilterHint"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource Fs.Small}"
                                    Foreground="#FFC6D4E2"
                                    IsHitTestVisible="False"
                                    Text="筛选选项 / 快捷键"
                                    Visibility="{Binding FilterHintVisible, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <ScrollViewer
                            x:Name="OptionsScroll"
                            Grid.Row="1"
                            Padding="0,0,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OptionsList" ItemsSource="{Binding Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Height="38"
                                            Margin="0,0,8,8"
                                            Background="#FF22354B"
                                            BorderBrush="#FF2C4259"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            ToolTip="{Binding Name}">
                                            <Grid Margin="9,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Height="22"
                                                    MinWidth="24"
                                                    Padding="7,0"
                                                    Style="{StaticResource KeyBadge}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas, Microsoft YaHei UI"
                                                        FontSize="{StaticResource Fs.Caption}"
                                                        Foreground="#FF8FC2FF"
                                                        Text="{Binding Key}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="9,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource F.Ui}"
                                                    FontSize="{StaticResource Fs.Small}"
                                                    Foreground="#FFF8FBFF"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="OptionsLoading"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Small}"
                            Foreground="#FFC6D4E2"
                            Text="正在加载修改选项…"
                            Visibility="{Binding OptionsLoadingVisible, Converter={StaticResource BoolToVis}}" />

                        <TextBlock
                            x:Name="EmptyHint"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Small}"
                            Foreground="#FFC6D4E2"
                            Text="没有匹配的选项"
                            Visibility="{Binding OptionsEmptyVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!--  ===== 文件下载面板 =====  -->
                    <Grid
                        x:Name="DownloadPane"
                        Grid.Row="1"
                        Visibility="{Binding DownloadPaneVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  标题已在选项卡上（「文件下载 1」），这一行只留右侧两个小图标按钮  -->
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                x:Name="CopyAllButton"
                                Command="{Binding CopyAllDownloadsCommand}"
                                Style="{StaticResource RowIconBtn}"
                                ToolTip="复制全部下载地址">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE8C8;" />
                            </Button>
                            <Button
                                x:Name="ReloadDownloadsButton"
                                Command="{Binding ReloadDownloadsCommand}"
                                IsEnabled="{Binding ReloadEnabled}"
                                Style="{StaticResource RowIconBtn}"
                                ToolTip="重新从官网读取下载信息">
                                <TextBlock
                                    FontFamily="{StaticResource F.Icon}"
                                    FontSize="14"
                                    Text="&#xE72C;" />
                            </Button>
                        </StackPanel>

                        <!--  表头  -->
                        <Border
                            Grid.Row="1"
                            Padding="13,0,12,7"
                            BorderBrush="#FF334C68"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="#FFC6D4E2"
                                    Text="文件" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="#FFC6D4E2"
                                    Text="状态" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="#FFC6D4E2"
                                    Text="添加日期" />
                                <TextBlock
                                    Grid.Column="4"
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="#FFC6D4E2"
                                    Text="大小" />
                                <TextBlock
                                    Grid.Column="5"
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="#FFC6D4E2"
                                    Text="下载量" />
                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource Fs.Caption}"
                                    Foreground="#FFC6D4E2"
                                    Text="操作" />
                            </Grid>
                        </Border>

                        <ScrollViewer
                            Grid.Row="2"
                            Padding="0,2,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DownloadsList" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  整行可选中：鼠标移上来就变成选中行，右侧「启动程序」启动的就是它  -->
                                        <Border
                                            MouseEnter="Row_Enter"
                                            MouseLeftButtonUp="Row_Select"
                                            Style="{StaticResource DownloadRowItem}"
                                            Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  选中标记：左侧一条竖线  -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,3"
                                                    Background="{StaticResource B.Accent}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                <Grid Grid.Column="1" Margin="10,9,10,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="26"
                                                        Height="26"
                                                        Margin="0,1,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#FF17283C"
                                                        CornerRadius="7">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource F.Icon}"
                                                            FontSize="13"
                                                            Foreground="#FF7FB4FF"
                                                            Text="&#xE7C3;" />
                                                    </Border>

                                                    <!--  文件：只显示文件名  -->
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,2,12,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="{StaticResource Fs.Small}"
                                                        Foreground="#FFFFFFFF"
                                                        Text="{Binding FileName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Url}" />

                                                    <!--  状态：已下载 / 未下载 / 正在下载（真实进度条 + 已下载/总大小）  -->
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Margin="0,1,12,0"
                                                        VerticalAlignment="Top">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StateText}" />
                                                            <TextBlock
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="{StaticResource Fs.Caption}"
                                                                FontWeight="SemiBold"
                                                                Foreground="#FF8FC2FF"
                                                                Text="{Binding PercentText}"
                                                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <ProgressBar
                                                            Height="5"
                                                            Margin="0,7,4,0"
                                                            HorizontalAlignment="Stretch"
                                                            IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                            Maximum="1"
                                                            Style="{StaticResource MiniProgress}"
                                                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"
                                                            Value="{Binding Progress, Mode=OneWay}" />
                                                        <TextBlock
                                                            Margin="0,5,0,0"
                                                            FontSize="{StaticResource Fs.Caption}"
                                                            Foreground="#FFD4DFEB"
                                                            Text="{Binding SizePairText}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="{StaticResource Fs.Caption}"
                                                        Foreground="#FFE9F1F9"
                                                        Text="{Binding Date}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="{StaticResource Fs.Caption}"
                                                        Foreground="#FFE9F1F9"
                                                        Text="{Binding Size}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="{StaticResource Fs.Caption}"
                                                        Foreground="#FFE9F1F9"
                                                        Text="{Binding CountText}" />

                                                    <StackPanel
                                                        Grid.Column="6"
                                                        VerticalAlignment="Top"
                                                        Orientation="Horizontal">
                                                        <!--  主按钮：下载 / 取消 / 重试 / 启动  -->
                                                        <Button
                                                            Command="{Binding DataContext.RowActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RowActionBtn}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="{StaticResource F.Icon}"
                                                                    FontSize="{StaticResource Fs.Caption}"
                                                                    Text="{Binding ActionGlyph}" />
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="{StaticResource Fs.Caption}"
                                                                    Text="{Binding ActionText}" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!--  下载完成后才有：在资源管理器里定位  -->
                                                        <Button
                                                            MinWidth="26"
                                                            Margin="4,0,0,0"
                                                            Padding="7,0"
                                                            Command="{Binding DataContext.RowOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource RowActionBtn}"
                                                            ToolTip="在资源管理器里定位文件"
                                                            Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock
                                                                FontFamily="{StaticResource F.Icon}"
                                                                FontSize="{StaticResource Fs.Caption}"
                                                                Text="&#xE8DA;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="DownloadEmpty"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Small}"
                            Foreground="#FFC6D4E2"
                            Text="{Binding DownloadEmptyText}"
                            Visibility="{Binding DownloadEmptyVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!--  ===== 软件截图面板 =====  -->
                    <!--  标题与张数已经在选项卡上（「软件截图 1」），面板里直接铺图  -->
                    <Grid
                        x:Name="ShotsPane"
                        Grid.Row="1"
                        Visibility="{Binding ShotsPaneVisible, Converter={StaticResource BoolToVis}}">

                        <ScrollViewer
                            x:Name="ShotsScroll"
                            Grid.Row="0"
                            Padding="0,4,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ShotsList" ItemsSource="{Binding Shots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  一张图占满整行宽度，高度按原图比例自动算，弹框放大图片也跟着放大  -->
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.OpenShotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ShotCard}"
                                            ToolTip="点击打开原图">
                                            <Grid MinHeight="140">
                                                <Border
                                                    Background="#FF162438"
                                                    ClipToBounds="True"
                                                    CornerRadius="10">
                                                    <Image
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Source="{Binding Source, Converter={StaticResource ImgConv}}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <Border
                                                    Margin="10"
                                                    Padding="9,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="#A6060D16"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        FontSize="{StaticResource Fs.Caption}"
                                                        Foreground="#FFF3F8FD"
                                                        Text="{Binding Caption}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="ShotsEmpty"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="{StaticResource Fs.Small}"
                            Foreground="#FFC6D4E2"
                            Text="{Binding ShotsEmptyText}"
                            Visibility="{Binding ShotsEmptyVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>

                <!--  右侧操作栏：只有按钮，不需要滚动条（内容固定，矮窗口下也就不滚了）  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <!--
                        第一位放「启动程序」：打这款修改器是最终目的，下载只是过程。
                        能启动时它是蓝色主按钮，不能启动时是压暗的灰按钮 —— 主次一眼分得清。
                    -->
                    <Button
                        x:Name="LaunchButton"
                        Height="38"
                        Margin="0,0,0,8"
                        Command="{Binding LaunchCommand}"
                        IsEnabled="{Binding LaunchEnabled}"
                        Style="{StaticResource LaunchButtonStyle}"
                        ToolTip="{Binding LaunchToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="14"
                                Text="&#xE768;" />
                            <TextBlock
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Text="启动程序" />
                        </StackPanel>
                    </Button>

                    <!--  下载走灰色按钮：不再是主题色（蓝色只留给「能启动」这一件事）  -->
                    <Button
                        Height="38"
                        Margin="0,0,0,8"
                        Command="{Binding DownloadLatestCommand}"
                        Style="{StaticResource GhostBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="15"
                                Text="&#xE896;" />
                            <TextBlock
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Text="下载最新文件" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="FavButton"
                        Height="36"
                        Margin="0,0,0,4"
                        Command="{Binding ToggleFavoriteCommand}"
                        Content="{Binding FavoriteText}"
                        Style="{StaticResource FavButton}" />

                    <TextBlock
                        x:Name="ToastText"
                        Margin="2,8,0,0"
                        FontFamily="{StaticResource F.Ui}"
                        FontSize="{StaticResource Fs.Caption}"
                        Foreground="{StaticResource B.Green}"
                        Opacity="0"
                        Text="{Binding ToastText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--
                加载遮层：只有「要从官网取数据」时才打开——本地已有下载表就直接显示，
                不挡用户。盖住整个面板（含横幅），加载期间点不到任何东西，也看不到半张页面。
                转角比面板小 1px，跟着面板的圆角走。
            -->
            <Border
                x:Name="LoadingOverlay"
                Grid.RowSpan="2"
                Background="#E60A1420"
                CornerRadius="15"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Grid
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center">
                        <!--  底圈：一整圈淡色，给缺口一个参照  -->
                        <Ellipse Stroke="#26FFFFFF" StrokeThickness="3" />
                        <!--  转动的圆弧：90° 缺口 + 圆头，靠 RotateTransform 转  -->
                        <Path
                            x:Name="SpinnerArc"
                            Width="48"
                            Height="48"
                            Data="M 24,4 A 20,20 0 0 1 44,24"
                            Stretch="None"
                            Stroke="{StaticResource B.AccentLight}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="3">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="24" CenterY="24" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource F.Ui}"
                        FontSize="{StaticResource Fs.Body}"
                        Foreground="#FFDCE8F5"
                        Text="正在加载中，请耐心等待…" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
