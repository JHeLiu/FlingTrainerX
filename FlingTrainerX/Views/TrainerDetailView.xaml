<UserControl
    x:Class="FlingTrainerX.Views.TrainerDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="664"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Border
        x:Name="Panel"
        Width="1000"
        Height="664"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{StaticResource B.Panel}"
        BorderBrush="#FF27384D"
        BorderThickness="1"
        CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BannerRow" Height="240" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ================= 顶部大图 =================  -->
            <!--
                仅靠各层 Border 的 CornerRadius 圆不了角：模糊底衬（BlurEffect）会把半透明像素
                糊到圆弧外面，把方角填成一层灰。这里给整个横幅套一个「上圆下方」的几何裁剪
                （BannerShell.Clip 在代码里按实际尺寸算），任何一层都溢不出去
            -->
            <Border
                x:Name="BannerShell"
                Grid.Row="0"
                Background="#FF0A111B"
                ClipToBounds="True"
                CornerRadius="16,16,0,0"
                RenderOptions.BitmapScalingMode="HighQuality">
                <Grid>
                    <!--  底衬：同一张图铺满并虚化，主图两侧不会露出死黑  -->
                    <Border CornerRadius="16,16,0,0" Opacity="0.55">
                        <Border.Background>
                            <ImageBrush
                                x:Name="BannerBackBrush"
                                AlignmentY="Center"
                                Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect KernelType="Gaussian" Radius="46" />
                        </Border.Effect>
                    </Border>

                    <!--  主图：横向铺满容器，等比缩放，不拉伸不变形  -->
                    <Border CornerRadius="16,16,0,0">
                        <Border.Background>
                            <ImageBrush
                                x:Name="BannerBrush"
                                AlignmentY="Center"
                                Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <!--  只在左下角压暗，保证白色标题可读；右上角基本保留原图  -->
                    <Border Background="{StaticResource B.BannerScrim}" CornerRadius="16,16,0,0" />
                    <Border CornerRadius="16,16,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#8C070E17" />
                                <GradientStop Offset="0.45" Color="#52070E17" />
                                <GradientStop Offset="0.75" Color="#1F070E17" />
                                <GradientStop Offset="1" Color="#00070E17" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel Margin="26,0,26,16" VerticalAlignment="Bottom">
                        <!--  用只读 TextBox 代替 TextBlock：可以拖选、Ctrl+C 复制游戏名，外观与原来一致  -->
                        <TextBox
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="Transparent"
                            Cursor="IBeam"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalScrollBarVisibility="Disabled"
                            IsReadOnly="True"
                            IsReadOnlyCaretVisible="False"
                            IsTabStop="False"
                            SelectionBrush="#B37FB4FF"
                            Text="{Binding DisplayTitle, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            ToolTip="可以拖选 / Ctrl+C 复制游戏名"
                            VerticalScrollBarVisibility="Disabled" />
                        <WrapPanel Margin="0,10,0,0">
                            <Border Background="#CC12243A" Style="{StaticResource Chip}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource B.AccentLight}"
                                    Text="{Binding OptionCountText}" />
                            </Border>
                            <Border
                                Background="#CC12243A"
                                Style="{StaticResource Chip}"
                                Visibility="{Binding Version, Converter={StaticResource TextToVis}}">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Foreground="#FF8EA3BA" Text="游戏版本 " />
                                    <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border
                                Background="#CC12243A"
                                Style="{StaticResource Chip}"
                                Visibility="{Binding PlatformText, Converter={StaticResource TextToVis}}">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Foreground="#FF8EA3BA" Text="平台 " />
                                    <Run Text="{Binding PlatformText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Background="#CC12243A" Style="{StaticResource Chip}">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Foreground="#FF8EA3BA" Text="最后更新 " />
                                    <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Background="#CC12243A" Style="{StaticResource Chip}">
                                <TextBlock FontSize="11" Foreground="#FFD6E2F0">
                                    <Run Foreground="#FF8EA3BA" Text="发布 " />
                                    <Run Text="{Binding Published, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Button
                        x:Name="CloseButton"
                        Margin="0,14,14,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"
                        Style="{StaticResource RoundCloseBtn}"
                        ToolTip="关闭 (Esc)" />
                </Grid>
            </Border>

            <!--  ================= 内容区 =================  -->
            <Grid Grid.Row="1" Margin="24,14,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="236" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  选项卡：软件截图 / 选项功能 / 文件下载  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        Orientation="Horizontal">
                        <Button
                            x:Name="ShotsTab"
                            Click="ShotsTab_Click"
                            Style="{StaticResource DetailTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="ShotsTabText"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="#FFEAF2FB"
                                    Text="软件截图" />
                                <Border
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#FF1B2C40"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="ShotsTabCount"
                                        FontSize="10"
                                        Foreground="#FF7FB4FF" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="OptionsTab"
                            Click="OptionsTab_Click"
                            Style="{StaticResource DetailTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="OptionsTabText"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="#FF8CA2B9"
                                    Text="选项功能" />
                                <Border
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#FF1B2C40"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="OptionsTabCount"
                                        FontSize="10"
                                        Foreground="#FF7FB4FF" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="DownloadTab"
                            Click="DownloadTab_Click"
                            Style="{StaticResource DetailTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    x:Name="DownloadTabText"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="#FF8CA2B9"
                                    Text="文件下载" />
                                <Border
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="#FF1B2C40"
                                    CornerRadius="6">
                                    <TextBlock
                                        x:Name="DownloadTabCount"
                                        FontSize="10"
                                        Foreground="#FF7FB4FF" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  ===== 选项功能面板 =====  -->
                    <!--  不再显示分组标题与「N 项」这类说明，就是一列干净的快捷键 + 功能名  -->
                    <Grid
                        x:Name="OptionsPane"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource T.Base}"
                                    Text="选项功能" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="7,1"
                                    VerticalAlignment="Center"
                                    Background="#FF182A3E"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="CountText"
                                        FontSize="10.5"
                                        Foreground="{StaticResource B.AccentLight}" />
                                </Border>
                            </StackPanel>

                            <Border
                                x:Name="FilterWrap"
                                Grid.Column="2"
                                Width="200"
                                Height="32"
                                Background="#FF0E1926"
                                BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="11"
                                        Foreground="{StaticResource B.TextMute}"
                                        Text="&#xE721;" />
                                    <TextBox
                                        x:Name="FilterBox"
                                        Grid.Column="1"
                                        Height="30"
                                        Margin="7,0,8,0"
                                        FontSize="11.5"
                                        Style="{StaticResource SearchBox}" />
                                    <TextBlock
                                        x:Name="FilterHint"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource B.TextMute}"
                                        IsHitTestVisible="False"
                                        Text="筛选选项 / 快捷键" />
                                </Grid>
                            </Border>
                        </Grid>

                        <ScrollViewer
                            x:Name="OptionsScroll"
                            Grid.Row="1"
                            Padding="0,0,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OptionsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Height="34"
                                            Margin="0,0,8,8"
                                            Background="#FF131F2D"
                                            BorderBrush="#FF1B2A3B"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            ToolTip="{Binding Name}">
                                            <Grid Margin="9,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Height="20"
                                                    MinWidth="24"
                                                    Padding="7,0"
                                                    Style="{StaticResource KeyBadge}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas, Microsoft YaHei UI"
                                                        FontSize="10"
                                                        Foreground="#FF8FC2FF"
                                                        Text="{Binding Key}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="9,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource F.Ui}"
                                                    FontSize="11.5"
                                                    Foreground="#FFC3D2E3"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="OptionsLoading"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="12"
                            Foreground="{StaticResource B.TextMute}"
                            Text="正在加载修改选项…" />

                        <TextBlock
                            x:Name="EmptyHint"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="12"
                            Foreground="{StaticResource B.TextMute}"
                            Text="没有匹配的选项"
                            Visibility="Collapsed" />
                    </Grid>

                    <!--  ===== 文件下载面板 =====  -->
                    <Grid
                        x:Name="DownloadPane"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Style="{StaticResource T.Base}"
                                Text="文件下载" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="CopyAllButton"
                                    Click="CopyAllDownloads_Click"
                                    Style="{StaticResource RowIconBtn}"
                                    ToolTip="复制全部下载地址">
                                    <TextBlock
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="11"
                                        Text="&#xE8C8;" />
                                </Button>
                                <Button
                                    x:Name="ReloadDownloadsButton"
                                    Click="ReloadDownloads_Click"
                                    Style="{StaticResource RowIconBtn}"
                                    ToolTip="重新从官网读取下载信息">
                                    <TextBlock
                                        FontFamily="{StaticResource F.Icon}"
                                        FontSize="11"
                                        Text="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  表头  -->
                        <Border
                            Grid.Row="1"
                            Padding="13,0,12,7"
                            BorderBrush="#FF223246"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="10"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="文件" />
                                <TextBlock
                                    Grid.Column="2"
                                    FontSize="10"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="状态" />
                                <TextBlock
                                    Grid.Column="3"
                                    FontSize="10"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="添加日期" />
                                <TextBlock
                                    Grid.Column="4"
                                    FontSize="10"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="大小" />
                                <TextBlock
                                    Grid.Column="5"
                                    FontSize="10"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="下载量" />
                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource B.TextMute}"
                                    Text="操作" />
                            </Grid>
                        </Border>

                        <ScrollViewer
                            Grid.Row="2"
                            Padding="0,2,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DownloadsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  整行可选中：鼠标移上来就变成选中行，右侧「启动程序」启动的就是它  -->
                                        <Border
                                            MouseEnter="Row_Enter"
                                            MouseLeftButtonUp="Row_Select"
                                            Style="{StaticResource DownloadRowItem}"
                                            Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  选中标记：左侧一条竖线  -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,3"
                                                    Background="{StaticResource B.Accent}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                <Grid Grid.Column="1" Margin="10,9,10,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="26"
                                                        Height="26"
                                                        Margin="0,1,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#FF17283C"
                                                        CornerRadius="7">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource F.Icon}"
                                                            FontSize="11"
                                                            Foreground="#FF7FB4FF"
                                                            Text="&#xE7C3;" />
                                                    </Border>

                                                    <!--  文件：只显示文件名  -->
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,2,12,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="11.5"
                                                        Foreground="#FFDCE7F4"
                                                        Text="{Binding FileName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Url}" />

                                                    <!--  状态：已下载 / 未下载 / 正在下载（真实进度条 + 已下载/总大小）  -->
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Margin="0,1,12,0"
                                                        VerticalAlignment="Top">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StateText}" />
                                                            <TextBlock
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="#FF8FC2FF"
                                                                Text="{Binding PercentText}"
                                                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                        <ProgressBar
                                                            Height="5"
                                                            Margin="0,7,4,0"
                                                            HorizontalAlignment="Stretch"
                                                            IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                            Maximum="1"
                                                            Style="{StaticResource MiniProgress}"
                                                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"
                                                            Value="{Binding Progress, Mode=OneWay}" />
                                                        <TextBlock
                                                            Margin="0,5,0,0"
                                                            FontSize="9.5"
                                                            Foreground="#FF7C90A6"
                                                            Text="{Binding SizePairText}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="10.5"
                                                        Foreground="#FFA8BACE"
                                                        Text="{Binding Date}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="10.5"
                                                        Foreground="#FFA8BACE"
                                                        Text="{Binding Size}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Margin="0,2,0,0"
                                                        VerticalAlignment="Top"
                                                        FontSize="10.5"
                                                        Foreground="#FFA8BACE"
                                                        Text="{Binding CountText}" />

                                                    <StackPanel
                                                        Grid.Column="6"
                                                        VerticalAlignment="Top"
                                                        Orientation="Horizontal">
                                                        <!--  主按钮：下载 / 取消 / 重试 / 启动  -->
                                                        <Button
                                                            Click="RowAction_Click"
                                                            Style="{StaticResource RowActionBtn}"
                                                            Tag="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="{StaticResource F.Icon}"
                                                                    FontSize="10"
                                                                    Text="{Binding ActionGlyph}" />
                                                                <TextBlock
                                                                    Margin="5,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10.5"
                                                                    Text="{Binding ActionText}" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!--  下载完成后才有：在资源管理器里定位  -->
                                                        <Button
                                                            MinWidth="26"
                                                            Margin="4,0,0,0"
                                                            Padding="7,0"
                                                            Click="RowOpen_Click"
                                                            Style="{StaticResource RowActionBtn}"
                                                            Tag="{Binding}"
                                                            ToolTip="在资源管理器里定位文件"
                                                            Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock
                                                                FontFamily="{StaticResource F.Icon}"
                                                                FontSize="10"
                                                                Text="&#xE8DA;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="DownloadEmpty"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="12"
                            Foreground="{StaticResource B.TextMute}"
                            Text="官网暂无下载文件"
                            Visibility="Collapsed" />
                    </Grid>

                    <!--  ===== 软件截图面板 =====  -->
                    <Grid
                        x:Name="ShotsPane"
                        Grid.Row="1"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource T.Base}"
                                    Text="软件截图" />
                                <Border
                                    Margin="8,0,0,0"
                                    Padding="7,1"
                                    VerticalAlignment="Center"
                                    Background="#FF182A3E"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="ShotsCountText"
                                        FontSize="10.5"
                                        Foreground="{StaticResource B.AccentLight}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            Padding="0,0,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ShotsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  一张图占满整行宽度，高度按原图比例自动算，弹框放大图片也跟着放大  -->
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="Shot_Click"
                                            Style="{StaticResource ShotCard}"
                                            Tag="{Binding}"
                                            ToolTip="点击打开原图">
                                            <Grid MinHeight="140">
                                                <Border
                                                    Background="#FF0B1320"
                                                    ClipToBounds="True"
                                                    CornerRadius="10">
                                                    <Image
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Source="{Binding Source, Converter={StaticResource ImgConv}}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <Border
                                                    Margin="10"
                                                    Padding="9,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="#A6060D16"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        FontSize="9.5"
                                                        Foreground="#FFC7DBEF"
                                                        Text="{Binding Caption}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="ShotsEmpty"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource F.Ui}"
                            FontSize="12"
                            Foreground="{StaticResource B.TextMute}"
                            Text="官网这篇文章没有配图"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!--  右侧操作栏：只有按钮，不需要滚动条（内容固定，矮窗口下也就不滚了）  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button
                        Height="38"
                        Margin="0,0,0,8"
                        Click="Download_Click"
                        Style="{StaticResource PrimaryBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="13"
                                Text="&#xE896;" />
                            <TextBlock
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Text="下载最新文件" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="LaunchButton"
                        Height="36"
                        Margin="0,0,0,8"
                        Click="Launch_Click"
                        IsEnabled="False"
                        Style="{StaticResource GhostBtn}"
                        ToolTip="下载完成后可以直接在这里启动修改器">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="12"
                                Text="&#xE768;" />
                            <TextBlock
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Text="启动程序" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="36"
                        Margin="0,0,0,8"
                        Click="OpenSite_Click"
                        Style="{StaticResource GhostBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource F.Icon}"
                                FontSize="12"
                                Text="&#xE8A7;" />
                            <TextBlock
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Text="打开官网详情页" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="36"
                        Margin="0,0,0,8"
                        Click="CopyLink_Click"
                        Content="复制页面链接"
                        Style="{StaticResource GhostBtn}" />

                    <Button
                        x:Name="FavButton"
                        Height="36"
                        Margin="0,0,0,4"
                        Click="Favorite_Click"
                        Content="加入收藏夹"
                        Style="{StaticResource GhostBtn}" />

                    <TextBlock
                        x:Name="ToastText"
                        Margin="2,8,0,0"
                        FontFamily="{StaticResource F.Ui}"
                        FontSize="11"
                        Foreground="{StaticResource B.Green}"
                        Opacity="0"
                        Text=""
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
